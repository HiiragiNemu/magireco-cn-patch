# Reproducible localization build: never let checkout policy mutate audited text bytes.
* text=auto
.gitattributes text eol=lf
Build_JS_Injector.py text eol=lf
original_source/jquery-3.7.1.min.js text eol=lf
magica/**/*.js text eol=lf
magica/**/*.html text eol=lf
magica/**/*.json text eol=lf
magica/**/*.css text eol=lf
magica/js/libs/jquery-3.7.1.min.js text eol=lf
magica/i18n_audit/wiki_authority_pass9/* text eol=lf
magica/i18n_audit/wiki_authority_pass15_final/** text eol=lf
magica/i18n_audit/manual_cn_pass16/** text eol=lf
magica/i18n_audit/release_v26_authority/** text eol=lf
magica/i18n_audit/release_v26_authority/**/*.gz -text
*.xlsx -text -diff -merge !eol
i18n/*.tsv text eol=lf
i18n/*.md text eol=lf
i18n/*.json text eol=lf
*.tsv whitespace=-blank-at-eol
*.md whitespace=-blank-at-eol
i18n/generated/* text eol=lf
tools/*.py text eol=lf
scripts/*.py text eol=lf
madomagi/engine_i18n.tsv text eol=lf
# Native repair assets are manifest-bound byte-for-byte. Several plist/vfxj
# files are textual, but checkout policy must never rewrite their line endings.
madomagi/resource/image_native/** -text
.github/workflows/*.yml text eol=lf
.gitignore text eol=lf
README.md text eol=lf
