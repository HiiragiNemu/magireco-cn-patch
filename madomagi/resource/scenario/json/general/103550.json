    "group_13": [
      {
        "autoTurnFirst": 4.0,
        "chara": [
          {
            "cheek": 0,
            "eyeClose": 0,
            "face": "mtn_ex_010.exp.json",
            "id": 103500,
            "motion": 300,
            "pos": 1,
            "voice": "vo_char_1035_00_20",
            "textHome": "我的声音和竖琴的音色正在共鸣……从这之后，我的歌声和琴声就能更加强烈地传入大家的耳中了呢。"
          }
        ]
      },
      {
        "autoTurnFirst": 4.0,
        "chara": [
          {
            "id": 103500,
            "motion": 100
          }
        ]
      }
    ],
    "group_14": [
      {
        "autoTurnFirst": 4.8,
        "chara": [
          {
            "cheek": 0,
            "eyeClose": 0,
            "face": "mtn_ex_010.exp.json",
            "id": 103500,
            "motion": 1,
            "pos": 1,
            "voice": "vo_char_1035_00_21",
            "textHome": "我已经明白了，这座城市的魔法少女们都过着平凡的生活。那么，我就一边见证着不让这份关系歪曲，一边为她们祈愿着安宁而歌唱吧。"
          }
        ]
      },
      {
        "autoTurnFirst": 4.7,
        "chara": [
          {
            "id": 103500,
            "motion": 0
          }
        ]
