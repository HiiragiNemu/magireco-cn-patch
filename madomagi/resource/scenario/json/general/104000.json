{"story":{"group_1":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_01","textHome":"我是旅行调整屋之一，篠目夜鹤。@受老师邀请，我成为了调整屋。@作为魔法少女，我实在太过弱小，@甚至没有活下去的力量，@是老师为我指明了生存之路。@虽然我作为调整屋还缺乏经验，@但我会怀着自豪，接过您托付的灵魂宝石。"}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1}]},{"autoTurnFirst":8.5,"chara":[{"id":104000,"motion":0}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":400}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100}]}],"group_10":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_17","textHome":"受到老师邀请后，@我决定在神滨活动。@并不是因为我对神滨特别感兴趣，@只是因为老师邀请了我，所以我来了。"}]},{"autoTurnFirst":4.5,"chara":[{"id":104000,"motion":0}]},{"autoTurnFirst":2.7,"chara":[{"id":104000,"motion":100}]}],"group_11":[{"autoTurnFirst":4.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_18","textHome":"老师或许只是在利用我。@但那样也没关系。我接受这一点，@并会为了老师竭尽全力。"}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":0}]},{"autoTurnFirst":5.0,"chara":[{"eyeClose":1,"id":104000,"motion":100}]}],"group_12":[{"autoTurnFirst":5.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_19","textHome":"我希望永远不会有使用这股力量的机会。"}]}],"group_13":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":200,"pos":1,"voice":"vo_char_1040_00_20","textHome":"这就是……为了活下去的力量……"}]}],"group_14":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":0,"pos":1,"voice":"vo_char_1040_00_21","textHome":"我曾以为已经到达极限的力量，@原来还有更高的境界。@这个误算让我非常高兴。@毕竟我还不能死。"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000}]},{"autoTurnFirst":2.7,"chara":[{"id":104000,"motion":100}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000}]}],"group_15":[{"autoTurnFirst":3.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_22","textHome":"……我又获得了力量……。@我感到高兴，却也有些恐惧。@因为我……曾经是一个沉溺于力量的人…@…。但我绝不会再次沉溺。@我已经不再孤独了。"}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":300}]},{"autoTurnFirst":5.8,"chara":[{"id":104000,"motion":100}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000,"motion":0}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":1}]}],"group_16":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_23","textHome":"我一直怀着“绝不能死”的念头坚强地活着，@却也没有明确的未来目标。不过，@为了证明我存在的意义，我会每天努力精进。@所以拿到悲叹之种后，@请务必来 Puella Care！"}]},{"autoTurnFirst":3.9,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":104000}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":400}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100}]}],"group_17":[{"autoTurnFirst":1.8,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_24","textHome":"今天也来看我了呢。来，@请到这边。房间温度还舒适吗？@若有任何要求，请尽管吩咐。"}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":2.3,"chara":[{"id":104000,"motion":400}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":300}]},{"autoTurnFirst":3.6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":1}]}],"group_18":[{"autoTurnFirst":2.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":0,"pos":1,"voice":"vo_char_1040_00_25","textHome":"我刚准备好早餐。@难得有这个机会，要趁热来一点吗？@我还进了一批很不错的橙汁。"}]},{"autoTurnFirst":3.8,"chara":[{"id":104000,"motion":1}]},{"autoTurnFirst":3.5,"chara":[{"id":104000,"motion":200}]}],"group_19":[{"autoTurnFirst":2.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_26","textHome":"肚子饿了吧？呵呵，我也是。@……原来您正在减肥吗？@我觉得您已经足够漂亮了，@不过我们还是找一家有沙拉吧的店吧。"}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":104000}]},{"autoTurnFirst":0.4,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":2.2,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":400}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":1}]}],"group_2":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_02","textHome":"您好，我叫篠目夜鹤，@在中央区经营调整屋。@您光临时，@请允许我用美味甜点款待您。"}]},{"autoTurnFirst":3.3,"chara":[{"id":104000,"motion":1}]},{"autoTurnFirst":5.5,"chara":[{"id":104000,"motion":300}]}],"group_20":[{"autoTurnFirst":5.8,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_27","textHome":"小时候的这个时间，我总被各种课程占满，@连休息都没有。钢琴、游泳、绘画、@舞蹈……我其实也颇有教养哦。"}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":4.1,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":200}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":0}]}],"group_21":[{"autoTurnFirst":1.0,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_28","textHome":"晚上好。差不多该休息了吗？@能在您睡前陪您度过最后一段时光，@我深感荣幸。@请好好消除疲劳吧。"}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000}]},{"autoTurnFirst":5.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":400}]},{"autoTurnFirst":3.2,"chara":[{"id":104000,"motion":1}]}],"group_22":[{"autoTurnFirst":3.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_29","textHome":"今天少见地忙碌呢……哎呀，@这可不行。要保持笑容。@负责调整的我若没有精神，@魔法少女一定也会不安。备忘录上也是这么写的。"}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":400}]},{"autoTurnFirst":1.6,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":104000,"motion":1}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":4.8,"chara":[{"id":104000,"motion":200}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":100}]}],"group_23":[{"autoTurnFirst":3.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":400,"pos":1,"voice":"vo_char_1040_00_30","textHome":"似乎出现了许多魔女。@请加油。拿到悲叹之种后，@请务必送到我们调整屋来！"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":1}]},{"autoTurnFirst":5.4,"chara":[{"id":104000,"motion":100}]}],"group_24":[{"autoTurnFirst":3.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":0,"pos":1,"voice":"vo_char_1040_00_31","textHome":"无尽镜界……我过去所在的地@区从未发生过这种现象。@神滨真是有许多不可思议的事。"}]},{"autoTurnFirst":4.7,"chara":[{"id":104000,"motion":300}]},{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000,"motion":100}]}],"group_25":[{"autoTurnFirst":4.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":200,"pos":1,"voice":"vo_char_1040_00_32","textHome":"哦……！竟然有这么多客人……。咦？不是？@……接下来要由这些人一起战斗……？我明白了。@那么在各位丧命之前，请务必先来调整！"}]},{"autoTurnFirst":2.0,"chara":[{"id":104000,"motion":0}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":300}]},{"autoTurnFirst":2.1,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":0}]},{"autoTurnFirst":4.4,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":100}]}],"group_26":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":400,"pos":1,"voice":"vo_char_1040_00_33","textHome":"我无论何时都会保持中立。@是的，中立就是中立。@我绝不会越界干涉。……您失望了吗？"}]},{"autoTurnFirst":3.2,"chara":[{"id":104000,"motion":1}]},{"autoTurnFirst":3.4,"chara":[{"id":104000,"motion":200}]},{"autoTurnFirst":2.9,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":300}]}],"group_27":[{"autoTurnFirst":3.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":104000,"motion":200,"pos":1,"voice":"vo_char_1040_00_34","textHome":"消失吧！你这只臭虫！！……呼，@没想到车里竟会飞进这么大的苍蝇。@这就是在户外进行调整时最大的缺点。"}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":104000,"motion":100}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":4.4,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":0}]},{"autoTurnFirst":5.1,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":300}]}],"group_28":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_35","textHome":"真是一部好电影……咦！？@您怎么了！？……因为刚才的电影？@原来如此，温柔的人会为那@种电影流泪啊……我记下了。"}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":400}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":300}]},{"autoTurnFirst":5.7,"chara":[{"id":104000,"motion":0}]},{"autoTurnFirst":2.1,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":100}]}],"group_29":[{"autoTurnFirst":2.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":0,"pos":1,"voice":"vo_char_1040_00_36","textHome":"成为魔法少女后不容易看出来，@其实我原本的身体能力也相当不错。@看，这里的肌肉怎么样？@可以摸摸看。"}]},{"autoTurnFirst":4.6,"chara":[{"id":104000,"motion":100}]},{"autoTurnFirst":3.6,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":200}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000}]}],"group_3":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_03","textHome":"请放心，无论发生什么，我都会保持中立。"}]},{"autoTurnFirst":3.0,"chara":[{"id":104000,"motion":400}]}],"group_30":[{"autoTurnFirst":4.7,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_37","textHome":"呼……呼……。……失礼了，@我不小心睡着了。……咦？呵呵，@我当然也需要睡觉。……那个，我也是人类哦？"}]},{"autoTurnFirst":0.4,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":1.4,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":400}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104000}]},{"autoTurnFirst":1.2,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000}]},{"autoTurnFirst":4.1,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":300}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":200}]}],"group_31":[{"autoTurnFirst":4.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_38","textHome":"御魂小姐……算是我的师姐吗？@虽然我们并不熟。@她就是让“调整屋会脱掉客人衣服”@这种风评流传开来的人吧。"}]},{"autoTurnFirst":3.3,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1}]},{"autoTurnFirst":5.7,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":200}]}],"group_32":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_39","textHome":"月出里真的很有精神。@而且非常健谈。……@不不，她真的非常健谈。"}]},{"autoTurnFirst":3.0,"chara":[{"id":104000,"motion":300}]},{"autoTurnFirst":4.3,"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":400}]}],"group_33":[{"autoTurnFirst":4.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_40","textHome":"老师……站在店里时很可靠，@私下却相当散漫……@。希望她不要再把脱下@来的丝袜随手乱放。"}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":300}]},{"autoTurnFirst":5.1,"chara":[{"eyeClose":1,"id":104000}]}],"group_34":[{"autoTurnFirst":6.1,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000,"motion":400,"pos":1,"voice":"vo_char_1040_00_41","textHome":"吸气……深深地、细细体会着吸气…@…。然后呼气……放松身体…@…慢慢把自己交给我……。@……辛苦了，调整结束。"}]},{"autoTurnFirst":4.5,"chara":[{"id":104000,"motion":100}]},{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000}]},{"autoTurnFirst":4.1,"chara":[{"id":104000,"motion":1}]}],"group_35":[{"autoTurnFirst":4.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":104000,"motion":400,"pos":1,"voice":"vo_char_1040_00_42","textHome":"就算是我，也忍不下去了。"}]}],"group_36":[{"autoTurnFirst":3.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_43","textHome":"好、好强的敌人……！"}]}],"group_37":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_44","textHome":"想赢的话，请务必来调整屋。"}]}],"group_38":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":200,"pos":1,"voice":"vo_char_1040_00_45","textHome":"您至今到底都做了些什么？"}]}],"group_39":[{"autoTurnFirst":2.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":104000,"motion":200,"pos":1,"voice":"vo_char_1040_00_46","textHome":"以死谢罪吧……！！"}]}],"group_4":[{"autoTurnFirst":4.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_04","textHome":"要活下去，碍事的东西实在太多了。"}]}],"group_5":[{"autoTurnFirst":1.7,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_05","textHome":"所以我……会继续活下去。"}]},{"autoTurnFirst":3.3,"chara":[{"eyeClose":0,"id":104000}]}],"group_6":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_13","textHome":"偶尔成为被调整的一方也不错。"}]}],"group_7":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_14","textHome":"这确实非常值得高兴…@…但不能就此满足。"}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000}]}],"group_8":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_15","textHome":"就算试探我……也不会有什么乐趣的。"}]}],"group_9":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_16","textHome":"遇见老师时，我已经放弃了一切，@甚至接受了死亡。@是老师给予了我活下去的方法与意义。"}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":104000}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":5.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":400}]}]},"version":3}