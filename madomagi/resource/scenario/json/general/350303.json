{"story":{"group_1":[{"autoTurnFirst":5.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":1,"motion":100,"pos":0,"voice":"vo_char_3503_00_01","textHome":"我们和菖蒲都来自一家叫“杜鹃之家”的福利院。@现在，我们三个人一起住在神滨。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":0,"motion":1,"pos":1,"voice":"vo_char_3503_00_01"}]},{"autoTurnFirst":2.7,"chara":[{"id":350300,"motion":1}]},{"autoTurnFirst":5.7,"chara":[{"id":350302,"lipSynch":1,"motion":200,"textHome":"嘛，正如你想的那样，生活里确实有不少不方便的地方，@不过，我们过得还算不错。@最近还开始接魔法少女的保镖工作了呢。"},{"id":350300,"lipSynch":0}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302}]},{"autoTurnFirst":5.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302,"motion":1}]},{"autoTurnFirst":2.8,"chara":[{"id":350300,"lipSynch":1,"motion":200,"textHome":"有什么委托就联系我们吧。@只要有报酬，我们就接。"},{"id":350302,"lipSynch":0}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":0}]}],"group_10":[{"autoTurnFirst":5.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_17"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_00_17","textHome":"家规第二条：三个人要时刻心意相通。"}]},{"autoTurnFirst":5.0,"chara":[{"id":350300,"lipSynch":1,"textHome":"只要大家站在同样的立场看事情，@就能马上察觉谁有烦恼，也能帮忙解决。"},{"id":350302,"lipSynch":0,"motion":1}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":100}]}],"group_11":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_18"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_00_18","textHome":"家规第三条……啊，好像没有了吧。"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":350302,"motion":300}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":350300,"lipSynch":1,"motion":300,"textHome":"是呢。不如规定大家一起洗澡，怎么样？"},{"id":350302,"lipSynch":0}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":100}]},{"autoTurnFirst":2.6,"chara":[{"id":350300,"lipSynch":0},{"cheek":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":0,"textHome":"浴室也越来越挤了，@一起洗澡这件事，差不多该毕业了吧。"}]},{"autoTurnFirst":4.0,"chara":[{"id":350302,"motion":100}]}],"group_12":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_19"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_00_19","textHome":"嗯，我们的配合也越来越有模有样了呢。"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":100}]}],"group_13":[{"autoTurnFirst":2.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":1,"pos":0,"voice":"vo_char_3503_00_20"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_00_20","textHome":"三个人背靠背作战的话，@就能消除死角了。"}]},{"autoTurnFirst":2.0,"chara":[{"id":350302,"motion":400}]}],"group_14":[{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_21"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_00_21","textHome":"成为魔法少女以后，我们就一直三个人相依为命。@所以彼此既是家人，也是战友。"}]},{"autoTurnFirst":2.5,"chara":[{"eyeClose":1,"id":350302,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":2.2,"chara":[{"id":350302,"motion":100}]},{"autoTurnFirst":1.1,"chara":[{"eyeClose":1,"id":350300,"lipSynch":1,"textHome":"嗯，是无可替代的存在。"},{"id":350302,"lipSynch":0,"motion":0}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350300}]},{"autoTurnFirst":2.0,"chara":[{"id":350300,"motion":200}]}],"group_15":[{"autoTurnFirst":6.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":1,"motion":300,"pos":0,"voice":"vo_char_3503_00_22","textHome":"直到现在，我们的目标都只是保住三个人的性命。@但今后，我也希望能守护菖蒲想要守护的东西。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":0,"motion":0,"pos":1,"voice":"vo_char_3503_00_22"}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":100}]},{"autoTurnFirst":3.5,"chara":[{"id":350302,"lipSynch":1,"motion":200,"textHome":"为此，我们想保持中立。@所以无论是谁来委托保镖工作，我们都打算接下。"},{"id":350300,"lipSynch":0,"motion":0}]},{"autoTurnFirst":5.0,"chara":[{"id":350302,"motion":1}]}],"group_16":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_23"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_00_23"}]},{"autoTurnFirst":2.8,"chara":[{"id":350302,"motion":300},{"id":350300,"lipSynch":0}]},{"autoTurnFirst":2.0,"chara":[{"id":350300,"lipSynch":1,"motion":300},{"id":350302,"lipSynch":0,"motion":1}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":4.1,"chara":[{"id":350300,"motion":0}]},{"autoTurnFirst":2.4,"chara":[{"id":350300,"motion":100}]},{"autoTurnFirst":1.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300}]},{"autoTurnFirst":5.8,"chara":[{"id":350300,"lipSynch":0},{"id":350302,"lipSynch":1,"motion":100}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":200}]}],"group_17":[{"autoTurnFirst":0.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":350303,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_03_24","textHome":"哦？你来得正好！木叶和叶月都不在，@陪我玩吧！好好好，先冲去公园！"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303,"motion":100}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303,"motion":200}]},{"autoTurnFirst":1.7,"chara":[{"id":350303,"motion":0}]},{"autoTurnFirst":3.0,"chara":[{"id":350303,"motion":400}]}],"group_18":[{"autoTurnFirst":2.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350303,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_03_25","textHome":"一、二、三，嘿呀！喂喂，别发呆啦！@为了今天也能精神满满地玩上一整天，@从早上开始！就要！元气十足地！大声！喊出来！"}]},{"autoTurnFirst":1.7,"chara":[{"id":350303,"motion":400}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":350303,"motion":100}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303,"motion":0}]},{"autoTurnFirst":2.1,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303,"motion":200}]},{"autoTurnFirst":1.9,"chara":[{"id":350303,"motion":400}]},{"autoTurnFirst":1.0,"chara":[{"id":350303,"motion":0}]},{"autoTurnFirst":3.0,"chara":[{"id":350303,"motion":100}]}],"group_19":[{"autoTurnFirst":5.1,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":350303,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_03_26","textHome":"嗯～！叶月做的肉末盖饭真好吃！@就算你这么看着我，我也不会给你的！@不过，只吃一口的话，倒也不是不行。来，给你！"}]},{"autoTurnFirst":2.9,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":350303,"motion":100}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350303,"motion":300}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303,"motion":200}]}],"group_2":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_02"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_00_02","textHome":"你好呀～先做个自我介绍吧。我叫游佐叶月。"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302}]},{"autoTurnFirst":2.2,"chara":[{"id":350302,"motion":200}]},{"autoTurnFirst":2.4,"chara":[{"id":350302,"lipSynch":0},{"id":350300,"lipSynch":1,"motion":100,"textHome":"我是静海木叶。@我们和三栗菖蒲一起，三个人开始做保镖了。"}]},{"autoTurnFirst":4.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":0},{"id":350302,"motion":1}]},{"autoTurnFirst":3.0,"chara":[{"id":350300,"lipSynch":0},{"id":350302,"lipSynch":1,"motion":100,"textHome":"今后也请多多关照我们的生意哦～"}]}],"group_20":[{"autoTurnFirst":4.3,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":350303,"lipSynch":1,"motion":100,"pos":1,"voice":"vo_char_3503_03_27","textHome":"呼～今天也和菲莉希亚好好出了一身汗。@不过，那家伙可不是我的朋友！@我只是每天陪她玩而已！"}]},{"autoTurnFirst":3.4,"chara":[{"cheek":1,"face":"mtn_ex_050.exp.json","id":350303,"motion":400}]},{"autoTurnFirst":3.5,"chara":[{"cheek":1,"face":"mtn_ex_020.exp.json","id":350303,"motion":200}]}],"group_21":[{"autoTurnFirst":4.9,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":350303,"lipSynch":0,"motion":0,"pos":1,"voice":"vo_char_3503_03_28","textHome":"呼……"}]},{"autoTurnFirst":5.4,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":350303,"lipSynch":1,"motion":400,"textHome":"危、危险……！空心菜老师～！"}]},{"autoTurnFirst":7.4,"chara":[{"eyeClose":1,"id":350303,"motion":0,"textHome":"菲莉希亚正从后面盯着布丁……！"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":350303,"lipSynch":0}]}],"group_22":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":350303,"lipSynch":1,"motion":400,"pos":1,"voice":"vo_char_3503_03_29","textHome":"哦，对了！我跟木叶约好，出门一定要带这个小挎包！@以前老是弄丢家里的钥匙什么的，@现在已经好多了！"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303,"motion":1}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303,"motion":100}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303}]}],"group_23":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350303,"lipSynch":1,"motion":100,"pos":1,"voice":"vo_char_3503_03_30","textHome":"好耶！今天也要好好做保镖！@不过，该去哪里来着？@啊，对了对了！问叶月她们就行了！"}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":350303,"motion":0}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303,"motion":200}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303}]}],"group_24":[{"autoTurnFirst":2.5,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350303,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_03_31","textHome":"啊～气死我了～！居然擅自造出那么多我的复制体！@可恶的镜之魔女，总有一天我要把你打趴下！"}]},{"autoTurnFirst":5.5,"chara":[{"id":350303,"motion":1}]},{"autoTurnFirst":0.9,"chara":[{"id":350303,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"cheek":1,"id":350303,"motion":100}]}],"group_25":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350303,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_03_32"}]},{"autoTurnFirst":2.6,"chara":[{"id":350303,"motion":300}]},{"autoTurnFirst":4.9,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":350303,"motion":200}]},{"autoTurnFirst":4.2,"chara":[{"id":350303,"motion":400}]}],"group_26":[{"autoTurnFirst":1.0,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350303,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_03_33","textHome":"喂喂，这个架子很厉害吧？！@叶月特意做给我，用来放我的宝物的！@真期待下次又能带回什么宝贝！"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":350303}]},{"autoTurnFirst":5.0,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":350303,"motion":200}]},{"autoTurnFirst":2.1,"chara":[{"id":350303,"motion":0}]},{"autoTurnFirst":2.0,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":350303,"motion":100}]}],"group_27":[{"autoTurnFirst":1.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350303,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_03_34","textHome":"嘿！呀！嗯～总觉得哪里不对。@螳螂威吓别人的姿势不是很帅吗？@所以我也想试试看～！"}]},{"autoTurnFirst":1.3,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_020.exp.json","id":350303,"motion":400}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":305303}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350303,"motion":300}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303,"motion":1}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303}]}],"group_28":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350303,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_03_35","textHome":"能在神滨开始做保镖，都是多亏了木叶和叶月。@所以我也得全力以赴，好好工作！@哦——！开干啦！"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303,"motion":100}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303,"motion":200}]},{"autoTurnFirst":1.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303,"motion":400}]},{"autoTurnFirst":2.5,"chara":[{"id":350303,"motion":100}]}],"group_29":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350303,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_03_36","textHome":"来，发力！坚持住！怎么样，我像不像个相扑裁判！@相扑比赛玩太多，都玩腻了，@所以现在我们在比谁的裁判当得更好！"}]},{"autoTurnFirst":1.8,"chara":[{"id":350303,"motion":400}]},{"autoTurnFirst":2.9,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303}]},{"autoTurnFirst":4.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350303,"motion":1}]},{"autoTurnFirst":1.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303,"motion":100}]}],"group_3":[{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":350300,"lipSynch":1,"motion":300,"pos":0,"voice":"vo_char_3503_00_03"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":0,"motion":1,"pos":1,"voice":"vo_char_3503_00_03"}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350300}]},{"autoTurnFirst":3.5,"chara":[{"id":350300,"motion":0}]}],"group_30":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350303,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_03_37","textHome":"最近木叶有点奇怪啊。@我也说不太清楚，她还是一样温柔，@却感觉一会儿贴过来，一会儿又离开……大概就是这样。"}]},{"autoTurnFirst":7.3,"chara":[{"id":350303,"motion":1}]},{"autoTurnFirst":2.0,"chara":[{"id":350303,"motion":200}]}],"group_31":[{"autoTurnFirst":6.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350303,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_03_38","textHome":"去佳子家合宿之前，我先去零食店买了吃的，@总觉得好像有人在看我。@难道，我其实超受欢迎？！"}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":350303,"motion":300}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":350303,"motion":0}]},{"autoTurnFirst":3.0,"chara":[{"cheek":1,"id":350303,"motion":400}]}],"group_32":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350303,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_03_39","textHome":"如果院长老师看到现在的我们，会怎么想呢？@虽然偶尔也会想见院长，@不过，我已经是大人了，能忍住的！"}]},{"autoTurnFirst":3.4,"chara":[{"eyeClose":1,"id":350303,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350303}]},{"autoTurnFirst":1.5,"chara":[{"id":350303,"motion":100}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350303}]}],"group_33":[{"autoTurnFirst":2.9,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350303,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_03_40","textHome":"多亏佳子她们鼓励我！@虽然有点不好意思，@但能对木叶和叶月说出“一直以来谢谢你们”，真好！"}]},{"autoTurnFirst":3.0,"chara":[{"id":350303,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":350303,"motion":200}]}],"group_34":[{"autoTurnFirst":1.3,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":350303,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_03_41","textHome":"快看快看！前阵子捡到的手电筒！@虽然旧了点，可还亮得起来！@你愿意听我说话，这就送你当谢礼了！嘿嘿，别客气！"}]},{"autoTurnFirst":2.8,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":350303}]},{"autoTurnFirst":2.8,"chara":[{"id":350303,"motion":400}]},{"autoTurnFirst":3.8,"chara":[{"id":350303,"motion":100}]},{"autoTurnFirst":0.8,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":350303}]},{"autoTurnFirst":2.0,"chara":[{"id":350303,"motion":200}]}],"group_35":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350300,"lipSynch":1,"motion":200,"pos":0,"voice":"vo_char_3503_00_42","textHome":"速战速决吧，叶月。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":0,"motion":0,"pos":1,"voice":"vo_char_3503_00_42"}]},{"autoTurnFirst":2.0,"chara":[{"id":350302,"lipSynch":1,"motion":100,"textHome":"好，木叶。"},{"id":350300,"lipSynch":0}]}],"group_36":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_43","textHome":"太轻松了，都让我打哈欠了。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_00_43","textHome":"太轻松了，都让我打哈欠了。"}]}],"group_37":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350300,"lipSynch":1,"motion":100,"pos":0,"voice":"vo_char_3503_00_44","textHome":"委托完成，该收取报酬了。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":0,"motion":1,"pos":1,"voice":"vo_char_3503_00_44","textHome":"委托完成，该收取报酬了。"}]},{"autoTurnFirst":1.5,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":350300}]}],"group_38":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.ex