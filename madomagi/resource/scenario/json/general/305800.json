{"story":{"group_1":[{"autoTurnFirst":6.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_01","textHome":"我叫南津凉子！住在神滨近郊，@是时女一族的后裔！@虽说我也是最近才知道自己属于时女一族。@不过时间长短无所谓。@既然我是时女一族，@而时女一族又要为日本而战，@那我当然不能袖手旁观！神滨，给我等着！！"}]},{"autoTurnFirst":5.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":1}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":0}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"face":"mtn_ex_012.exp.json","id":305800}]},{"autoTurnFirst":3.0,"chara":[{"id":305800,"motion":200}]},{"autoTurnFirst":2.0,"chara":[{"id":305800,"motion":100}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305800}]}],"group_10":[{"autoTurnFirst":6.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":300,"pos":1,"voice":"vo_char_3058_00_17","textHome":"父母留给我的只有这副身体和灵魂。@如今身体已经失去，我想，@遵从自己的灵魂活下去，@就是父母曾活过的证明。"}]},{"autoTurnFirst":5.0,"chara":[{"eyeClose":1,"id":305800}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":305800}]},{"autoTurnFirst":5.0,"chara":[{"id":305800,"motion":0}]}],"group_11":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_18","textHome":"我不擅长说谎，尤其不擅长欺骗自己。@所以抱歉！我既没有冠冕堂皇的理由，@也不会找借口，@但我就是要全力多管闲事！"}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":305800}]},{"autoTurnFirst":3.6,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":200}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":100}]}],"group_12":[{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":305800,"motion":300,"pos":1,"voice":"vo_char_3058_00_19","textHome":"这就是所谓的必杀技吗？@那得练习喊招式名才行！"}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":100}]}],"group_13":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":0,"pos":1,"voice":"vo_char_3058_00_20","textHome":"这样就能救下更多人。@没错，我正是为此才变强！"}]},{"autoTurnFirst":1.0,"chara":[{"eyeClose":1,"id":305800}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":305800}]},{"autoTurnFirst":4.0,"chara":[{"id":305800,"motion":200}]}],"group_14":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":0,"pos":1,"voice":"vo_char_3058_00_21","textHome":"力量本身并没有错。得到力量后变得傲慢，@还是保持平和，全看本人如何自处！@我绝不会沉溺于力量！"}]},{"autoTurnFirst":3.3,"chara":[{"id":305800,"motion":300}]},{"autoTurnFirst":3.4,"chara":[{"eyeClose":1,"id":305800}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":305800}]},{"autoTurnFirst":6.0,"chara":[{"id":305800,"motion":1}]}],"group_15":[{"autoTurnFirst":5.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":305800,"motion":0,"pos":1,"voice":"vo_char_3058_00_22","textHome":"真不可思议……内心格外平静。@获得力量……开悟……@原来就是这种感觉。以前只是漫无目@的地讨伐魔女时，从未有过这种心境。@看来我也受到了时女大家的影响。"}]},{"autoTurnFirst":8.2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":305800,"motion":1}]},{"autoTurnFirst":6.2,"chara":[{"id":305800,"motion":300}]},{"autoTurnFirst":8.0,"chara":[{"eyeClose":0,"id":305800}]}],"group_16":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_23","textHome":"这个世界或许已经彻底变成地狱，@但既然一切都是人类造成的，@人类就一定能解决。@我不会放弃。要是在这里倒下，@我就没脸去见爸爸妈妈了。"}]},{"autoTurnFirst":6.1,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":0}]},{"autoTurnFirst":2.2,"chara":[{"id":305800,"motion":200}]},{"autoTurnFirst":5.0,"chara":[{"id":305800,"motion":1}]}],"group_17":[{"autoTurnFirst":1.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":305800,"motion":0,"pos":1,"voice":"vo_char_3058_00_24","textHome":"哦，你可让我等累了！@我一边想着你一边坐禅，@结果被警策抽了好几次！@你可不是扰乱我修行的杂念吧！"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800}]},{"autoTurnFirst":2.5,"chara":[{"id":305800,"motion":1}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":100}]}],"group_18":[{"autoTurnFirst":1.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":305800,"motion":200,"pos":1,"voice":"vo_char_3058_00_25","textHome":"早上好！起得真早啊！@我刚打扫完寺院。@打扫也叫“作务”，@是堂堂正正的修行！"}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800}]},{"autoTurnFirst":3.6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":100}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":1}]}],"group_19":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":200,"pos":1,"voice":"vo_char_3058_00_26","textHome":"饿死了！饭——！我开动了！@多谢款待！……@是不是有点不够端庄？哈哈，@真不好意思。不过……我忍不住啊！"}]},{"autoTurnFirst":1.2,"chara":[{"cheek":0,"face":"mtn_ex_012.exp.json","id":305800}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305800,"motion":100}]},{"autoTurnFirst":2.8,"chara":[{"id":305800,"motion":400}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800}]},{"autoTurnFirst":2.8,"chara":[{"cheek":1,"eyeClose":1,"id":305800,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":305800}]},{"autoTurnFirst":1.5,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":305800}]},{"autoTurnFirst":6.0,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":305800,"motion":100}]}],"group_2":[{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_02","textHome":"我是南津凉子，寺院长大的魔法少女！@每天都修行，锻炼身心！@……哈？这不是假发，是我自己的头发。@还有，我不是和尚。"}]},{"autoTurnFirst":3.5,"chara":[{"id":305800,"motion":200}]},{"autoTurnFirst":1.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":305800}]},{"autoTurnFirst":1.2,"chara":[{"id":305800,"motion":400}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":100}]}],"group_20":[{"autoTurnFirst":5.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_27","textHome":"这个时间住持会去参加守灵，@我负责看家。无论在爷爷的净安寺，@还是现在的水德寺都一样。@……总会让人思考生命啊。"}]},{"autoTurnFirst":5.0,"chara":[{"id":305800,"motion":100}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":300}]}],"group_21":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_28","textHome":"今天也结束了！全力活下来，@真是愉快的一天！@为了明天活得更开心，@现在就要全力……睡觉——！！"}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305800}]},{"autoTurnFirst":3.0,"chara":[{"id":305800,"motion":0}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":305800}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305800,"motion":200}]}],"group_22":[{"autoTurnFirst":1.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_29","textHome":"哇哈哈！认命吧！@敢扰乱这所学校风纪的家伙，@全由我来制裁！……哈？@我又不是风纪委员。@这只是我自以为是地伸张正义罢了！"}]},{"autoTurnFirst":3.8,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":305800}]},{"autoTurnFirst":3.4,"chara":[{"id":305800,"motion":200}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":305800,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":100}]}],"group_23":[{"autoTurnFirst":3.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":0,"pos":1,"voice":"vo_char_3058_00_30","textHome":"魔女那副不祥的模样，@究竟要背负多少污秽才会变成那样…@…。等着！我这就让你解脱！@……就连魔女也要拯救！"}]},{"autoTurnFirst":5.0,"chara":[{"id":305800,"motion":300}]},{"autoTurnFirst":1.3,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":305800}]},{"autoTurnFirst":2.0,"chara":[{"id":305800,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"id":305800,"motion":200}]}],"group_24":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":305800,"motion":0,"pos":1,"voice":"vo_char_3058_00_31","textHome":"和我一模一样啊。@佛教里有句话，@“战胜自己的人才是最伟大的胜者”@……不，这不是一回事。"}]},{"autoTurnFirst":6.8,"chara":[{"id":305800,"motion":1}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":100}]}],"group_25":[{"autoTurnFirst":5.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":305800,"motion":400,"pos":1,"voice":"vo_char_3058_00_32","textHome":"哇，好多魔法少女。……@大家都穿得这么可爱……@让我忍不住想参拜了。就像来到三十三间堂一样。"}]},{"autoTurnFirst":2.8,"chara":[{"id":305800,"motion":300}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800}]},{"autoTurnFirst":4.0,"chara":[{"id":305800,"motion":100}]}],"group_26":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_33","textHome":"我小时候父母就去世了，@后来被爷爷接到净安寺。@听说就连我最@初也总是在哭。"}]},{"autoTurnFirst":4.5,"chara":[{"id":305800,"motion":100}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800}]}],"group_27":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_34","textHome":"以前的我虽然总爱哭，@但听爷爷讲经、@接受严格得过头的修行后，@连哭的空闲都没有了。……得感谢他啊。"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":200}]},{"autoTurnFirst":5.0,"chara":[{"eyeClose":1,"id":305800,"motion":300}]}],"group_28":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_35","textHome":"现在照顾我的是参京区的水德寺。@听说那里的老爷子也是时女一族的人。@难道他……也能成为魔法少女吗……？"}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305800}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":305800,"motion":400}]}],"group_29":[{"autoTurnFirst":7.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_36","textHome":"我明白魔法联盟和PROMISED BLOOD@都有各自信念，所以才会冲突。@但我还是不想放弃通过@对话解决问题的希望。"}]},{"autoTurnFirst":1.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":0}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":305800}]}],"group_3":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":300,"pos":1,"voice":"vo_char_3058_00_03","textHome":"暴走的正义才是最坏的东西。"}]},{"autoTurnFirst":3.0,"chara":[{"eyeClose":1,"id":305800}]}],"group_30":[{"autoTurnFirst":3.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_37","textHome":"千春真是名侦探。@电视怎么都打不开时，@她一下就发现我拿的是空调遥控器。@太厉害了。"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":1}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305800,"motion":200}]}],"group_31":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":305800,"motion":0,"pos":1,"voice":"vo_char_3058_00_38","textHome":"沙绪？她可没那么可怕。@虽然一路被迫作出艰难选择，@但本性是个非常温柔的普通女孩。@……也喜欢点心。"}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":100}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":0}]},{"autoTurnFirst":6.0,"chara":[{"cheek":1,"face":"mtn_ex_030.exp.json","id":305800,"motion":1}]}],"group_32":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_39","textHome":"静香真是个有趣的家伙。@不过可不能因此小看她。@那家伙一定能做出大事。做什么？@我也不知道，但她就是能做到。"}]},{"autoTurnFirst":4.2,"chara":[{"cheek":0,"face":"mtn_ex_012.exp.json","id":305800}]},{"autoTurnFirst":2.4,"chara":[{"id":305800,"motion":100}]},{"autoTurnFirst":1.5,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":305800}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":200}]}],"group_33":[{"autoTurnFirst":8.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_40","textHome":"为什么恶无论走到哪里、@经过多久都不会消失呢。@……既然如此，@不如让我化作阿修罗……"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":300}]},{"autoTurnFirst":3.0,"chara":[{"eyeClose":1,"id":305800}]}],"group_34":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_41","textHome":"你这身体意外地不错嘛。@能摸一下吗？……那我不客气了。@嗯……嗯，哦……哇。……@摸得太久了。谢谢配合。"}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305800}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":0}]},{"autoTurnFirst":4.8,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":305800,"motion":1}]},{"autoTurnFirst":2.7,"chara":[{"id":305800,"motion":0}]},{"autoTurnFirst":2.5,"chara":[{"id":305800,"motion":400}]},{"autoTurnFirst":1.2,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_020.exp.json","id":305800,"motion":0}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":305800}]},{"autoTurnFirst":2.2,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800}]},{"autoTurnFirst":3.0,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":305800,"motion":100}]}],"group_35":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_42","textHome":"是个值得我好好矫正一番的家伙。"}]}],"group_36":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_43","textHome":"别小看寺里长大的我！"}]}],"group_37":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":200,"pos":1,"voice":"vo_char_3058_00_44","textHome":"喝!!"}]}],"group_38":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_45","textHome":"放心，我不会死。"}]}],"group_39":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305800,"motion":200,"pos":1,"voice":"vo_char_3058_00_46","textHome":"变强以后再来！"}]}],"group_4":[{"autoTurnFirst":6.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":100,"pos":1,"voice":"vo_char_3058_00_04","textHome":"这里……总觉得藏着什么。"}]}],"group_5":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":200,"pos":1,"voice":"vo_char_3058_00_05","textHome":"好，所有问题都彻底解决了！"}]}],"group_6":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_012.exp.json","id":305800,"motion":200,"pos":1,"voice":"vo_char_3058_00_13","textHome":"这是修行的成果！今天要吃肉！@吃肉！咦，还要继续修行……？"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305800}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305800,"motion":400}]}],"group_7":[{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305800,"motion":1,"pos":1,"voice":"vo_char_3058_00_14","textHome":"感谢爷爷、时女的大家，@以及世上一切有情众生。"}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305800,"moti