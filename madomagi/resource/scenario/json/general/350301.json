{"story":{"group_1":[{"autoTurnFirst":5.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":1,"motion":100,"pos":0,"voice":"vo_char_3503_00_01","textHome":"我们和菖蒲都来自一家叫“杜鹃之家”的福利院。@现在，我们三个人一起住在神滨。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":0,"motion":1,"pos":1,"voice":"vo_char_3503_00_01"}]},{"autoTurnFirst":2.7,"chara":[{"id":350300,"motion":1}]},{"autoTurnFirst":5.7,"chara":[{"id":350302,"lipSynch":1,"motion":200,"textHome":"嘛，正如你想的那样，生活里确实有不少不方便的地方，@不过，我们过得还算不错。@最近还开始接魔法少女的保镖工作了呢。"},{"id":350300,"lipSynch":0}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302}]},{"autoTurnFirst":5.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302,"motion":1}]},{"autoTurnFirst":2.8,"chara":[{"id":350300,"lipSynch":1,"motion":200,"textHome":"有什么委托就联系我们吧。@只要有报酬，我们就接。"},{"id":350302,"lipSynch":0}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":0}]}],"group_10":[{"autoTurnFirst":5.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_17"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_00_17","textHome":"家规第二条：三个人要时刻心意相通。"}]},{"autoTurnFirst":5.0,"chara":[{"id":350300,"lipSynch":1,"textHome":"只要大家站在同样的立场看事情，@就能马上察觉谁有烦恼，也能帮忙解决。"},{"id":350302,"lipSynch":0,"motion":1}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":100}]}],"group_11":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_18"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_00_18","textHome":"家规第三条……啊，好像没有了吧。"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":350302,"motion":300}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":350300,"lipSynch":1,"motion":300,"textHome":"是呢。不如规定大家一起洗澡，怎么样？"},{"id":350302,"lipSynch":0}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":100}]},{"autoTurnFirst":2.6,"chara":[{"id":350300,"lipSynch":0},{"cheek":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":0,"textHome":"浴室也越来越挤了，@一起洗澡这件事，差不多该毕业了吧。"}]},{"autoTurnFirst":4.0,"chara":[{"id":350302,"motion":100}]}],"group_12":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_19"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_00_19","textHome":"嗯，我们的配合也越来越有模有样了呢。"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":100}]}],"group_13":[{"autoTurnFirst":2.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":1,"pos":0,"voice":"vo_char_3503_00_20"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_00_20","textHome":"三个人背靠背作战的话，@就能消除死角了。"}]},{"autoTurnFirst":2.0,"chara":[{"id":350302,"motion":400}]}],"group_14":[{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_21"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_00_21","textHome":"成为魔法少女以后，我们就一直三个人相依为命。@所以彼此既是家人，也是战友。"}]},{"autoTurnFirst":2.5,"chara":[{"eyeClose":1,"id":350302,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":2.2,"chara":[{"id":350302,"motion":100}]},{"autoTurnFirst":1.1,"chara":[{"eyeClose":1,"id":350300,"lipSynch":1,"textHome":"嗯，是无可替代的存在。"},{"id":350302,"lipSynch":0,"motion":0}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350300}]},{"autoTurnFirst":2.0,"chara":[{"id":350300,"motion":200}]}],"group_15":[{"autoTurnFirst":6.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":1,"motion":300,"pos":0,"voice":"vo_char_3503_00_22","textHome":"直到现在，我们的目标都只是保住三个人的性命。@但今后，我也希望能守护菖蒲想要守护的东西。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":0,"motion":0,"pos":1,"voice":"vo_char_3503_00_22"}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":100}]},{"autoTurnFirst":3.5,"chara":[{"id":350302,"lipSynch":1,"motion":200,"textHome":"为此，我们想保持中立。@所以无论是谁来委托保镖工作，我们都打算接下。"},{"id":350300,"lipSynch":0,"motion":0}]},{"autoTurnFirst":5.0,"chara":[{"id":350302,"motion":1}]}],"group_16":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_23"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_00_23"}]},{"autoTurnFirst":2.8,"chara":[{"id":350302,"motion":300},{"id":350300,"lipSynch":0}]},{"autoTurnFirst":2.0,"chara":[{"id":350300,"lipSynch":1,"motion":300},{"id":350302,"lipSynch":0,"motion":1}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":4.1,"chara":[{"id":350300,"motion":0}]},{"autoTurnFirst":2.4,"chara":[{"id":350300,"motion":100}]},{"autoTurnFirst":1.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300}]},{"autoTurnFirst":5.8,"chara":[{"id":350300,"lipSynch":0},{"id":350302,"lipSynch":1,"motion":100}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":200}]}],"group_17":[{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_01_24","textHome":"叶月和菖蒲都出门了，现在接不了委托。@不过，聊聊天还是可以的。@先互相说说近况吧？"}]},{"autoTurnFirst":3.1,"chara":[{"id":350301,"motion":100}]},{"autoTurnFirst":4.0,"chara":[{"id":350301,"motion":1}]}],"group_18":[{"autoTurnFirst":2.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350301,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_01_25","textHome":"早上就像打仗一样。叶月不擅长早起，得叫她起床，@也得帮菖蒲做好出门的准备。@之后还有早餐要准备……你说是吧。"}]},{"autoTurnFirst":3.4,"chara":[{"id":350301,"motion":1}]},{"autoTurnFirst":3.3,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":350301}]},{"autoTurnFirst":4.0,"chara":[{"id":350301,"motion":100}]}],"group_19":[{"autoTurnFirst":6.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_01_26","textHome":"学校午休时，吃完饭我都会去图书馆。@那里安静又舒适，还能免费学到知识，@是个很划算的地方。"}]},{"autoTurnFirst":2.3,"chara":[{"id":350301,"motion":100}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350301}]}],"group_2":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_02"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_00_02","textHome":"你好呀～先做个自我介绍吧。我叫游佐叶月。"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302}]},{"autoTurnFirst":2.2,"chara":[{"id":350302,"motion":200}]},{"autoTurnFirst":2.4,"chara":[{"id":350302,"lipSynch":0},{"id":350300,"lipSynch":1,"motion":100,"textHome":"我是静海木叶。@我们和三栗菖蒲一起，三个人开始做保镖了。"}]},{"autoTurnFirst":4.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":0},{"id":350302,"motion":1}]},{"autoTurnFirst":3.0,"chara":[{"id":350300,"lipSynch":0},{"id":350302,"lipSynch":1,"motion":100,"textHome":"今后也请多多关照我们的生意哦～"}]}],"group_20":[{"autoTurnFirst":2.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":350301,"lipSynch":1,"motion":400,"pos":1,"voice":"vo_char_3503_01_27","textHome":"这么难得的限时特卖，竟然只有我一个人赶上……！@也顾不上那么多了。能稍微帮个忙吗？@来，帮我拿着这盒抽纸。"}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350301}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_020.exp.json","id":350301,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350301}]},{"autoTurnFirst":2.0,"chara":[{"id":350301,"motion":0}]},{"autoTurnFirst":3.0,"chara":[{"id":350301,"motion":200}]}],"group_21":[{"autoTurnFirst":2.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":350301,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_01_28","textHome":"睡不着吗？其实我也是。@想事情想得越来越清醒了。@这种时候，我会去看看星星，心就能静下来。"}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":350301}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350301,"motion":300}]},{"autoTurnFirst":4.4,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":350301,"motion":100}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":350301}]}],"group_22":[{"autoTurnFirst":3.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_01_29","textHome":"以前我都是看纸质传单比较特价商品，@后来叶月告诉了我一个很方便的应用。@你看，既能比较传单，还能领取优惠券呢。"}]},{"autoTurnFirst":3.6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350301}]},{"autoTurnFirst":2.5,"chara":[{"id":350301,"motion":200}]},{"autoTurnFirst":2.5,"chara":[{"id":350301,"motion":0}]}],"group_23":[{"autoTurnFirst":3.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_01_30","textHome":"不管是保镖委托，还是消灭魔女，@我们都一定会三个人一起行动。@单独行动只会增加危险，没有好处。"}]},{"autoTurnFirst":3.4,"chara":[{"id":350301,"motion":100}]},{"autoTurnFirst":6.0,"chara":[{"id":350301,"motion":1}]}],"group_24":[{"autoTurnFirst":2.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_01_31","textHome":"镜屋敷里的复制体，只有外表和本人一模一样。@还没交谈之前，很难分辨本人和复制体。@要不要和叶月她们约好一个暗号呢？"}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350301,"motion":300}]},{"autoTurnFirst":5.0,"chara":[{"id":350301,"motion":100}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":350301,"motion":1}]}],"group_25":[{"autoTurnFirst":4.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":100,"pos":1,"voice":"vo_char_3503_01_32","textHome":"有人委托保镖工作，我们就会接下。@不过，原则上我们不打算干涉魔法少女之间的纷争。@我想优先保证我们三个人平安。"}]},{"autoTurnFirst":7.0,"chara":[{"id":350301,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350301,"motion":300}]}],"group_26":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":350301,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_01_33","textHome":"擅长的科目啊……没有特别擅长或不擅长的，@不过，我喜欢数学。@解题方法符合逻辑，让人信服，答案也很明确。"}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":350301}]},{"autoTurnFirst":8.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350301,"motion":100}]}],"group_27":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350301,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_01_34","textHome":"只吃一口就好。这次我很有信心，希望你尝尝。@这是注重健康的炒饭，调味比较淡，@配料也只有低热量的番茄和黄瓜。"}]},{"autoTurnFirst":3.4,"chara":[{"id":350301,"motion":0}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350301,"motion":1}]}],"group_28":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_01_35","textHome":"积分卡攒满了是好事，@可每次想用，都觉得舍不得，最后又放弃了。@明明光是攒着也没意义……唉……"}]},{"autoTurnFirst":5.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350301,"motion":300}]},{"autoTurnFirst":3.0,"chara":[{"id":350301,"motion":100}]},{"autoTurnFirst":2.0,"chara":[{"eyeClose":1,"id":350301}]}],"group_29":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_01_36","textHome":"作为菖蒲情操教育的一部分，养只动物也不错呢。@不过，饲养也要花钱，这种时候……@果然只能选鸡了。毕竟还能吃。"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350301}]},{"autoTurnFirst":4.1,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":350301,"motion":300}]},{"autoTurnFirst":4.0,"chara":[{"id":350301,"motion":100}]}],"group_3":[{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":350300,"lipSynch":1,"motion":300,"pos":0,"voice":"vo_char_3503_00_03"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":0,"motion":1,"pos":1,"voice":"vo_char_3503_00_03"}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350300}]},{"autoTurnFirst":3.5,"chara":[{"id":350300,"motion":0}]}],"group_30":[{"autoTurnFirst":3.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350301,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_01_37","textHome":"菖蒲没有关于父母的记忆，@所以我和叶月一直努力，想代替父母照顾她。@不过……确实也有些关心过头了呢。"}]},{"autoTurnFirst":4.6,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":350301,"motion":100}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350301,"motion":300}]}],"group_31":[{"autoTurnFirst":6.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":100,"pos":1,"voice":"vo_char_3503_01_38","textHome":"离开杜鹃之家后，我开始写日记，@起初只是想留下自己还活着的记录，@现在却也会记下当天开心的事。真是变了呢。"}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350301,"motion":0}]},{"autoTurnFirst":1.5,"chara":[{"eyeClose":1,"id":350301}]}],"group_32":[{"autoTurnFirst":3.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_01_39","textHome":"我一直戴着的项链，是非常重要的东西。@那是让我们三个人联系在一起的院长老师，@送给我的礼物。"}]},{"autoTurnFirst":2.9,"chara":[{"eyeClose":1,"id":350301}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":350301}]},{"autoTurnFirst":3.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350301,"motion":100}]},{"autoTurnFirst":4.0,"chara":[{"eyeClose":1,"id":350301,"motion":300}]}],"group_33":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350301,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_01_40","textHome":"无论过去还是将来，@叶月和菖蒲都是对我最重要的人。@不管我们今后会变成什么样，这一点都不会改变。"}]},{"autoTurnFirst":4.8,"chara":[{"id":350301,"motion":200}]},{"autoTurnFirst":3.6,"chara":[{"id":350301,"motion":100}]},{"autoTurnFirst":3.0,"chara":[{"eyeClose":1,"id":350301}]}],"group_34":[{"autoTurnFirst":5.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":350301,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_01_41","textHome":"沮丧的时候，如果有人摸摸头，告诉我“没事的”，@就能打起精神。我以前也是这样。@来，摸摸摸～……怎么样？"}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":350301}]},{"autoTurnFirst":2.9,"chara":[{"cheek":1,"face":"mtn_ex_030.exp.json","id":350301,"motion":100}]},{"autoTurnFirst":1.0,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":350301}]},{"autoTurnFirst":2.3,"chara":[{"eyeClose":1,"id":350301,"motion":400}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350301}]},{"autoTurnFirst":1.5,"chara":[{"id":350301,"motion":0}]}],"group_35":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350300,"lipSynch":1,"motion":200,"pos":0,"voice":"vo_char_3503_00_42","textHome":"速战速决吧，叶月。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":0,"motion":0,"pos":1,"voice":"vo_char_3503_00_42"}]},{"autoTurnFirst":2.0,"chara":[{"id":350302,"lipSynch":1,"motion":100,"textHome":"好，木叶。"},{"id":350300,"lipSynch":0}]}],"group_36":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_43","textHome":"太轻松了，都让我打哈欠了。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":35030