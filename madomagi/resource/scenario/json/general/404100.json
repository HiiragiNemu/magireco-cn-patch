{"story":{"group_1":[{"autoTurnFirst":3.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_01","textHome":"我的锤子能夺走被击中物体的重量。@夺走的重量越多，锤子就越重，攻击力也越强。@背着这么沉重的负担，@总觉得自己偏离人生原本的道路太远了。"}]},{"autoTurnFirst":4.8,"chara":[{"cheek":0,"eyeClose":1,"id":404100,"motion":300}]},{"autoTurnFirst":7.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":200}]}],"group_10":[{"autoTurnFirst":3.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_18"}]},{"autoTurnFirst":4.55,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":404100}]},{"autoTurnFirst":5.0,"chara":[{"cheek":1,"eyeClose":0,"id":404100,"motion":300}]}],"group_11":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":300,"pos":1,"voice":"vo_char_4041_00_19","textHome":"锤子又变重了……@这东西，我还举得起来吗？"}]},{"autoTurnFirst":3.2,"chara":[{"eyeClose":1,"id":404100}]}],"group_12":[{"autoTurnFirst":3.65,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_20","textHome":"等一下，该不会连体重也增加了吧？@要是跨过那个大关，我可就困扰了。"}]},{"autoTurnFirst":5.3,"chara":[{"cheek":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":200}]}],"group_13":[{"autoTurnFirst":3.65,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_21"}]},{"autoTurnFirst":5.3,"chara":[{"cheek":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":200}]}],"group_14":[{"autoTurnFirst":3.65,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_22"}]},{"autoTurnFirst":5.3,"chara":[{"cheek":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":200}]}],"group_15":[{"autoTurnFirst":3.65,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_23"}]},{"autoTurnFirst":5.3,"chara":[{"cheek":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":200}]}],"group_16":[{"autoTurnFirst":0.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_24","textHome":"今天也很开心呢，再见。@……咦，今天才刚见面吗？@抱歉，真的是我弄错了。"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":1,"id":404100}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404100,"motion":400}]},{"autoTurnFirst":4.8,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":1}]}],"group_17":[{"autoTurnFirst":3.35,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":404100,"motion":300,"pos":1,"voice":"vo_char_4041_00_25","textHome":"早上好，我还很困呢。@因为我是个恋父情结很重的人，@睡在爸爸的被窝里时，就会兴奋得睡不着。"}]},{"autoTurnFirst":7.0,"chara":[{"cheek":1,"face":"mtn_ex_000.exp.json","id":404100,"motion":100}]}],"group_18":[{"autoTurnFirst":4.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":200,"pos":1,"voice":"vo_char_4041_00_26","textHome":"要一起学习吗？别看我这样，好歹也是优等生，@稍微充当一下家庭教师，还是做得到的。"}]},{"autoTurnFirst":1.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":404100,"motion":100}]},{"autoTurnFirst":3.6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":404100}]}],"group_19":[{"autoTurnFirst":3.75,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":200,"pos":1,"voice":"vo_char_4041_00_27","textHome":"咦，怎么了？我正要去采购文具呢。@当然是为了藏在身上，当作武器……@说错了，是当作文具使用。"}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":100}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":404100}]}],"group_2":[{"autoTurnFirst":2.45,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":300,"pos":1,"voice":"vo_char_4041_00_03"}]},{"autoTurnFirst":3.65,"chara":[{"cheek":0,"eyeClose":0,"id":404100}]}],"group_20":[{"autoTurnFirst":4.35,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_28","textHome":"我可以先睡了吗？今天发生了不少事，累坏了。@现在的话……被被窝抱住也没关系。"}]},{"autoTurnFirst":1.95,"chara":[{"eyeClose":0,"id":404100,"motion":300}]},{"autoTurnFirst":2.2,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":404100}]}],"group_21":[{"autoTurnFirst":2.85,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":404100,"motion":0,"pos":1,"voice":"vo_char_4041_00_29","textHome":"许愿想要回忆，结果却得到了一把沉重的锤子……@那个白色的毛绒玩偶……果然是个骗子吧……"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":100}]},{"autoTurnFirst":3.4,"chara":[{"eyeClose":0,"id":404100}]}],"group_22":[{"autoTurnFirst":3.15,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_30","textHome":"我等了很久了。你刚才都去哪里了？@我可没有像某个人那样，@被晾在一边还会开心的癖好。"}]},{"autoTurnFirst":6.2,"chara":[{"id":404100,"motion":200}]}],"group_23":[{"autoTurnFirst":4.15,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404100,"motion":300,"pos":1,"voice":"vo_char_4041_00_31","textHome":"要去战斗吗？别太勉强自己。@倒也不是在担心你……@不过，要是不回来，我可不会原谅你。"}]},{"autoTurnFirst":5.0,"chara":[{"cheek":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":100}]},{"autoTurnFirst":3.6,"chara":[{"cheek":1,"face":"mtn_ex_020.exp.json","id":404100,"motion":200}]}],"group_24":[{"autoTurnFirst":2.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_32"}]},{"autoTurnFirst":4.4,"chara":[{"id":404100,"motion":0}]},{"autoTurnFirst":5.35,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":404100,"motion":200}]}],"group_25":[{"autoTurnFirst":3.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":404100,"motion":200,"pos":1,"voice":"vo_char_4041_00_33","textHome":"抱歉，我现在正在专心学习。@要是打扰我，被埋进山里还是沉进海里……@就让你选更讨厌的那一种吧。"}]},{"autoTurnFirst":4.35,"chara":[{"eyeClose":1,"id":404100}]},{"autoTurnFirst":4.35,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404100,"motion":100}]}],"group_26":[{"autoTurnFirst":3.05,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_34","textHome":"你说我被害妄想太严重了？……真讨厌。@就算是实话，也分该说和不该说的吧。"}]},{"autoTurnFirst":5.8,"chara":[{"cheek":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":200}]}],"group_27":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404100,"motion":200,"pos":1,"voice":"vo_char_4041_00_35","textHome":"房间太乱了，我替你收拾好了。@那件设计得连墓牌都要吓倒的运动衫，@我已经当垃圾丢掉了。"}]},{"autoTurnFirst":4.2,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":404100,"motion":100}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":404100}]}],"group_28":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":0,"pos":1,"voice":"vo_char_4041_00_36","textHome":"一直以来谢谢你，我真的很感激。@不，没有别的意思。@我从小就被父母教导，要好好把感谢说出口。"}]},{"autoTurnFirst":5.8,"chara":[{"eyeClose":0,"id":404100,"motion":100}]},{"autoTurnFirst":3.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":0}]}],"group_29":[{"autoTurnFirst":3.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":200,"pos":1,"voice":"vo_char_4041_00_37","textHome":"有时我会想起别人的回忆。@听说我的锤子还拥有能读取残留思念的接触感应能力……@不会吧。"}]},{"autoTurnFirst":4.55,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_021.exp.json","id":404100}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":404100}]},{"autoTurnFirst":2.8,"chara":[{"id":404100,"motion":300}]}],"group_3":[{"autoTurnFirst":2.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":0,"pos":1,"voice":"vo_char_4041_00_04"}]},{"autoTurnFirst":5.0,"chara":[{"eyeClose":1,"id":404100,"motion":1}]}],"group_30":[{"autoTurnFirst":4.65,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404100,"motion":300,"pos":1,"voice":"vo_char_4041_00_38","textHome":"我为什么会在做这些事呢？@总觉得自己还没有遇见……@那个本来应该相遇的……重要的人……"}]},{"autoTurnFirst":7.2,"chara":[{"cheek":1,"eyeClose":1,"id":404100}]}],"group_31":[{"autoTurnFirst":7.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":200,"pos":1,"voice":"vo_char_4041_00_39","textHome":"只告诉你哦，我会用“削着苹果走吧”这个听众昵称，@给一个广播节目投稿，我很期待那个节目呢。"}]},{"autoTurnFirst":3.15,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404100,"motion":100}]}],"group_32":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404100,"motion":0,"pos":1,"voice":"vo_char_4041_00_40","textHome":"我的体重？虽然没准确掌握，@大概是四十多公斤里偏后面的数，再多一点吧。@不，不是五十公斤。@是四十多公斤里偏后面的数，再多一点。"}]},{"autoTurnFirst":4.55,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":100}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_020.exp.json","id":404100,"motion":200}]},{"autoTurnFirst":4.8,"chara":[{"eyeClose":0,"id":404100}]}],"group_33":[{"autoTurnFirst":4.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":400,"pos":1,"voice":"vo_char_4041_00_41","textHome":"喂？不……我可没有在等电话。@只是把通话键错当成电源键按下去了，@所以才只好接起来。"}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":404100,"motion":100}]},{"autoTurnFirst":4.35,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404100,"motion":1}]}],"group_34":[{"autoTurnFirst":1.4,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_42","textHome":"你打算与我作对吗？"}]},{"autoTurnFirst":1.7,"chara":[{"cheek":0,"eyeClose":0,"id":404100}]}],"group_35":[{"autoTurnFirst":1.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_43","textHome":"所以我不是说过了吗？"}]},{"autoTurnFirst":1.0,"chara":[{"eyeClose":1,"id":404100}]}],"group_36":[{"autoTurnFirst":1.3,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_020.exp.json","id":404100,"motion":1,"pos":1,"voice":"vo_char_4041_00_44","textHome":"都出汗了呢。"}]},{"autoTurnFirst":2.0,"chara":[{"eyeClose":0,"id":404100}]}],"group_37":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404100,"motion":300,"pos":1,"voice":"vo_char_4041_00_45","textHome":"好像做过头了……？"}]}],"group_38":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":200,"pos":1,"voice":"vo_char_4041_00_46","textHome":"这样就足够了吧？"}]}],"group_39":[{"autoTurnFirst":0.5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_63"}]},{"autoTurnFirst":3.5,"chara":[{"eyeClose":0,"id":404100}]}],"group_4":[{"autoTurnFirst":4.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404100,"motion":200,"pos":1,"voice":"vo_char_4041_00_05"}]}],"group_40":[{"autoTurnFirst":0.9,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_64"}]},{"autoTurnFirst":2.95,"chara":[{"cheek":0,"face":"mtn_ex_021.exp.json","id":404100}]}],"group_41":[{"autoTurnFirst":3.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404100,"motion":400,"pos":1,"voice":"vo_char_4041_00_65"}]}],"group_42":[{"autoTurnFirst":0.35,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_021.exp.json","id":404100,"motion":1,"pos":1,"voice":"vo_char_4041_00_66"}]},{"autoTurnFirst":3.8,"chara":[{"eyeClose":0,"id":404100}]}],"group_43":[{"autoTurnFirst":2.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":0,"pos":1,"voice":"vo_char_4041_00_02","textHome":"我的个人资料？嗯，生日是7月7日，巨蟹座。@喜欢的小说家是梦野久作。@如果我的记忆没错，应该是私立直江津高中的高三学生。@像我这样的角色……就叫作傲娇吧？"}]},{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"id":404100,"motion":300}]},{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404100,"motion":200}]},{"autoTurnFirst":5.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":404100,"motion":1}]}],"group_5":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_13","textHome":"觉得锤子变轻了，@是因为魔力变强了吗？"}]}],"group_6":[{"autoTurnFirst":2.1,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":404100,"motion":0,"pos":1,"voice":"vo_char_4041_00_14","textHome":"感觉像是脱胎换骨了一样呢。@准许你称呼我为……全新的战场原大人。"}]},{"autoTurnFirst":5.2,"chara":[{"eyeClose":0,"id":404100,"motion":1}]}],"group_7":[{"autoTurnFirst":2.8,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_15","textHome":"今后也愿意继续和我好好相处的话，@我……会很开心的。"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":404100}]}],"group_8":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":200,"pos":1,"voice":"vo_char_4041_00_16"}]},{"autoTurnFirst":4.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404100,"motion":300}]}],"group_9":[{"autoTurnFirst":2.95,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":404100,"motion":100,"pos":1,"voice":"vo_char_4041_00_17"}]},{"autoTurnFirst":5.1,"chara":[{"id":404100,"motion":200}]}]},"version":3}