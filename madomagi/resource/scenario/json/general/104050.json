motion":100}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000}]}],"group_34":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":0,"pos":1,"voice":"vo_char_1040_50_41"}]},{"autoTurnFirst":5.1,"chara":[{"eyeClose":1,"id":104000,"motion":300}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":5.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100}]}],"group_35":[{"autoTurnFirst":4.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":104000,"motion":400,"pos":1,"voice":"vo_char_1040_00_42","textHome":"就算是我，也忍不下去了。"}]}],"group_36":[{"autoTurnFirst":3.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_43","textHome":"好、好强的敌人……！"}]}],"group_37":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_44","textHome":"想赢的话，请务必来调整屋。"}]}],"group_38":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":200,"pos":1,"voice":"vo_char_1040_00_45","textHome":"您至今到底都做了些什么？"}]}],"group_39":[{"autoTurnFirst":2.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":104000,"motion":200,"pos":1,"voice":"vo_char_1040_00_46","textHome":"以死谢罪吧……！！"}]}],"group_4":[{"autoTurnFirst":4.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_04","textHome":"要活下去，碍事的东西实在太多了。"}]}],"group_5":[{"autoTurnFirst":1.7,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_05","textHome":"所以我……会继续活下去。"}]},{"autoTurnFirst":3.3,"chara":[{"eyeClose":0,"id":104000}]}],"group_6":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_13","textHome":"偶尔成为被调整的一方也不错。"}]}],"group_7":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_14","textHome":"这确实非常值得高兴…@…但不能就此满足。"}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000}]}],"group_8":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_15","textHome":"就算试探我……也不会有什么乐趣的。"}]}],"group_9":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_16","textHome":"遇见老师时，我已经放弃了一切，@甚至接受了死亡。@是老师给予了我活下去的方法与意义。"}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":104000}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":5.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":400}]}]},"version":3}