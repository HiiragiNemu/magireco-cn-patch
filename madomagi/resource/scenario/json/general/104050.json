{"story":{"group_1":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_01","textHome":"我是旅行调整屋之一，篠目夜鹤。@受老师邀请，我成为了调整屋。@作为魔法少女，我实在太过弱小，@甚至没有活下去的力量，@是老师为我指明了生存之路。@虽然我作为调整屋还缺乏经验，@但我会怀着自豪，接过您托付的灵魂宝石。"}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1}]},{"autoTurnFirst":8.5,"chara":[{"id":104000,"motion":0}]},{"autoTurnFirst":3.4,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":400}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100}]}],"group_10":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_17","textHome":"受到老师邀请后，@我决定在神滨活动。@并不是因为我对神滨特别感兴趣，@只是因为老师邀请了我，所以我来了。"}]},{"autoTurnFirst":4.5,"chara":[{"id":104000,"motion":0}]},{"autoTurnFirst":2.7,"chara":[{"id":104000,"motion":100}]}],"group_11":[{"autoTurnFirst":4.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_18","textHome":"老师或许只是在利用我。@但那样也没关系。我接受这一点，@并会为了老师竭尽全力。"}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":0}]},{"autoTurnFirst":5.0,"chara":[{"eyeClose":1,"id":104000,"motion":100}]}],"group_12":[{"autoTurnFirst":5.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_19","textHome":"我希望永远不会有使用这股力量的机会。"}]}],"group_13":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":200,"pos":1,"voice":"vo_char_1040_00_20","textHome":"这就是……为了活下去的力量……"}]}],"group_14":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":0,"pos":1,"voice":"vo_char_1040_00_21","textHome":"我曾以为已经到达极限的力量，@原来还有更高的境界。@这个误算让我非常高兴。@毕竟我还不能死。"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000}]},{"autoTurnFirst":2.7,"chara":[{"id":104000,"motion":100}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000}]}],"group_15":[{"autoTurnFirst":3.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_00_22","textHome":"……我又获得了力量……。@我感到高兴，却也有些恐惧。@因为我……曾经是一个沉溺于力量的人…@…。但我绝不会再次沉溺。@我已经不再孤独了。"}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104000,"motion":300}]},{"autoTurnFirst":5.8,"chara":[{"id":104000,"motion":100}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":104000,"motion":0}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":1}]}],"group_16":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_00_23","textHome":"我一直怀着“绝不能死”的念头坚强地活着，@却也没有明确的未来目标。不过，@为了证明我存在的意义，我会每天努力精进。@所以拿到悲叹之种后，@请务必来 Puella Care！"}]},{"autoTurnFirst":3.9,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":104000}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":104000}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":400}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100}]}],"group_17":[{"autoTurnFirst":2.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":0,"pos":1,"voice":"vo_char_1040_50_24"}]},{"autoTurnFirst":2.8,"chara":[{"id":104000,"motion":400}]},{"autoTurnFirst":3.3,"chara":[{"id":104000,"motion":100}]},{"autoTurnFirst":4.9,"chara":[{"id":104000,"motion":1}]}],"group_18":[{"autoTurnFirst":3.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":300,"pos":1,"voice":"vo_char_1040_50_25"}]},{"autoTurnFirst":3.4,"chara":[{"id":104000,"motion":200}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":0}]},{"autoTurnFirst":2.3,"chara":[{"id":104000,"motion":100}]}],"group_19":[{"autoTurnFirst":2.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_50_26"}]},{"autoTurnFirst":5.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100}]},{"autoTurnFirst":4.3,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":300}]}],"group_2":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_00_02","textHome":"您好，我叫篠目夜鹤，@在中央区经营调整屋。@您光临时，@请允许我用美味甜点款待您。"}]},{"autoTurnFirst":3.3,"chara":[{"id":104000,"motion":1}]},{"autoTurnFirst":5.5,"chara":[{"id":104000,"motion":300}]}],"group_20":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":0,"pos":1,"voice":"vo_char_1040_50_27"}]},{"autoTurnFirst":5.7,"chara":[{"id":104000,"motion":400}]},{"autoTurnFirst":3.6,"chara":[{"id":104000,"motion":100}]}],"group_21":[{"autoTurnFirst":4.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":100,"pos":1,"voice":"vo_char_1040_50_28"}]},{"autoTurnFirst":3.1,"chara":[{"id":104000,"motion":300}]},{"autoTurnFirst":3.3,"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104000,"motion":0}]}],"group_22":[{"autoTurnFirst":4.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp.json","id":104000,"motion":1,"pos":1,"voice":"vo_char_1040_50_29"}]},{"autoTurnFirst":5.2,"chara":[{"id":104000,"motion":300}]},{"autoTurnFirst":2.7,"chara":[{"eyeClose":1,"id":104000,"motion":100}]}],"group_23":[{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020