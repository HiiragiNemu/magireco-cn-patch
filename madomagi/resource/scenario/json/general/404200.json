{"story":{"group_1":[{"autoTurnFirst":3.95,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":400,"pos":1,"tear":0,"voice":"vo_char_4042_00_01","textHome":"要我自我介绍，也没什么好说的。@如你所见，我是个小学生，正在迷路！@一天到晚都在迷路！@我向丘比先生许愿“想回家”，成了魔法少女，@可现在还是迷路的状态！"}]},{"autoTurnFirst":6.0,"chara":[{"eyeClose":0,"id":404200,"motion":300}]},{"autoTurnLast":1.0,"chara":[{"eyeClose":1,"id":404200}]},{"autoTurnLast":3.8,"chara":[{"eyeClose":1,"id":404200,"motion":100}]},{"autoTurnFirst":2.6,"chara":[{"cheek":1,"eyeClose":0,"id":404200,"motion":0}]}],"group_10":[{"autoTurnFirst":2.35,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_17"}]},{"autoTurnFirst":8.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":300}]}],"group_11":[{"autoTurnFirst":3.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_18"}]},{"autoTurnFirst":7.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":200}]}],"group_12":[{"autoTurnFirst":6.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":1,"pos":1,"tear":0,"voice":"vo_char_4042_00_19","textHome":"比起变强，我倒更想摆脱迷路呢！"}]}],"group_13":[{"autoTurnFirst":1.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":100,"pos":1,"tear":0,"voice":"vo_char_4042_00_20","textHome":"原来就算只是迷路，坚持很多年也会成长呢！"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":404200}]}],"group_14":[{"autoTurnFirst":1.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":100,"pos":1,"tear":0,"voice":"vo_char_4042_00_21"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":404200}]}],"group_15":[{"autoTurnFirst":1.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":100,"pos":1,"tear":0,"voice":"vo_char_4042_00_22"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":404200}]}],"group_16":[{"autoTurnFirst":1.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":100,"pos":1,"tear":0,"voice":"vo_char_4042_00_23"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":404200}]}],"group_17":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":400,"pos":1,"tear":0,"voice":"vo_char_4042_00_24","textHome":"又遇见我了呢。你打算陪我一起走吗？@那么，今天也打起精神，努力迷路吧！"}]},{"autoTurnFirst":3.65,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":0}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":404200,"motion":200}]}],"group_18":[{"autoTurnFirst":1.45,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_25","textHome":"学校？我忙着迷路，哪还顾得上学校。@要是真的去上学，那就完了。@我有信心一定会迷路，回不了家！"}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":200}]},{"autoTurnFirst":5.3,"chara":[{"cheek":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":0}]}],"group_19":[{"autoTurnFirst":2.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":1,"pos":1,"tear":0,"voice":"vo_char_4042_00_26","textHome":"我肚子饿了哦？@如果你还在为去哪家店而犹豫，就别顾虑我啦。@只要是吃的，我都喜欢！"}]},{"autoTurnFirst":4.3,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":0}]},{"autoTurnFirst":3.9,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":404200,"motion":100}]}],"group_2":[{"autoTurnFirst":1.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_02","textHome":"我许愿“想回家”，成为了魔法少女，@却还是一直迷路。@不仅如此，凡是与我扯上关系的人，也都会迷路。@迷路得太厉害，总觉得已经偏离原本的路线，@闯进另一个平行世界了！"}]},{"autoTurnFirst":4.6,"chara":[{"cheek":0,"id":404200}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_050.exp.json","id":404200,"motion":1}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":1,"id":404200}]},{"autoTurnFirst":5.2,"chara":[{"eyeClose":0,"id":404200,"motion":0}]},{"autoTurnFirst":3.2,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":200}]}],"group_20":[{"autoTurnFirst":6.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":404200,"motion":300,"pos":1,"tear":0,"voice":"vo_char_4042_00_27","textHome":"真巧啊～我迷路到了不认识的地方，@正在顺便散散步。@换个说法，也可以叫作迷路！"}]},{"autoTurnFirst":3.75,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":0}]}],"group_21":[{"autoTurnFirst":5.75,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":404200,"motion":300,"pos":1,"tear":0,"voice":"vo_char_4042_00_28","textHome":"好困……今天又在迷路中度过一整天了……@到底什么时候才能回去呢……"}]},{"autoTurnFirst":4.75,"chara":[{"cheek":1,"eyeClose":0,"id":404200}]}],"group_22":[{"autoTurnFirst":5.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":200,"pos":1,"tear":0,"voice":"vo_char_4042_00_29","textHome":"忙得没时间学习，不过是不会安排时间的人的借口。@嘛，我自己从来没学习过，所以并不清楚啦！"}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":404200,"motion":0}]}],"group_23":[{"autoTurnFirst":2.95,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_30","textHome":"好了！该去消灭魔女了！@出发前先把路线仔细查清楚吧。@毕竟也可能出现“捉木乃伊的人变成金字塔”的情况呢。"}]},{"autoTurnFirst":2.8,"chara":[{"eyeClose":1,"id":404200,"motion":300}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":200}]}],"group_24":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":300,"pos":1,"tear":0,"voice":"vo_char_4042_00_31","textHome":"听说你要去镜之魔女的结界，没问题吗？@去倒还好，只希望你能从结界里平安回来！"}]},{"autoTurnFirst":5.6,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":0}]}],"group_25":[{"autoTurnFirst":4.8,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_32"}]},{"autoTurnFirst":3.4,"chara":[{"eyeClose":0,"id":404200,"motion":1}]},{"autoTurnFirst":3.6,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":404200}]}],"group_26":[{"autoTurnFirst":3.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":400,"pos":1,"tear":0,"voice":"vo_char_4042_00_33","textHome":"请别靠近我！迷路会传染的！@诶，问我吗？我叫八九寺真宵，@小学五年级，正在迷路！"}]},{"autoTurnFirst":7.5,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":100}]}],"group_27":[{"autoTurnFirst":5.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_34","textHome":"我一直觉得，只要作为魔法少女变得更强，就能回家……@可是仔细想想，好像谁也没这么说过呢。"}]},{"autoTurnFirst":5.15,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":100}]}],"group_28":[{"autoTurnFirst":4.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":400,"pos":1,"tear":0,"voice":"vo_char_4042_00_35","textHome":"总觉得自己是魔法少女这件事很不对劲。@但要问我以前是不是普通女孩，@我也没什么自信！"}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":300}]}],"group_29":[{"autoTurnFirst":3.35,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_36","textHome":"成了魔法少女，不但还是回不了家，@就连当初跟我搭话的丘比先生也失踪了！@难道我的迷路能力又提高了吗？"}]},{"autoTurnFirst":3.05,"chara":[{"eyeClose":1,"id":404200,"motion":100}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":0}]}],"group_3":[{"autoTurnFirst":2.9,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_050.exp.json","id":404200,"motion":300,"pos":1,"tear":0,"voice":"vo_char_4042_00_03"}]},{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"id":404200}]}],"group_30":[{"autoTurnFirst":6.15,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_37","textHome":"听好了！别沉醉在“只要肯做就一定能成”@这种好听的话里！@说这种话的，可都是不去做的人！"}]},{"autoTurnFirst":3.9,"chara":[{"eyeClose":1,"id":404200,"motion":100}]}],"group_31":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":200,"pos":1,"tear":0,"voice":"vo_char_4042_00_38","textHome":"别光买了参考书就心满意足。@我自己也经常买了电子游戏，@光是买到就满足了，根本不玩呢。"}]},{"autoTurnFirst":4.15,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":0}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":404200,"motion":300}]}],"group_32":[{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_39","textHome":"别害怕挑战。踏入新的领域，一定会有所收获。@比如说……钱！"}]},{"autoTurnFirst":3.15,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":404200,"motion":100}]},{"autoTurnFirst":3.6,"chara":[{"cheek":1,"face":"mtn_ex_021.exp.json","id":404200,"motion":300}]}],"group_33":[{"autoTurnFirst":4.75,"chara":[{"cheek":2,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":300,"pos":1,"tear":0,"voice":"vo_char_4042_00_40","textHome":"其实……我想回的是妈妈的家。@父母离婚后，妈妈就搬出去了。@可是妈妈的那个家……@我却怎么也到不了……"}]},{"autoTurnFirst":4.65,"chara":[{"eyeClose":1,"id":404200}]},{"autoTurnFirst":4.8,"chara":[{"eyeClose":0,"id":404200,"motion":0,"tear":1}]}],"group_34":[{"autoTurnFirst":1.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":404200,"motion":400,"pos":1,"tear":0,"voice":"vo_char_4042_00_41","textHome":"你想要爱！？啊……知道，知道！@那个前几天便利店里就有卖！@没错，298日元。"}]},{"autoTurnFirst":3.75,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":404200,"motion":300}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"id":404200,"motion":300}]}],"group_35":[{"autoTurnFirst":2.5,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_42","textHome":"请别跟我说话！"}]}],"group_36":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":400,"pos":1,"tear":0,"voice":"vo_char_4042_00_43","textHome":"碍事的人已经消失了。"}]}],"group_37":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":100,"pos":1,"tear":0,"voice":"vo_char_4042_00_44","textHome":"回去吧！@虽然不保证回得去……"}]}],"group_38":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":404200,"motion":1,"pos":1,"tear":0,"voice":"vo_char_4042_00_45","textHome":"可爱的迷路孩子，就该让她去旅行。"}]}],"group_39":[{"autoTurnFirst":3.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":300,"pos":1,"tear":0,"voice":"vo_char_4042_00_46","textHome":"究竟什么时候才能回去呢？"}]}],"group_4":[{"autoTurnFirst":4.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_04"}]}],"group_40":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_021.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_63"}]},{"autoTurnFirst":3.2,"chara":[{"eyeClose":0,"id":404200}]}],"group_41":[{"autoTurnFirst":2.7,"chara":[{"cheek":2,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":200,"pos":1,"tear":0,"voice":"vo_char_4042_00_64"}]}],"group_42":[{"autoTurnFirst":0.95,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_65"}]},{"autoTurnFirst":2.4,"chara":[{"id":404200,"motion":100}]}],"group_43":[{"autoTurnFirst":1.3,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_021.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_66"}]},{"autoTurnFirst":2.8,"chara":[{"eyeClose":0,"id":404200}]}],"group_5":[{"autoTurnFirst":5.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":300,"pos":1,"tear":0,"voice":"vo_char_4042_00_05"}]}],"group_6":[{"autoTurnFirst":2.55,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_13","textHome":"我在班上本来就算发育得比较好的，@现在又长大了！"}]},{"autoTurnFirst":2.9,"chara":[{"cheek":2,"face":"mtn_ex_011.exp.json","id":404200,"motion":1}]}],"group_7":[{"autoTurnFirst":2.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":404200,"motion":300,"pos":1,"tear":0,"voice":"vo_char_4042_00_14","textHome":"我的魔力已经到达极限，MAX了！@不过……要是身体不再长大，可就麻烦了……"}]},{"autoTurnFirst":3.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":404200,"motion":0}]}],"group_8":[{"autoTurnFirst":2.55,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_021.exp.json","id":404200,"motion":300,"pos":1,"tear":0,"voice":"vo_char_4042_00_15","textHome":"谢谢你还这么不长记性，@一直陪着我迷路！"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":404200}]}],"group_9":[{"autoTurnFirst":4.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":404200,"motion":0,"pos":1,"tear":0,"voice":"vo_char_4042_00_16"}]},{"autoTurnFirst":6.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_021.exp.json","id":404200,"motion":200}]}]},"version":3}