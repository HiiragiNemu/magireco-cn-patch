{"story":{"group_1":[{"autoTurnFirst":2.5,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_01","textHome":"要、要是一直盯着我看，该说会感到困扰吗…@…虽然就像这样穿上了晴着……但是，果然@还是有点害羞啊……所以，我拒不接受对于@这身打扮的感想！能对我说的只有一句话，@“新年快乐！”……就是这样了！"}]},{"autoTurnFirst":2.3,"chara":[{"id":240000,"motion":300}]},{"autoTurnFirst":3.7,"chara":[{"id":240000,"motion":100}]},{"autoTurnFirst":2.8,"chara":[{"cheek":1,"face":"mtn_ex_041.exp.json","id":240000}]},{"autoTurnFirst":0.8,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_020.exp.json","id":240000,"motion":0}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":240000}]},{"autoTurnFirst":3.9,"chara":[{"id":240000,"motion":200}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0}]},{"autoTurnFirst":1.3,"chara":[{"eyeClose":1,"id":240000,"motion":300}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":240000}]},{"autoTurnFirst":2.9,"chara":[{"id":240000,"motion":1}]}],"group_10":[{"autoTurnFirst":5.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":100,"pos":1,"voice":"vo_char_2400_00_17","textHome":"我试着买了个福袋，结果里面装着的全都是我@想要的东西。果然，运气似乎站在沙耶香这@边呢！"}]},{"autoTurnFirst":1.2,"chara":[{"id":240000,"motion":1}]},{"autoTurnFirst":3.3,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":240000}]}],"group_11":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_18","textHome":"穿着漂亮的晴着，吃着美味的食物，买东西买@到心满意足……新年过得这么棒真的好吗？"}]},{"autoTurnFirst":1.8,"chara":[{"id":240000,"motion":1}]},{"autoTurnFirst":1.9,"chara":[{"eyeClose":1,"id":240000,"motion":300}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":240000}]},{"autoTurnFirst":3.8,"chara":[{"id":240000,"motion":100}]}],"group_12":[{"autoTurnFirst":2.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_19","textHome":"踏出新的一步之后，总感觉自己也变得充实了@起来！"}]},{"autoTurnFirst":2.7,"chara":[{"id":240000,"motion":200}]}],"group_13":[{"autoTurnFirst":3.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":100,"pos":1,"voice":"vo_char_2400_00_20","textHome":"是不是因为这身打扮呢……感觉我变得比平时@要更积极向上了。"}]},{"autoTurnFirst":3.7,"chara":[{"id":240000,"motion":1}]}],"group_14":[{"autoTurnFirst":4.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_21","textHome":"总感觉，自己变得比平时更能抬头挺胸地走路@了。所以，景色看起来和平时不同，我肯定@也会有崭新的相遇和发现的！"}]},{"autoTurnFirst":3.2,"chara":[{"id":240000,"motion":1}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":240000,"motion":201}]}],"group_15":[{"autoTurnFirst":5.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":300,"pos":1,"voice":"vo_char_2400_00_22","textHome":"直率地面对自己的想法，真的是一件非常困难@的事情呢。但是，回顾一下就能发现去年的@自己受到了大家很多支持，所以今年我想要@回应大家。所以，我想要变得更加直率。"}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0}]},{"autoTurnFirst":2.5,"chara":[{"id":240000,"motion":1}]},{"autoTurnFirst":4.0,"chara":[{"id":240000,"motion":100}]}],"group_16":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":240000,"motion":300,"pos":1,"voice":"vo_char_2400_00_23","textHome":"新年来到，我感觉自己也变得焕然一新了。比@至今为止更加大胆，比至今为止更加强大…@…我想要变成那样的人，所以，今年也拜托@你为沙耶香加油了哦？"}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":240000}]},{"autoTurnFirst":4.3,"chara":[{"id":240000,"motion":200}]},{"autoTurnFirst":2.0,"chara":[{"id":240000,"motion":0}]},{"autoTurnFirst":4.2,"chara":[{"id":240000,"motion":100}]}],"group_17":[{"autoTurnFirst":5.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_041.exp.json","id":240000,"motion":100,"pos":1,"voice":"vo_char_2400_00_24","textHome":"我一直想说这句话，从去年开始就迫不及待了@～谁先来说？那就从我开始吧！……新年快@乐！"}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":0}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":240000,"motion":300}]}],"group_18":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":1,"pos":1,"voice":"vo_char_2400_00_25","textHome":"早上好！昨天睡得好吗？其实我在跨年之前就@睡着了……虽然也感觉有点浪费，但是因为@睡了很久，我的精神非常充沛哦！"}]},{"autoTurnFirst":4.4,"chara":[{"cheek":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":100}]},{"autoTurnFirst":1.8,"chara":[{"id":240000,"motion":0}]},{"autoTurnFirst":4.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":200}]}],"group_19":[{"autoTurnFirst":5.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":1,"pos":1,"voice":"vo_char_2400_00_26","textHome":"让我特别地把吃到美味年糕的方法传授给你吧@！像这样，把芝士放在烤年糕上，然后用海@苔包着吃。好了，很好吃的所以吃吃看吧！"}]},{"autoTurnFirst":3.9,"chara":[{"id":240000,"motion":300}]},{"autoTurnFirst":1.8,"chara":[{"id":240000,"motion":201}]},{"autoTurnFirst":0.7,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":240000,"motion":0}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000}]}],"group_2":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_02","textHome":"从正月开始，想做的事情就有一大堆呢。难得@我也换上了晴着，为了不会后悔，把这些全@都做一遍吧！"}]},{"autoTurnFirst":2.6,"chara":[{"id":240000,"motion":1}]},{"autoTurnFirst":3.9,"chara":[{"id":240000,"motion":200}]}],"group_20":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_27","textHome":"我新年期间几乎一直在吃和式的食物，所以身@体也差不多想感受一下不同的味道了……嗯@，比如披萨或者咖喱之类的！"}]},{"autoTurnFirst":4.2,"chara":[{"cheek":0,"face":"mtn_ex_041.exp.json","id":240000,"motion":1}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":100}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":240000,"motion":201}]}],"group_21":[{"autoTurnFirst":3.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":300,"pos":1,"voice":"vo_char_2400_00_28","textHome":"夜晚还是非常寒冷呢……虽然因为是寒假就有@点兴奋了，但差不多是时间回家暖和一下了@吧！"}]},{"autoTurnFirst":2.9,"chara":[{"id":240000,"motion":100}]},{"autoTurnFirst":3.9,"chara":[{"cheek":0,"face":"mtn_ex_041.exp.json","id":240000,"motion":0}]}],"group_22":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_29","textHome":"虽然走亲访友很麻烦，但是为了红包还是要忍@耐忍耐……不，这种感觉是正常的吧！？我@算不算是坏孩子啊！？"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":240000,"motion":300}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":240000}]},{"autoTurnFirst":1.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":240000}]},{"autoTurnFirst":2.3,"chara":[{"id":240000,"motion":400}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":201}]}],"group_23":[{"autoTurnFirst":2.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":100,"pos":1,"voice":"vo_char_2400_00_30","textHome":"虽然窝在家里消极怠工也很棒，但身体懈怠下@来可不好呢。就是这样，通过讨伐魔女运动@运动！"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":300}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":240000,"motion":0}]},{"autoTurnFirst":3.2,"chara":[{"id":240000,"motion":200}]}],"group_24":[{"autoTurnFirst":2.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_31","textHome":"假货不可能敌得过新年的新生沙耶香的吧？…@…稍等一下……如果复制了我，那也就是说@，对面也是新生的！？"}]},{"autoTurnFirst":2.7,"chara":[{"id":240000,"motion":201}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":240000}]},{"autoTurnFirst":2.2,"chara":[{"id":240000,"motion":0}]},{"autoTurnFirst":3.0,"chara":[{"id":240000,"motion":400}]}],"group_25":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_32","textHome":"大家都干劲十足呢～！但是，果然不该穿着这@身衣服来的……珍贵的和服会变得脏兮兮的@吧……"}]},{"autoTurnFirst":0.6,"chara":[{"cheek":0,"face":"mtn_ex_040.exp.json","id":240000}]},{"autoTurnFirst":3.9,"chara":[{"id":240000,"motion":300}]},{"autoTurnFirst":3.0,"chara":[{"eyeClose":1,"id":240000}]}],"group_26":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":1,"pos":1,"voice":"vo_char_2400_00_33","textHome":"我今年想学点新东西，不过学什么好呢～……@啊，我想起来了……“学点新东西”是我去@年的抱负来着……"}]},{"autoTurnFirst":2.0,"chara":[{"id":240000,"motion":300}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":240000,"motion":0}]},{"autoTurnFirst":2.1,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":240000,"motion":100}]},{"autoTurnFirst":4.0,"chara":[{"cheek":1,"face":"mtn_ex_041.exp.json","id":240000}]}],"group_27":[{"autoTurnFirst":1.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":240000,"motion":201,"pos":1,"voice":"vo_char_2400_00_34","textHome":"喂，快点！我在对面发现了一家很隐蔽的店！@那家店没挂招牌就在打折！好了好了，不快@点的话其他客人也要来了！"}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000}]},{"autoTurnFirst":2.5,"chara":[{"id":240000,"motion":0}]},{"autoTurnFirst":4.7,"chara":[{"id":240000,"motion":400}]}],"group_28":[{"autoTurnFirst":4.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":1,"pos":1,"voice":"vo_char_2400_00_35","textHome":"我每年每年都想着去看新年日出，但最后还是@没去成。能不能干脆在电视上播一下啊？但@是，那样就没有那种感动了吗……"}]},{"autoTurnFirst":2.5,"chara":[{"id":240000,"motion":100}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_041.exp.json","id":240000,"motion":300}]}],"group_29":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_36","textHome":"你的红包钱都是怎么处理的？我全部都存起来@了哦。对于中学生来说，红包是贵重的财产@！不会交给任何人！"}]},{"autoTurnFirst":3.0,"chara":[{"id":240000,"motion":1}]},{"autoTurnFirst":4.5,"chara":[{"id":240000,"motion":100}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":240000,"motion":201}]}],"group_3":[{"autoTurnFirst":3.8,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":100,"pos":1,"voice":"vo_char_2400_00_03","textHome":"展示自己穿着晴着的样子……什么的，对我来@说太难了啦。"}]},{"autoTurnFirst":3.2,"chara":[{"eyeClose":1,"id":240000}]}],"group_30":[{"autoTurnFirst":4.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":100,"pos":1,"voice":"vo_char_2400_00_37","textHome":"这么说来，学校是几号开学来着……啊啊！抱@歉！！刚才那个是在享受新年的基础上绝对@不能问的问题吧……反省反省……"}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":240000,"motion":400}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":240000,"motion":300}]},{"autoTurnFirst":3.0,"chara":[{"eyeClose":1,"id":240000}]}],"group_31":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_38","textHome":"是不是因为新年到来了呢……感觉司空见惯的@见泷原也和之前看起来稍微有点不同……啊@，我在说什么羞耻的事情啊！快忘掉刚才的@话！"}]},{"autoTurnFirst":6.3,"chara":[{"id":240000,"motion":1}]},{"autoTurnFirst":3.6,"chara":[{"cheek":1,"face":"mtn_ex_050.exp.json","id":240000,"motion":400}]},{"autoTurnFirst":2.4,"chara":[{"cheek":1,"face":"mtn_ex_040.exp.json","id":240000,"motion":0}]}],"group_32":[{"autoTurnFirst":3.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":1,"pos":1,"voice":"vo_char_2400_00_39","textHome":"虽然我姑且给大家都寄了一份年贺状，但只有@杏子那家伙的住址我不知道啊……实在没办@法，我打算等会直接交给她！"}]},{"autoTurnFirst":3.4,"chara":[{"id":240000,"motion":100}]},{"autoTurnFirst":1.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0}]},{"autoTurnFirst":3.0,"chara":[{"id":240000,"motion":201}]}],"group_33":[{"autoTurnFirst":4.3,"chara":[{"cheek":1,"eyeClose":0,"face":"mtn_ex_040.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_40","textHome":"恭介那家伙，是不是很忙呢。虽然之前也在新@年的时候见过一面……去神社的时候，也连@着那家伙的份一起祈福吧！"}]},{"autoTurnFirst":3.8,"chara":[{"id":240000,"motion":300}]},{"autoTurnFirst":4.2,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":240000,"motion":100}]}],"group_34":[{"autoTurnFirst":6.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":240000,"motion":100,"pos":1,"voice":"vo_char_2400_00_41","textHome":"朋友之间的问候全都通过邮件解决这种做法，@我不是很喜欢啊。所以，我才像这样过来了@。今年也再次请你多多指教了哦？"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":201}]},{"autoTurnFirst":0.9,"chara":[{"id":240000,"motion":0}]},{"autoTurnFirst":1.6,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":240000}]}],"group_35":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":200,"pos":1,"voice":"vo_char_2400_00_42","textHome":"要是能取胜，肯定能度过美好的一年！"}]}],"group_36":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":100,"pos":1,"voice":"vo_char_2400_00_43","textHome":"要是在这里输掉，也太不吉利了呢！"}]}],"group_37":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":1,"pos":1,"voice":"vo_char_2400_00_44","textHome":"是让人想写下“完全胜利”四个大字的心情呢@！"}]}],"group_38":[{"autoTurnFirst":1.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_45","textHome":"好了，回去和大家一起悠闲一下吧！"}]},{"autoTurnFirst":0.8,"chara":[{"id":240000,"motion":400}]},{"autoTurnFirst":3.9,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":240000}]}],"group_39":[{"autoTurnFirst":1.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_46","textHome":"作为奖励，就用特制的小豆年糕汤来慰劳你吧@！"}]},{"autoTurnFirst":2.7,"chara":[{"id":240000,"motion":201}]}],"group_4":[{"autoTurnFirst":2.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":240000,"motion":300,"pos":1,"voice":"vo_char_2400_00_04","textHome":"说出自己的心声，为什么这么困难呢……"}]},{"autoTurnFirst":3.4,"chara":[{"eyeClose":1,"id":240000}]}],"group_5":[{"autoTurnFirst":2.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":0,"pos":1,"voice":"vo_char_2400_00_05","textHome":"如果大家都在，感觉我就能稍微打起一点勇气@向前迈进了啊。"}]},{"autoTurnFirst":3.2,"chara":[{"id":240000,"motion":201}]}],"group_6":[{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":240000,"motion":400,"pos":1,"voice":"vo_char_2400_00_13","textHome":"哦哦，感觉笔的手感变好了呢——！"}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":201}]}],"group_7":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":240000,"motion":200,"pos":1,"voice":"vo_char_2400_00_14","textHome":"感觉只要顺着这气势落下一笔，我就能写出自@信之作！"}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000}]}],"group_8":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":1,"pos":1,"voice":"vo_char_2400_00_15","textHome":"快听我说！新年伊始就有好事情发生了哦！"}]},{"autoTurnFirst":2.0,"chara":[{"id":240000,"motion":201}]}],"group_9":[{"autoTurnFirst":3.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":1,"pos":1,"voice":"vo_char_2400_00_16","textHome":"我感觉自己的状态特别好。所以，连抽福签都@用不着了！因为今天的我……不，今年的我@大概都会是状态上佳！"}]},{"autoTurnFirst":3.3,"chara":[{"id":240000,"motion":100}]},{"autoTurnFirst":1.1,"chara":[{"id":240000,"motion":0}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":240000}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":240000,"motion":200}]}]},"version":3}