st":6.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":220300,"motion":101}]}],"group_2":[{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220300,"motion":101,"pos":1,"tear":0,"voice":"vo_char_2203_00_02","textHome":"我是晓美焰。为什么会穿成这样，@连我自己也不清楚。@我正打算去查明原因。"}]},{"autoTurnFirst":2.2,"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":220300,"motion":300}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":220300}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":220300,"motion":200}]}],"group_20":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp3.json","id":220300,"motion":0,"pos":1,"tear":0,"voice":"vo_char_2203_00_27","textHome":"街上真安静。听说过年的时候，@许多人家都会回老家，@所以越是大城市，反而越显得人少、安静。"}]},{"autoTurnFirst":4.2,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":220300,"motion":1}]},{"autoTurnFirst":6.0,"chara":[{"id":220300,"motion":100}]}],"group_21":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_000.exp3.json","id":220300,"motion":100,"pos":1,"tear":0,"voice":"vo_char_2203_00_28","textHome":"晚安。本来想祝你做个好初梦，@不过，要是在梦里又睡着了，@会不会再做另一个梦呢？"}]},{"autoTurnFirst":3.3,"chara":[{"eyeClose":1,"id":220300,"motion":200}]},{"autoTurnFirst":0.4,"chara":[{"eyeClose":0,"id":220300}]},{"autoTurnFirst":7.0,"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":220300}]}],"group_22":[{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_051.exp3.json","id":220300,"motion":300,"pos":1,"tear":0,"voice":"vo_char_2203_00_29","textHome":"晴着要穿上好几层，意外地很暖和呢。@我还围着围巾、戴着手套，@所以并不觉得冷。"}]},{"autoTurnFirst":8.0,"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":220300,"motion":1}]}],"group_23":[{"autoTurnFirst":6.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp3.json","id":220300,"motion":1,"pos":1,"tear":0,"voice":"vo_char_2203_00_30","textHome":"虽然这个时期出门的人很多，@魔女却不管什么新年，照样四处蠢动。@稍有大意，就可能让许多人遭殃。"}]},{"autoTurnFirst":7.0,"chara":[{"i