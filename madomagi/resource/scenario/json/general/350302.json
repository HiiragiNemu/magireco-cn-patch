{"story":{"group_1":[{"autoTurnFirst":5.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":1,"motion":100,"pos":0,"voice":"vo_char_3503_00_01","textHome":"我们和菖蒲都来自一家叫“杜鹃之家”的福利院。@现在，我们三个人一起住在神滨。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":0,"motion":1,"pos":1,"voice":"vo_char_3503_00_01"}]},{"autoTurnFirst":2.7,"chara":[{"id":350300,"motion":1}]},{"autoTurnFirst":5.7,"chara":[{"id":350302,"lipSynch":1,"motion":200,"textHome":"嘛，正如你想的那样，生活里确实有不少不方便的地方，@不过，我们过得还算不错。@最近还开始接魔法少女的保镖工作了呢。"},{"id":350300,"lipSynch":0}]},{"autoTurnFirst":2.6,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302}]},{"autoTurnFirst":5.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302,"motion":1}]},{"autoTurnFirst":2.8,"chara":[{"id":350300,"lipSynch":1,"motion":200,"textHome":"有什么委托就联系我们吧。@只要有报酬，我们就接。"},{"id":350302,"lipSynch":0}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":0}]}],"group_10":[{"autoTurnFirst":5.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_17"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_00_17","textHome":"家规第二条：三个人要时刻心意相通。"}]},{"autoTurnFirst":5.0,"chara":[{"id":350300,"lipSynch":1,"textHome":"只要大家站在同样的立场看事情，@就能马上察觉谁有烦恼，也能帮忙解决。"},{"id":350302,"lipSynch":0,"motion":1}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":100}]}],"group_11":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_18"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_00_18","textHome":"家规第三条……啊，好像没有了吧。"}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":350302,"motion":300}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":350300,"lipSynch":1,"motion":300,"textHome":"是呢。不如规定大家一起洗澡，怎么样？"},{"id":350302,"lipSynch":0}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":100}]},{"autoTurnFirst":2.6,"chara":[{"id":350300,"lipSynch":0},{"cheek":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":0,"textHome":"浴室也越来越挤了，@一起洗澡这件事，差不多该毕业了吧。"}]},{"autoTurnFirst":4.0,"chara":[{"id":350302,"motion":100}]}],"group_12":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_19"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_00_19","textHome":"嗯，我们的配合也越来越有模有样了呢。"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":100}]}],"group_13":[{"autoTurnFirst":2.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":1,"pos":0,"voice":"vo_char_3503_00_20"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_00_20","textHome":"三个人背靠背作战的话，@就能消除死角了。"}]},{"autoTurnFirst":2.0,"chara":[{"id":350302,"motion":400}]}],"group_14":[{"autoTurnFirst":5.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_21"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_00_21","textHome":"成为魔法少女以后，我们就一直三个人相依为命。@所以彼此既是家人，也是战友。"}]},{"autoTurnFirst":2.5,"chara":[{"eyeClose":1,"id":350302,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":2.2,"chara":[{"id":350302,"motion":100}]},{"autoTurnFirst":1.1,"chara":[{"eyeClose":1,"id":350300,"lipSynch":1,"textHome":"嗯，是无可替代的存在。"},{"id":350302,"lipSynch":0,"motion":0}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350300}]},{"autoTurnFirst":2.0,"chara":[{"id":350300,"motion":200}]}],"group_15":[{"autoTurnFirst":6.9,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":1,"motion":300,"pos":0,"voice":"vo_char_3503_00_22","textHome":"直到现在，我们的目标都只是保住三个人的性命。@但今后，我也希望能守护菖蒲想要守护的东西。"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":0,"motion":0,"pos":1,"voice":"vo_char_3503_00_22"}]},{"autoTurnFirst":6.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":100}]},{"autoTurnFirst":3.5,"chara":[{"id":350302,"lipSynch":1,"motion":200,"textHome":"为此，我们想保持中立。@所以无论是谁来委托保镖工作，我们都打算接下。"},{"id":350300,"lipSynch":0,"motion":0}]},{"autoTurnFirst":5.0,"chara":[{"id":350302,"motion":1}]}],"group_16":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_23"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_00_23"}]},{"autoTurnFirst":2.8,"chara":[{"id":350302,"motion":300},{"id":350300,"lipSynch":0}]},{"autoTurnFirst":2.0,"chara":[{"id":350300,"lipSynch":1,"motion":300},{"id":350302,"lipSynch":0,"motion":1}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":4.1,"chara":[{"id":350300,"motion":0}]},{"autoTurnFirst":2.4,"chara":[{"id":350300,"motion":100}]},{"autoTurnFirst":1.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300}]},{"autoTurnFirst":5.8,"chara":[{"id":350300,"lipSynch":0},{"id":350302,"lipSynch":1,"motion":100}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":200}]}],"group_17":[{"autoTurnFirst":1.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":350302,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_02_24","textHome":"哦～今天也来了啊。@趁木叶和菖蒲不在的时候来，@难道有什么事只想委托我吗？@开玩笑的啦，开玩笑。"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302}]},{"autoTurnFirst":7.8,"chara":[{"id":350302,"motion":1}]},{"autoTurnFirst":2.1,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302}]},{"autoTurnFirst":3.0,"chara":[{"id":350302,"motion":100}]}],"group_18":[{"autoTurnFirst":8.5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_02_25","textHome":"啊……好困……不过今天轮到我值日，得早点起……@不，省掉早餐的话，还能再睡五分钟……@嗯，还能睡。好，继续睡吧……"}]},{"autoTurnFirst":7.5,"chara":[{"eyeClose":0,"id":350302,"motion":0}]},{"autoTurnFirst":2.9,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":350302}]},{"autoTurnFirst":1.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302}]},{"autoTurnFirst":2.0,"chara":[{"eyeClose":1,"id":350302,"motion":300}]}],"group_19":[{"autoTurnFirst":4.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_02_26","textHome":"好啦，差不多该午睡了。@上学的时候，我会在天台睡觉，@偶尔也会一不小心听见别人的谈话呢。"}]},{"autoTurnFirst":7.0,"chara":[{"id":350302,"motion":1}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302}]}],"group_2":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":350300,"lipSynch":0,"motion":0,"pos":0,"voice":"vo_char_3503_00_02"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_00_02","textHome":"你好呀～先做个自我介绍吧。我叫游佐叶月。"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302}]},{"autoTurnFirst":2.2,"chara":[{"id":350302,"motion":200}]},{"autoTurnFirst":2.4,"chara":[{"id":350302,"lipSynch":0},{"id":350300,"lipSynch":1,"motion":100,"textHome":"我是静海木叶。@我们和三栗菖蒲一起，三个人开始做保镖了。"}]},{"autoTurnFirst":4.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350300,"motion":0},{"id":350302,"motion":1}]},{"autoTurnFirst":3.0,"chara":[{"id":350300,"lipSynch":0},{"id":350302,"lipSynch":1,"motion":100,"textHome":"今后也请多多关照我们的生意哦～"}]}],"group_20":[{"autoTurnFirst":2.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_02_27","textHome":"等木叶买完东西回来，我得赶紧做好晚饭。@菖蒲肯定会饿着肚子回来，@我可不想让她多等一秒钟。"}]},{"autoTurnFirst":2.8,"chara":[{"id":350302,"motion":100}]},{"autoTurnFirst":4.1,"chara":[{"id":350302,"motion":300}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":1}]}],"group_21":[{"autoTurnFirst":5.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_02_28","textHome":"嗯～越来越清醒，睡不着啊。@大概是睡前一直玩手机的缘故，@不过，这也是收集情报的一部分，实在停不下来呢～"}]},{"autoTurnFirst":4.1,"chara":[{"id":350302,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"id":350302,"motion":200}]}],"group_22":[{"autoTurnFirst":0.9,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_02_29","textHome":"觉得累了的时候，干脆把事情都放下，休息一下吧？@稍微喘口气，也不会遭报应的哦？"}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":1.7,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302}]},{"autoTurnFirst":3.3,"chara":[{"id":350302,"motion":100}]},{"autoTurnFirst":1.9,"chara":[{"id":350302,"motion":1}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302}]}],"group_23":[{"autoTurnFirst":3.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350302,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_02_30","textHome":"嗯？魔女的气息。真是的，漫画正看到精彩的地方呢。@没办法，联系木叶和菖蒲，一起去消灭它吧。"}]},{"autoTurnFirst":5.2,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350302,"motion":1}]},{"autoTurnFirst":1.2,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":350302}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":4.0,"chara":[{"id":350302,"motion":200}]}],"group_24":[{"autoTurnFirst":5.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_02_31","textHome":"我不太想去调查镜屋敷呢～@毕竟打倒复制体，也拿不到悲叹之种。@不过，有委托的话就另说了。"}]},{"autoTurnFirst":5.4,"chara":[{"id":350302,"motion":300}]},{"autoTurnFirst":1.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"id":350302,"motion":100}]}],"group_25":[{"autoTurnFirst":8.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_02_32"}]},{"autoTurnFirst":3.7,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350302,"motion":200}]},{"autoTurnFirst":3.5,"chara":[{"id":350302,"motion":300}]}],"group_26":[{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":0,"pos":1,"voice":"vo_char_3503_02_33","textHome":"其实，我在学校参加了选举管理委员会。@只需要偶尔活动一下，@还能掌握同学之间的关系，很方便呢。"}]},{"autoTurnFirst":3.2,"chara":[{"id":350302,"motion":200}]},{"autoTurnFirst":4.8,"chara":[{"id":350302,"motion":1}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":100}]}],"group_27":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":350302,"lipSynch":1,"motion":400,"pos":1,"voice":"vo_char_3503_02_34","textHome":"哦？那家拉面店的队排得真长啊。@到底是什么让客人这么趋之若鹜呢？@看来非得去调查一下了。来，一起去吧？"}]},{"autoTurnFirst":3.1,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302,"motion":0}]},{"autoTurnFirst":3.6,"chara":[{"eyeClose":1,"id":350302,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":100}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302,"motion":200}]}],"group_28":[{"autoTurnFirst":1.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_02_35","textHome":"嗯？啊，你在意我用的应用吗？@这是能用AR测量物体长度的应用。@免费就能用，做木工的时候可帮大忙了。"}]},{"autoTurnFirst":5.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302}]},{"autoTurnFirst":4.9,"chara":[{"id":350302,"motion":100}]},{"autoTurnFirst":3.4,"chara":[{"id":350302,"motion":1}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302}]}],"group_29":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_02_36","textHome":"喂，往这个洞里看看吧。你猜里面有什么？@嘻嘻，什么也没有哦～吓到了？真可爱。@哈哈，只是个恶作剧，别生气嘛。"}]},{"autoTurnFirst":1.9,"chara":[{"id":350302,"motion":0}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302}]},{"autoTurnFirst":2.0,"chara":[{"id":350302,"motion":100}]},{"autoTurnFirst":2.1,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302}]},{"autoTurnFirst":1.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":400}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302,"motion":1}]}],"group_3":[{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":350300,"lipSynch":1,"motion":300,"pos":0,"voice":"vo_char_3503_00_03"},{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":0,"motion":1,"pos":1,"voice":"vo_char_3503_00_03"}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":350300}]},{"autoTurnFirst":3.5,"chara":[{"id":350300,"motion":0}]}],"group_30":[{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":200,"pos":1,"voice":"vo_char_3503_02_37","textHome":"菖蒲也十三岁了，@我觉得应该更加尊重她自己的意愿。@木叶应该也明白这一点。"}]},{"autoTurnFirst":6.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302,"motion":0}]},{"autoTurnFirst":1.5,"chara":[{"id":350302,"motion":300}]},{"autoTurnFirst":3.0,"chara":[{"eyeClose":1,"id":350302}]}],"group_31":[{"autoTurnFirst":7.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_02_38","textHome":"真要给木叶找个新的爱好，还挺不顺利的。@不过，大概也是因为，@我自己也没什么称得上爱好的事情吧。"}]},{"autoTurnFirst":4.0,"chara":[{"id":350302,"motion":300}]}],"group_32":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":350302,"lipSynch":1,"motion":300,"pos":1,"voice":"vo_char_3503_02_39","textHome":"我们能为过世的院长老师做的，@就是尽情欢笑，三个人一起，开朗而有精神地生活。@能献给院长的，也只有这些了。"}]},{"autoTurnFirst":3.0,"chara":[{"eyeClose":1,"id":350302}]},{"autoTurnFirst":1.3,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":350302,"motion":0}]},{"autoTurnFirst":4.1,"chara":[{"eyeClose":0,"id":350302}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":350302,"motion":100}]}],"group_33":[{"autoTurnFirst":5.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":350302,"lipSynch":1,"motion":1,"pos":1,"voice":"vo_char_3503_02_40","textHome":"就算有一天，我们三个人各自追求的幸福不再一样，@我也觉得没什么不好。@话虽如此，还是会寂寞，也还是想三个人在一起呢。"}]},{"autoTurnFirst":3.4,"chara":[{"id":350302,"motion":200}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":350302,"motion":300}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":350302,"motion":0}]}],"group_34":[{"autoTurnFirst":3.1,"chara":[{"cheek":1,"face":"mtn_ex_050.exp.json","id":350302,"motion":400,"pos":1,"voice":"vo_char_3503_02_41","textHome":"噫！小龙虾蜕下的壳！啊……抱歉，喊得那么大声……@菖蒲真是的，捡回来倒是没关系，@可要好好放进标本盒里啊……"}]},{"autoTurnFirst":1.1,"chara":[{"cheek":1,"face":"mtn_ex_030.exp.json","id":350302,"motion":0}]},{"autoTurnFirst":4.0,"chara":[{"id":350302,"motion":300}]},{"autoTurnFirst":3.3,"chara":[{"id":350302,"motion":0}]},{"autoTurnFirst":3.0,"chara":[{"eyeClose":1,"id":350302,"motion":200}]}],"group_35":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":350300,"lipSynch":1,"motion":200,"pos":0,"voice":"vo_char_3503_00_42","textHome