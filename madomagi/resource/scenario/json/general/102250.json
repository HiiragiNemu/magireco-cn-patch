{"story":{"group_1":[{"autoTurnFirst":7.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":1,"pos":1,"voice":"vo_char_1022_00_01","textHome":"如果，你是神滨的魔法少女的话，我必将手里@的佩剑染红。在你面前的是煌里光。PRO@MISED BLOOD引以为傲的三姐妹@的随从。顺便，你要不是神滨魔法少女的还@请早点告诉我。我得诚心诚意地向你道歉才@行。"}]},{"autoTurnFirst":2.5,"chara":[{"id":102200,"motion":100}]},{"autoTurnFirst":4.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":0}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":300}]},{"autoTurnFirst":3.2,"chara":[{"id":102200,"motion":200}]}],"group_10":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":100,"pos":1,"voice":"vo_char_1022_00_17","textHome":"但凡有什么感到困扰的事，请随时将我视作依@靠。辅助、支持所信赖的人，对我来说事不@会腻的"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":0}]},{"autoTurnFirst":2.5,"chara":[{"id":102200,"motion":200}]}],"group_11":[{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":1.4,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_00_18","textHome":"侍奉他人的喜悦。如今，我渐渐通过三姐妹感@受到了。如此，能够信赖的人变多，我感到@很幸福"}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":6.3,"chara":[{"id":102200,"motion":1}]},{"autoTurnFirst":2.0,"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":102200,"motion":100}]}],"group_12":[{"autoTurnFirst":0.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_00_19","textHome":"这样一来，光之部队或许会变得更多"}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":100}]}],"group_13":[{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_020.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_00_20","textHome":"我们会让这出复仇剧以good end结尾"}]},{"autoTurnFirst":0.6,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":2.0,"chara":[{"id":102200,"motion":200}]}],"group_14":[{"autoTurnFirst":4.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":100,"pos":1,"voice":"vo_char_1022_00_21","textHome":"这样一来，我就获得了能够守护珍视之人的力@量。要是以后能帮到二木市的所有魔法少女@就好了。"}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":0}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":200}]}],"group_15":[{"autoTurnFirst":4.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_00_22","textHome":"如果问我要服从到什么程度、奉献到什么程度@，我会毫不犹豫地回答，直到耗尽这条性命@。既然这条命不为了某个人便无法燃烧，那@我愿作为那个人最强的盾和矛，燃尽这条性@命"}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":1,"id":102200}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":2.0,"chara":[{"id":102200,"motion":100}]},{"autoTurnFirst":1.5,"chara":[{"eyeClose":1,"id":102200,"motion":300}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":3.5,"chara":[{"id":102200,"motion":0}]},{"autoTurnFirst":2.0,"chara":[{"id":102200,"motion":200}]}],"group_16":[{"autoTurnFirst":3.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_00_23","textHome":"即便自己所信赖的人走在了错误地道路上，我@也会和此人同行，做好奔赴死地的决心。当@然去纠正错误也当是我的义务，但仍不回头@的话，我会不论黑白地跟随的"}]},{"autoTurnFirst":4.0,"chara":[{"eyeClose":1,"id":102200,"motion":300}]},{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":5.2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":1}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":100}]}],"group_17":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":200,"pos":1,"voice":"vo_char_1022_50_24","textHome":"防晒霜，准备好了！保冷箱，准备好了！@为了结菜姐随时可能提出要去海边，@我得时刻做好万全准备才行！"}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200}]},{"autoTurnFirst":3.1,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":1}]},{"autoTurnFirst":3.7,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":100}]}],"group_18":[{"autoTurnFirst":3.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_50_25","textHome":"记得上小学时，要是第一节就是游泳课，@我就会很郁闷。光的头发很长，@还没完全弄干就得去上下一节课了。"}]},{"autoTurnFirst":2.4,"chara":[{"eyeClose":1,"id":102200,"motion":300}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":7.4,"chara":[{"id":102200,"motion":1}]}],"group_19":[{"autoTurnFirst":2.7,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":400,"pos":1,"voice":"vo_char_1022_50_26","textHome":"哎呀，真热啊。这个时间的太阳@亮得晃眼……不过，这种夏天到了的感觉，@倒也让人有点兴奋呢！"}]},{"autoTurnFirst":3.3,"chara":[{"eyeClose":1,"id":102200,"motion":1}]},{"autoTurnFirst":0.5,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":0.6,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200}]},{"autoTurnFirst":4.4,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":200}]}],"group_2":[{"autoTurnFirst":4.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_00_02","textHome":"把本煌里光叫出来，看样子你挺上道啊。要问@为什么的话，因为我从头到脚都是个随从。@需要任何支援都请交给我"}]},{"autoTurnFirst":2.2,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":200}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":100}]}],"group_20":[{"autoTurnFirst":5.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_50_27","textHome":"这个时间，阳光虽然柔和了，@空气还是湿乎乎的。我们的据点全是女生，@里面总有种女子更衣室般的气氛呢……"}]},{"autoTurnFirst":7.4,"chara":[{"eyeClose":1,"id":102200,"motion":300}]}],"group_21":[{"autoTurnFirst":3.1,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":102200,"motion":1,"pos":1,"voice":"vo_char_1022_50_28","textHome":"哈啊……游过泳的日子，@总是比平常还容易犯困……其他人好像也睡了，@光也稍微打个盹……啊，要替我保密哦……！"}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":5.4,"chara":[{"id":102200,"motion":0}]},{"autoTurnFirst":2.9,"chara":[{"cheek":0,"id":102200,"motion":300}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200}]},{"autoTurnFirst":3.8,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102200,"motion":400}]}],"group_22":[{"autoTurnFirst":4.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":1,"pos":1,"voice":"vo_char_1022_50_29","textHome":"好热，完全提不起劲……那个……@要不要一起懒洋洋地待着……？@只有光一个人偷懒的话，总有点内疚嘛～拜托了……！"}]},{"autoTurnFirst":4.1,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":0}]},{"autoTurnFirst":4.4,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":300}]},{"autoTurnFirst":2.3,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":200}]}],"group_23":[{"autoTurnFirst":1.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":102200,"motion":400,"pos":1,"voice":"vo_char_1022_50_30","textHome":"哇！魔、魔女？！@为什么偏偏在我穿成这样的时候来啊？！@呃、呃……得赶紧换衣服……！不对，直接变身就行了吧……？"}]},{"autoTurnFirst":2.5,"chara":[{"id":102200,"motion":200}]},{"autoTurnFirst":2.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":1}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102200,"motion":0}]}],"group_24":[{"autoTurnFirst":1.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_50_31","textHome":"听说无尽镜界里会出现@性格和自己相反的复制体，@那会不会出现不擅长游泳的光呢？"}]},{"autoTurnFirst":5.6,"chara":[{"id":102200,"motion":300}]},{"autoTurnFirst":4.3,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102200,"motion":200}]}],"group_25":[{"autoTurnFirst":3.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_50_32"}]},{"autoTurnFirst":3.4,"chara":[{"id":102200,"motion":400}]},{"autoTurnFirst":4.0,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":100}]}],"group_26":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":100,"pos":1,"voice":"vo_char_1022_50_33","textHome":"听说真正的马也很擅长游泳呢。@既然光也被叫作“马”，@在游泳这件事上可绝不能输！"}]},{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_020.exp.json","id":102200,"motion":0}]},{"autoTurnFirst":0.3,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":3.3,"chara":[{"id":102200,"motion":200}]}],"group_27":[{"autoTurnFirst":1.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":400,"pos":1,"voice":"vo_char_1022_50_34","textHome":"毛茸茸的小狗狗～……！@可是，天气这么热，连摸毛毛的心情都没有了……@不行，果然还是忍不住啦～！摸摸摸摸摸～！"}]},{"autoTurnFirst":3.6,"chara":[{"id":102200,"motion":0}]},{"autoTurnFirst":6.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":300}]},{"autoTurnFirst":3.0,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":200}]},{"autoTurnFirst":3.2,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":1}]}],"group_28":[{"autoTurnFirst":2.6,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":200,"pos":1,"voice":"vo_char_1022_50_35","textHome":"不、不妙……结菜姐让我买的冰淇淋，@我忘记放进冷冻室了……！@啊～……这下完蛋了……已经化成饮料了……"}]},{"autoTurnFirst":1.6,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":1}]},{"autoTurnFirst":4.5,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102200}]},{"autoTurnFirst":3.8,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":300}]},{"autoTurnFirst":2.8,"chara":[{"id":102200,"motion":0}]}],"group_29":[{"autoTurnFirst":2.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":1,"pos":1,"voice":"vo_char_1022_50_36","textHome":"我不讨厌游泳，可我们的人里面，@也就二姐肯陪我去……@要是方便的话，下次一起去游泳怎么样？"}]},{"autoTurnFirst":5.9,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":0}]},{"autoTurnFirst":3.7,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":200}]}],"group_3":[{"autoTurnFirst":0.1,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":0.8,"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp.json","id":102200,"motion":1,"pos":1,"voice":"vo_char_1022_00_03","textHome":"以前的我是对什么都很快会腻的那类"}]},{"autoTurnFirst":2.5,"chara":[{"eyeClose":0,"id":102200}]}],"group_30":[{"autoTurnFirst":3.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":200,"pos":1,"voice":"vo_char_1022_50_37","textHome":"大家花钱也太厉害了～！@就因为天气热，饮料、冰淇淋什么的就一大堆一大堆地买！@团队有再多经费也不够花啊！"}]},{"autoTurnFirst":4.1,"chara":[{"eyeClose":1,"id":102200,"motion":1}]},{"autoTurnFirst":0.2,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":4.3,"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102200,"motion":400}]}],"group_31":[{"autoTurnFirst":5.4,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":200,"pos":1,"voice":"vo_char_1022_50_38","textHome":"虽然是我自己说，不过光觉得@这种运动风泳装很适合自己。@但像青那样可爱的泳装，我也有一点点向往呢～"}]},{"autoTurnFirst":1.2,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":102200,"motion":0}]},{"autoTurnFirst":6.7,"chara":[{"id":102200,"motion":300}]}],"group_32":[{"autoTurnFirst":4.1,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":102200,"motion":400,"pos":1,"voice":"vo_char_1022_50_39","textHome":"不好了！结菜姐被热得不行了！@虽然没精神的结菜姐也有点可爱……@但我得赶紧准备冰淇淋才行！"}]},{"autoTurnFirst":3.0,"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":102200,"motion":300}]},{"autoTurnFirst":3.3,"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":100}]}],"group_33":[{"autoTurnFirst":3.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":1,"pos":1,"voice":"vo_char_1022_50_40","textHome":"以前学游泳没多久就放弃的时候，@我还为此讨厌过自己。可正因为那时学过，@现在才会游泳，也不算白费呢。"}]},{"autoTurnFirst":2.4,"chara":[{"eyeClose":1,"id":102200}]},{"autoTurnFirst":0.4,"chara":[{"eyeClose":0,"id":102200}]},{"autoTurnFirst":3.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":0}]},{"autoTurnFirst":2.7,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":200}]}],"group_34":[{"autoTurnFirst":1.8,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":200,"pos":1,"voice":"vo_char_1022_50_41","textHome":"说到夏天就是大海，说到大海就是青春！@今年的夏天只有一次。即使成了魔法少女，@也别忘了享受其中！一起创造最棒的回忆吧！"}]},{"autoTurnFirst":2.1,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":400}]},{"autoTurnFirst":2.4,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":0}]},{"autoTurnFirst":4.2,"chara":[{"id":102200,"motion":200}]},{"autoTurnFirst":2.8,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":100}]}],"group_35":[{"autoTurnFirst":2.2,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":200,"pos":1,"voice":"vo_char_1022_00_42","textHome":"就由我来破开道路！"}]}],"group_36":[{"autoTurnFirst":2.0,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":100,"pos":1,"voice":"vo_char_1022_00_43","textHome":"能帮到忙就最好不过了！"}]}],"group_37":[{"autoTurnFirst":1.5,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_00_44","textHome":"这支军队的威势，谁也无法阻挡！"}]},{"autoTurnFirst":2.2,"chara":[{"id":102200,"motion":200}]}],"group_38":[{"autoTurnFirst":1.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_00_45","textHome":"这是能被长女表扬的好结果呢！"}]},{"autoTurnFirst":1.8,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102200,"motion":100}]}],"group_39":[{"autoTurnFirst":1.3,"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":102200,"motion":0,"pos":1,"voice":"vo_char_1022_00_46","textHome":"所有的胜利都是为了我们二木的魔法少女！"}]},{"autoTurn