{"story":{"group_1":[{"autoTurnLast":0.3,"bg":"bg_adv_13141.jpg","bgm":"bgm23_tokime01","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305801,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":304701,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp.json","id":770200,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"autoTurnLast":2,"chara":[{"id":305801},{"id":304701},{"id":770200}],"turnChangeOut":"fadeOut"},{"autoTurnLast":0.3,"chara":[{"effect":"fadeout","id":305801},{"effect":"fadeout","id":304701},{"effect":"fadeout","id":770200}]},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":0,"pos":2}],"nameCenter":"静香","textCenter":"那么，今天就由我带大家看看，@在神滨生活会用到的地方吧。"},{"chara":[{"id":102501}],"nameCenter":"静香","textCenter":"像凉子和知花，@对神滨比我还要熟悉，"},{"chara":[{"id":102501}],"nameCenter":"静香","textCenter":"所以，要不要参加都随意……"},{"chara":[{"id":102501,"motion":100}],"nameCenter":"静香","textCenter":"不过，也算是增进彼此的了解，@大家愿意一起来的话，我会很高兴。"},{"autoTurnLast":0.3,"chara":[{"effect":"fadeout","id":102601},{"effect":"fadeout","id":102701},{"effect":"fadeout","id":102501}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305801,"motion":200,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":304701,"motion":0,"pos":2}],"nameLeft":"南津凉子","textLeft":"既然是为了增进感情，@那我可不能不参加啊。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":304701,"motion":100}],"nameRight":"青叶知花","textRight":"……是呢，@我也一起去。"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":304701},{"effect":"fadeout","id":305801}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":770200,"motion":100,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp.json","id":770201,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp.json","id":770202,"motion":0,"pos":2}],"nameLeft":"","textLeft":"我是从乡下来的，@有人带路真是帮大忙了。"},{"chara":[{"cheek":0,"id":770201,"motion":300,"pos":1}],"nameCenter":"","textCenter":"我也是……对城市里的事完全不懂。"},{"chara":[{"id":770202,"motion":400}],"nameRight":"","textRight":"大家一起逛街，@感觉很有意思呢！"},{"nameNarration":"","narration":"大家你一言我一语地聊着。","narrationEffect":"in"},{"autoTurnLast":0.3,"chara":[{"effect":"fadeout","id":770200},{"effect":"fadeout","id":770201},{"effect":"fadeout","id":770202}],"narrationEffect":"out","textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":100,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":0,"pos":2}],"nameLeft":"千春","textLeft":"好——大家看这边！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"pos":0}],"nameLeft":"千春","textLeft":"我来把静香做好的@神滨生活地图发给大家！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"有了这份地图，"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"至少刚来这段时间，@日常生活就不会有什么困难了。"},{"autoTurnLast":0.3,"bg":"bg_adv_13121.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story19","chara":[{"id":102501,"motion":100}],"nameCenter":"静香","textCenter":"这条水德商店街，@以后应该会经常来。","turnChangeOut":"fadeOut"},{"chara":[{"id":102501}],"nameCenter":"静香","textCenter":"我已经把比较常用的店铺@标在地图上了，"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501}],"nameCenter":"静香","textCenter":"大家找到喜欢的店，@也一定要告诉我哦。"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":102501}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":770200,"motion":400,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":770201,"motion":0,"pos":2}],"nameLeft":"","textLeft":"听说静香也刚来没多久，@没想到已经这么熟悉了……"},{"chara":[{"id":770201}],"nameRight":"","textRight":"是啊，@好厉害。"},{"autoTurnLast":0.3,"bg":"bg_adv_21041.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102701,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"衣服可以在这里买，@这里有各种各样的店。","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601}],"nameCenter":"千春","textCenter":"听说她和夏希一起来过，@我还吓了一跳呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":100}],"nameRight":"沙绪","textRight":"她现在来这种地方，@也不会怯场了呢。"},{"autoTurnLast":0.3,"bg":"bg_adv_21421.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":304701,"motion":1,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"累了的时候，@在这样的地方歇一歇也不错。","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":304701}],"nameRight":"青叶知花","textRight":"啊……@这个公园还是老样子呢……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305801,"motion":100,"pos":2}],"nameRight":"南津凉子","textRight":"看地图，这里就是最后一站了吧？"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"是的，@地图上的行程到这里就结束了。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"不过，我还想@带大家再去一个地方。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":305801,"motion":1,"pos":2}],"nameRight":"南津凉子","textRight":"嗯？"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"中央区的电波塔。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"虽然要坐电车过去，@不过我会带路的，不用担心。"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102501},{"effect":"fadeout","id":305801}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"motion":400,"mouthOpen":1,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102701,"motion":400,"mouthOpen":1,"pos":2}],"nameCenter":"千春&沙绪","textCenter":"咦！？"},{"autoTurnLast":0,"bg":"bg_adv_21061.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":770200,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"chara":[{"id":770200,"motion":300}],"nameRight":"","textRight":"那个……@我是第一次给卡充值……","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":200}],"nameLeft":"静香","textLeft":"没关系。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"一项一项慢慢来，@就能做到了。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"我们一起试试看吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":770200,"motion":0,"pos":2}],"nameRight":"","textRight":"好、好的……！"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":102501},{"effect":"fadeout","id":770200}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102701,"motion":0,"pos":2}],"nameLeft":"千春","textLeft":"静香居然在教别人充值……"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"真的在教呢……"},{"autoTurnLast":0.3,"bg":"bg_adv_14052.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":770200,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0}],"turnChangeIn":"fadeIn"},{"chara":[{"id":770200,"motion":300}],"nameRight":"","textRight":"那个……静香，@你也是刚来神滨不久吧？","turnChangeOut":"fadeOut"},{"chara":[{"id":770200,"motion":1}],"nameRight":"","textRight":"我听说，本家所在的村子，"},{"chara":[{"id":770200}],"nameRight":"","textRight":"比我长大的地方@还要偏僻呢……"},{"chara":[{"id":770200}],"nameRight":"","textRight":"你真厉害。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":300,"pos":0}],"nameLeft":"静香","textLeft":"因为有人教过我呀。"},{"chara":[{"eyeClose":1,"id":102501}],"nameLeft":"静香","textLeft":"就在不久前，@我还没办法独自坐电车呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":770201,"motion":400,"pos":2}],"nameRight":"","textRight":"咦……真的吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"真的。"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102501}],"nameLeft":"静香","textLeft":"有不懂的事情，@问问懂的人就好了。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"遇到困难时，@城里人也一样会伸出援手的。"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"不用因为这里是城市，@就害怕得不敢向前走哦。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":770201,"motion":0,"mouthOpen":1,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":770200,"motion":0,"mouthOpen":1,"pos":1}],"nameCenter":"","textCenter":"好！"},{"autoTurnLast":0.3,"chara":[{"effect":"fadeout","id":770200},{"effect":"fadeout","id":770201},{"effect":"fadeout","id":102501}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":770202,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":1,"pos":0}],"nameRight":"","textRight":"原来静香@是这么平易近人的人呀。"},{"chara":[{"id":770202,"pos":2}],"nameRight":"","textRight":"听说是本家的人，@我还以为会严肃得多呢——"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":304701,"motion":300,"pos":2}],"nameRight":"青叶知花","textRight":"我也稍微有点这样想过……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":100}],"nameLeft":"千春","textLeft":"啊哈哈。"},{"chara":[{"id":102601}],"nameLeft":"千春","textLeft":"确实，一听到“本家”，@难免会有点紧张呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":100,"pos":0}],"nameLeft":"沙绪","textLeft":"不过，她本人就是大家看到的这样。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305801,"motion":1,"pos":2}],"nameRight":"南津凉子","textRight":"她有时候@确实有点太好心了……"},{"chara":[{"id":305801,"pos":2}],"nameRight":"南津凉子","textRight":"但只要关键时刻能镇得住场面，@就没问题！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":305801,"motion":200}],"nameRight":"南津凉子","textRight":"我倒觉得，@她这个族长当得挺好的。"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305801},{"effect":"fadeout","id":102701}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":100,"pos":1}],"nameCenter":"静香","textCenter":"来，我们去观景台吧！"},{"autoTurnLast":1,"bg":"black","bgm":"stop","item":[{"path":"resource/scenario/img/51110_sizuka_training/memoria_1542.jpg","posX":0,"posY":0,"visible":"appear"}],"turnChangeIn":"fadeIn"},{"bgm":"bgm04_movie44","nameNarration":"","narration":"哇……好壮观！","narrationAnchor":"bottom","narrationCoverOpacity":110,"narrationEffect":"in","narrationFontSize":30,"narrationLineMargin":60,"narrationLineSpace":20,"turnChangeOut":"fadeOut"},{"narration":"人和房子都变得好小……"},{"nameNarration":"青叶知花","narration":"―知花―@……我真的回到神滨了啊……"},{"nameNarration":"南津凉子","narration":"―凉子―@哎呀，真是好久没来这里了。"},{"nameNarration":"南津凉子","narration":"―凉子―@从高处看下去的景色，@果然就是不一样啊。"},{"nameNarration":"千春","narration":"―千春―@能看见水德商店街呢！@水德寺……应该还是看不到吧？"},{"nameNarration":"沙绪","narration":"―沙绪―@能看见人们生活的模样呢。"},{"nameNarration":"静香","narration":"―静香―@是呀，这就是我想让大家看的。"},{"nameNarration":"静香","narration":"―静香―@从这里望见的人们的生活，@正是我们应当守护的东西。"},{"nameNarration":"千春","narration":"―千春―@是啊。"},{"nameNarration":"千春","narration":"―千春―@守护日出之国……@守护生活在这片土地上的人们。"},{"nameNarration":"沙绪","narration":"―沙绪―@这正是我们时女一族@肩负的使命，也是我们的骄傲……"},{"nameNarration":"静香","narration":"―静香―@是的，@虽然这条路并不轻松……"},{"nameNarration":"静香","narration":"―静香―@但我们时女一族一定要团结起来，@完成这份使命。"},{"nameNarration":"大家","narration":"―大家―@是！"},{"autoTurnLast":2,"item":[{"path":"resource/scenario/img/51110_sizuka_training/memoria_1542.jpg","visible":"hide"}],"narrationEffect":"out","turnChangeIn":"fadeIn"}]},"version":3}