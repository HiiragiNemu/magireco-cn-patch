{"story":{"group_1":[{"autoTurnLast":0.3,"bg":"bg_adv_13121.jpg","bgm":"bgm01_anime03","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"谢谢你帮我解围。","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"不过……@请问你是？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":400,"pos":2}],"nameRight":"空穗夏希","textRight":"啊！@抱歉，我还没自我介绍呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"我叫空穗夏希。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"是神滨魔法联盟的@魔法少女！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"魔法联盟的……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"是的！@你就是时女静香吧？"},{"chara":[{"id":102501,"pos":0}],"nameLeft":"静香","textLeft":"是我……@你怎么知道我的名字？"},{"chara":[{"id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"是彩羽告诉我们的……"},{"autoTurnLast":0.3,"bg":"bg_adv_narration.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":100101,"motion":0,"pos":1}],"narrationCoverOpacity":150,"turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"chara":[{"cheek":0,"id":100101,"motion":100,"pos":1}],"nameNarration":"彩羽","narration":"“我们已经决定和时女一族的大家@携手合作了，@她们遇到困难时，请大家帮帮忙。”","narrationEffect":"in","turnChangeOut":"fadeOut"},{"autoTurnLast":0.3,"bg":"bg_adv_13121.jpg","chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":1,"pos":0}],"narrationEffect":"out","turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"……联盟的大家@都收到了这样的消息。","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"她说，你们不熟悉城市里的生活，@可能会遇到些困难。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"环同学……"},{"chara":[{"id":300201,"motion":300}],"nameRight":"空穗夏希","textRight":"当时，我也看过@你们的照片。"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"我还担心自己会不会多管闲事，@不过，看你似乎很为难……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"怎么会，你可帮了我大忙。@谢谢你。"},{"chara":[{"id":300201,"motion":1}],"nameRight":"空穗夏希","textRight":"不用客气！@有困难，本来就该互相帮助嘛！"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"你有什么想去的地方吗？@我来给你带路吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":300,"pos":0}],"nameLeft":"静香","textLeft":"那当然再好不过了，不过……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":0,"pos":2}],"nameRight":"空穗夏希","textRight":"不过？"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"事情是这样的……"},{"autoTurnLast":1.5,"bg":"bg_adv_13121.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":1,"pos":0}],"turnChangeIn":"fadeIn"},{"bgm":"bgm01_anime02","chara":[{"id":300201,"motion":200}],"nameRight":"空穗夏希","textRight":"原来如此……@是想给要来神滨的同伴做一份地图呀。","turnChangeOut":"fadeOut"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"可是，这里的店铺实在太多了，"},{"chara":[{"id":102501,"motion":300}],"nameLeft":"静香","textLeft":"我都不知道@该怎么整理才好了……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"不介意的话，@我来给你推荐几家吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":400,"pos":0}],"nameLeft":"静香","textLeft":"咦……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"我从小就来@水德商店街买东西，"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"日常生活会用到的店铺，@应该都能带你去看看！"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"……可以吗？@会花不少时间哦？"},{"chara":[{"id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"没关系！@我今天也没有社团活动。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"谢谢你！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"那个，@我可以叫你空穗同学吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"nameRight":"空穗夏希","textRight":"不介意的话，@直接叫我夏希就好。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"那就叫你夏希吧。@你也叫我静香就好。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":200,"pos":2}],"nameRight":"空穗夏希","textRight":"好的，请多关照，@静香！"},{"autoTurnLast":1.5,"bg":"bg_adv_13121.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":1,"pos":0}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story19","chara":[{"id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"买鱼的话，我推荐这家！","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"这个店名是……@泊、泊瓦……？"},{"chara":[{"id":300201,"motion":1}],"nameRight":"空穗夏希","textRight":"是“泊瓦松·马尔谢”。"},{"chara":[{"id":102501,"motion":300}],"nameLeft":"静香","textLeft":"唔，这名字从来没听过，@还真不好记……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"那以后要是找不到这家店，@就问问商店街的人，"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"说“我想去鱼田先生的店”，@这样就行了。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"鱼田先生……？@是店主的名字吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":200}],"nameRight":"空穗夏希","textRight":"是的。这家店前不久@还叫“鱼田鱼店”，"},{"chara":[{"id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"商店街的人们@应该也更熟悉这个名字！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"原来如此……@我把这个也记下来。"},{"autoTurnLast":0.3,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0}],"turnChangeIn":"rollInFast"},{"bg":"bg_adv_13121.jpg","chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"日用品在这家店基本都能买齐。","turnChangeOut":"rollOutFast"},{"chara":[{"id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"啊，@买蔬菜的话，旁边这家就不错。"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"果然还是本地人熟悉这里呀。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"你的学校叫参京院，对吧？@我记得也在附近？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":0,"pos":2}],"nameRight":"空穗夏希","textRight":"就在那边哦。@要去看看吗？"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"也好。分家的孩子们中，@说不定也有人会去那里上学。"},{"autoTurnLast":0.5,"bg":"bg_adv_13051.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"学校原来这么大啊……","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"因为有很多学生在这里上学呀。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"这里也要记在地图上。"},{"autoTurnLast":0.3,"bg":"bg_adv_13121.jpg","chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"说起来，@这里应该不做以物易物的买卖吧？","turnChangeOut":"fadeOut"},{"chara":[{"id":300201,"motion":300}],"nameRight":"空穗夏希","textRight":"以物易物……@嗯，这里没有呢。"},{"chara":[{"id":300201,"motion":0}],"nameRight":"空穗夏希","textRight":"静香的家乡@现在还有吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1}],"nameLeft":"静香","textLeft":"直到不久前，@村里的人还很少外出，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"需要去外面买东西时，@都得靠村里管事的人。"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"他们从外面@带回来的东西，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"会分给村里的人，@大家再按各自的需要交换。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":301,"pos":2}],"nameRight":"空穗夏希","textRight":"这样啊……难怪你不习惯买东西，@确实会有些辛苦呢……"},{"chara":[{"id":102501,"motion":1}],"nameLeft":"静香","textLeft":"是呀。不过，@我很喜欢这条商店街。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"大家都很亲切，@让人觉得很温暖。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"分家的孩子们来到这里，@一定也会住得很舒心。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"听你这么说，@我也很高兴！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"啊，肉店@已经到了哦！"},{"autoTurnLast":0.3,"bg":"bg_adv_13121.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"rollInFast"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"我看看……买食物的地方有了，@日用品也没问题……","turnChangeOut":"rollOutFast"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"地图上的内容已经很丰富了呢。"},{"chara":[{"id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"接下来，就剩买衣服的地方了？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":1}],"nameLeft":"静香","textLeft":"是啊……@去哪家比较好呢？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":301,"pos":2}],"nameRight":"空穗夏希","textRight":"嗯……要在这条商店街里找，@就有点难了。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"这里没有卖衣服的店吗？"},{"chara":[{"id":300201,"motion":300}],"nameRight":"空穗夏希","textRight":"倒不是没有，@只是卖的都不太适合年轻人。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"大家买衣服，@一般都会去购物中心。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"购、购物中心……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"……啊，@就是有很多店铺的那个地方……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"能带我去看看吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"当然！@交给我吧！"},{"autoTurnLast":2,"turnChangeIn":"fadeIn"}]},"version":3}