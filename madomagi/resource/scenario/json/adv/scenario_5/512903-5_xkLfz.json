            {
                "bgm": "bgm05_event05",
                "nameNarration": "姬奈",
                "narration": "―姬奈―@那就是说，时雨儿成为魔法少女之后@在班级里也没发生变化",
                "narrationAnchor": "bottom",
                "narrationCoverOpacity": 110,
                "narrationEffect": "in",
                "narrationFontSize": 30,
                "narrationLineMargin": 10,
                "narrationLineSpace": 20,
                "turnChangeOut": "fadeOut"
            },
            {
                "nameNarration": "时雨",
                "narration": "―时雨―@嗯…"
            },
            {
                "narration": "―时雨―@尽管有一个像蓝家小姐一样的同班同学@我从魔女手中救了她，但也什么都没改变…"
            },
            {
                "narration": "―时雨―@我一直都呆在班级的角落里@被人不知道在哪里说三道四"
            },
            {
                "narration": "―时雨―@明明在保护着大家@谁也不会说一句真厉害啊之类的…"
            },
            {
                "nameNarration": "姬奈",
                "narration": "―姬奈―@于是，就宣扬起魔法少女至上主义@希望大家知道自己有多厉害"
            },
            {
                "nameNarration": "时雨",
                "narration": "―时雨―@嗯…这个也是…"
            },
            {
                "narration": "―时雨―@这样一来我喜欢一个人呆着就呆着@也不会被人瞧不起了…"
            },
            {
                "nameNarration": "姬奈",
                "narration": "―姬奈―@育梦儿也是？"
            },
            {
                "nameNarration": "育梦",
                "narration": "―育梦―@我是因为自己的性格的缘故了…"
            },
            {
                "narration": "―育梦―@从以前开始就是非常冒失@总是在失败，一直在被人嘲笑…"
            },
            {
                "narration": "―育梦―@但是，即便是这样的我也在保护着大家"
            },
            {
                "narration": "―育梦―@就算只是让大家知道这个@被欺负的也会更少吧…"
            },
            {
                "narration": "―育梦―@在这时，我们从灯花大人和音梦大人那里@听闻了魔法少女至上主义的思想"
            },
            {
                "narration": "―育梦―@我就想如果能让所有人都了解的话@自己的价值也就能得到证明了…"
            },
            {
                "nameNarration": "姬奈",
                "narration": "―姬奈―@那时就是@真正的Neo-Magius的开端呢"
            },
            {
                "narration": "―姬奈―@呼呼…感觉有些心跳加速了呢@像是共情了的感觉一样？"
            },
            {
                "nameNarration": "育梦",
                "narration": "―育梦―@我还没有这样的感觉@所以下面，请蓝家小姐来说了"
            },
            {
                "nameNarration": "时雨",
                "narration": "―时雨―@嗯，为什么对Neo-Magius@和魔法少女至上主义感兴趣呢？"
            },
            {
                "narration": "―时雨―@还有，男票君的事情也是…"
            },
            {
                "nameNarration": "姬奈",
                "narration": "―姬奈―@是呀，只是人家一个人在那热情高涨@也太冷了点"
            },
            {
                "narration": "―姬奈―@…………"
            },
            {
                "narration": "―姬奈―@说穿了吧，人家感兴趣的原因其实是@想要进行自由的恋爱"
            },
            {
                "nameNarration": "育梦",
                "narration": "―育梦―@自由的恋爱？"
            },
            {
                "nameNarration": "姬奈",
                "narration": "―姬奈―@对，人家和男票的彦君是青梅竹马@但两个人的角色差异简直太大了"
            },
            {
                "narration": "―姬奈―@人家是在年级里面非常瞩目的人@呆在整天吵闹嬉笑的团体中"
            },
            {
                "narration": "―姬奈―@彦君则是阴暗角色，该说完全就是独行侠了@总是一个人呆在那儿呢"
            },
            {
                "narration": "―姬奈―@所以，就像是所谓的身份有别的恋爱？@这样的东西"
            },
            {
                "narration": "―姬奈―@人家从很小的时候开始@就非常喜欢头脑很好的彦君"
            },
            {
                "narration": "―姬奈―@我们对大家保密着@偷偷地交往着…"
            },
            {
                "narration": "―姬奈―@当然，成了女朋友之后@是打算去帮助彦君的…"
            },
            {
                "narration": "―姬奈―@但是，和现在不同，没有彦君的人家@头脑完全不好呀…"
            },
            {
                "narration": "―姬奈―@做什么事情都做不好…"
            },
            {
                "narration": "―姬奈―@一想去帮助彦君@大家的目光就变得冷而恐怖…"
            },
            {
                "narration": "―姬奈―@彦君也不想被帮助@所以到头来，还是悄悄地交往着…"
            },
            {
                "narration": "―姬奈―@但是，这种事情藏不住的…"
            },
            {
                "narration": "―姬奈―@在那之后…"
            },
            {
                "nameNarration": "时雨",
                "narration": "―时雨―@…………"
            },
            {
                "nameNarration": "姬奈",
                "narration": "―姬奈―@彦君什么都不说@所以人家完全没能发觉到…"
            },
            {
                "narration": "―姬奈―@当时的自己怎么就没察觉到呢…"
            },
            {
                "narration": "―姬奈―@在那之后…"
            },
            {
                "nameNarration": "育梦",
                "narration": "―育梦―@…………"
            },
            {
                "nameNarration": "姬奈",
                "narration": "―姬奈―@然后…嗯…"
            },
            {
                "nameNarration": "时雨",
                "narration": "―时雨―@不用勉强自己说出来也好的…"
            },
            {
                "nameNarration": "姬奈",
                "narration": "―姬奈―@彦君就只存于我之中了…"
            },
            {
                "narration": "―姬奈―@对不起…"
            },
            {
                "nameNarration": "时雨",
                "narration": "―时雨―@没有的事…我明白为什么蓝家小姐说@不会背叛我们了…"
            },
            {
                "nameNarration": "育梦",
                "narration": "―育梦―@嗯，已经传达到了所以不用勉强自己了…"
            },
            {
                "nameNarration": "姬奈",
                "narration": "―姬奈―@人家想要到达真正的顶点…"
            },
            {
                "narration": "―ひめな―@[textYellow:キモチ]の石を手に入れて@自動浄化システムを手に入れて"
            },
            {
                "narration": "―姬奈―@成为连魔法少女都无法违抗的存在@都是为了自由的恋爱…！"
            },
            {
                "narration": "―姬奈―@希望即使说出自己和彦君现在的关系@也不会被人当傻子看…！"
            },
