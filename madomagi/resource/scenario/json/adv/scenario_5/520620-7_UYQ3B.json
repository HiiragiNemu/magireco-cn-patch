      {
        "chara": [
          {
            "eyeClose": 0,
            "id": 300400,
            "motion": 0
          }
        ],
        "nameLeft": "美凪纱纱罗",
        "textLeft": "目的则是作为骑士@作为魔法少女守护大家"
      },
      {
        "chara": [
          {
            "id": 300400
          }
        ],
        "nameLeft": "美凪纱纱罗",
