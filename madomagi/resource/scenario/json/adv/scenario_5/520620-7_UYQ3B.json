      {
        "chara": [
          {
            "eyeClose": 1,
            "id": 300400,
            "motion": 300
          }
        ],
        "nameLeft": "美凪纱纱罗",
        "textLeft": "…我的正确则是阻止明日香@以勉强自己的方式战斗"
