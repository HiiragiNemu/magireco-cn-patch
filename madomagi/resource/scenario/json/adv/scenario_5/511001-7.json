":"mtn_ex_020.exp.json","id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"（那、我也……！）"},{"chara":[{"id":102501,"motion":200}],"nameCenter":"静香","textCenter":"不、不好意思……！@我要下车！请让我过去！"},{"autoTurnLast":0.3,"bg":"bg_adv_21701.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"motion":300}],"nameCenter":"静香","surround":"7008_station","textCenter":"终、终于下来了……","turnChangeOut":"fadeOut"},{"autoTurnLast":1.5,"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":0,"pos":0}],"surround":"stop","turnChangeIn":"fadeIn"},{"bgm":"bgm01_anime02","chara":[{"id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"静香！","turnChangeOut":"fadeOut"},{"chara":[{"id":102501,"motion":300}],"nameLeft":"静香","textLeft":"夏希！@对不起！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"没关系，@你没事就好！"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"好了，既然顺利会合了，@我们就去电波塔吧！"},{"chara":[{"eyeClose":1,"id":102501}],"nameLeft":"静香","textLeft":"……嗯。"},{"chara":[{"eyeClose":0,"id":102501,"motion":1}],"nameLeft":"静香","textLeft":"那个……我们要再坐一次电车，@回到刚才那一站吗？"},{"chara":[{"id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"不用，只差一站，我们走过去吧！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"咦，原来走路也能到啊……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"这一带的车站隔得很近哦。"},{"autoTurnLast":0.3,"bg":"bg_adv_14041.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"……夏希，@你对中央区也很熟悉呀。","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201}],"nameRight":"空穗夏希","textRight":"我倒是常来玩，@不过谈不上熟悉哦？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"可是，这些路看着都差不多，@你却一点都没犹豫呀。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":200,"pos":2}],"nameRight":"空穗夏希","textRight":"因为我在看@手机里的地图应用！"},{"chara":[{"id":102501,"motion":400}],"nameLeft":"静香","textLeft":"这块板子里，居然还有地图！？"},{"chara":[{"id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"有呀，静香的手机里也有……"},{"chara":[{"id":300201,"motion":1}],"nameRight":"空穗夏希","textRight":"能把你的手机@借我看一下吗？"},{"chara":[{"id":102501,"motion":1}],"nameLeft":"静香","textLeft":"嗯、嗯……"},{"chara":[{"id":300201,"motion":0}],"nameRight":"空穗夏希","textRight":"打开这个应用，@再输入想去的地方……"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"这个箭头在动呢……"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"这里就是我们现在的位置。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201}],"nameRight":"空穗夏希","textRight":"点一下“开始导航”，@它就会带我们到目的地了。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":300,"pos":0}],"nameLeft":"静香","textLeft":"……这、这样啊。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"难得有机会，要不要试着@跟着导航在街上走一走？"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"……我试试看。"},{"autoTurnLast":1,"bg":"bg_adv_14052.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"“目的地在您的左侧。@本次导航结束。”","narrationEffect":"in","turnChangeOut":"fadeOut"},{"chara":[{"id":102501}],"nameLeft":"静香","narrationEffect":"out","textLeft":"……咦？@啊，到了……？"},{"chara":[{"id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"对，这里就是电波塔！"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":300,"pos":0}],"nameLeft":"静香","textLeft":"我从头到尾@都没弄明白是怎么回事……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":300,"pos":2}],"nameRight":"空穗夏希","textRight":"刚才好几次，你不是差点提前拐弯，@就是差点走过了呢……"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"可是，这些路看着都一样呀。"},{"chara":[{"cheek":0,"id":102501}],"nameLeft":"静香","textLeft":"突然来一句“前面转弯”，@我也不知道该在哪里转呀……"},{"chara":[{"eyeClose":1,"id":300201}],"nameRight":"空穗夏希","textRight":"嗯……"},{"chara":[{"eyeClose":0,"id":300201}],"nameRight":"空穗夏希","textRight":"那和分家的大家一起来时，@不要紧吗……？"},{"chara":[{"id":102501,"motion":1}],"nameLeft":"静香","textLeft":"……到时候就拜托其他同伴吧。@她们比我熟悉多了……"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"穿过街区的时候，@我也会好好跟着小千和沙绪的……"},{"autoTurnLast":1,"bg":"bg_adv_14061.jpg","bgm":"stop","chara":[{"cheek":1,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"bgm":"bgm01_anime03","chara":[{"id":102501}],"nameLeft":"静香","textLeft":"……哇……好壮观。@真的像听说的那样，整座城市都看得见……","turnChangeOut":"fadeOut"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"能看到水德寺吗？"},{"chara":[{"id":300201,"motion":300}],"nameRight":"空穗夏希","textRight":"水德商店街大概在那一带，@应该就在附近吧……"},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"说不定是那里……！@不过只是凭感觉猜的。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":0,"pos":2}],"nameRight":"空穗夏希","textRight":"呵呵，@但愿猜对了呢。"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":102501,"lipSynch":0}],"nameLeft":"静香","textLeft":"…………"},{"chara":[{"eyeClose":0,"id":102501}],"nameLeft":"静香","textLeft":"果然，我还是想让@分家的孩子们也看看。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"这就是我们巫应当守护的，@日出之国的人们的生活……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"你刚才也这么说过呢。"},{"chara":[{"id":102501,"motion":1}],"nameLeft":"静香","textLeft":"是呀，@因为这是一族的骄傲。"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"骄傲……？"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_001.exp.json","id":102501}],"nameLeft":"静香","textLeft":"不是为了实现自己的愿望，@而是为了生活在日出之国的人们战斗。"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102501}],"nameLeft":"静香","textLeft":"这就是我们时女一族。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":301}],"nameRight":"空穗夏希","textRight":"……那个，听起来有点难懂呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":200}],"nameLeft":"静香","textLeft":"神滨才刚遭受过灾害，@可人们依然珍惜着每一天的生活。"},{"chara":[{"eyeClose":1,"id":102501}],"nameLeft":"静香","textLeft":"能够守护这些平凡的日常，@才算得上真正的巫……"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":100}],"nameLeft":"静香","textLeft":"也就是真正的魔法少女，你不觉得吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"啊，原来如此……@这么说，我就明白了。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"也就是想帮助大家，对吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"所以，我才想让@分家的孩子们也来看看。"},{"chara":[{"eyeClose":1,"id":102501}],"nameLeft":"静香","textLeft":"因为在这里，@能看到我们应当守护的景象。"},{"autoTurnLast":1,"bg":"bg_adv_21702.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story02","chara":[{"id":102501,"motion":300}],"nameLeft":"静香","textLeft":"……呼……@果然还是不行……","turnChangeOut":"fadeOut"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"要是没有夏希，@我恐怕都走不出中央区了……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":300,"pos":2}],"nameRight":"空穗夏希","textRight":"会不会太夸张了呀？"},{"nameNarration":"","narration":"“列车即将进站……”","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","narrationEffect":"out","textRight":"啊，电车来了！"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"这个时间人也很多，@不要松开我的手哦。"},{"chara":[{"id":102501,"motion":1}],"nameLeft":"静香","textLeft":"嗯……@你可是我的救命稻草啊……"},{"autoTurnLast":1,"bg":"bg_adv_13133.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"谢谢你送我回来。","turnChangeOut":"fadeOut"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"连坐电车也一直让你带着我，@真是帮了我大忙。"},{"chara":[{"id":300201,"motion":200}],"nameRight":"空穗夏希","textRight":"不介意的话，交流赛那天，@我也来接你吧！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"谢谢你！@我很期待那天的比赛！"},{"autoTurnLast":2,"turnChangeIn":"fadeIn"}]},"version":3}