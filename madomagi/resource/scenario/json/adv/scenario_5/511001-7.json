{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_21631.jpg","bgm":"bgm03_story08","chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":1,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp.json","id":800900,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":801000,"motion":1,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"…………","turnChangeOut":"fadeOut"},{"nameNarration":"","narration":"“神滨市站，神滨市站到了。@感谢您的乘坐，@请注意不要遗忘随身物品。”","narrationEffect":"in"},{"chara":[{"id":102501,"lipSynch":0,"motion":200},{"id":800900},{"id":801000}],"nameCenter":"静香","narrationEffect":"out","textCenter":"（好、好的……@这次可不能再被挤回去了……！）"},{"autoTurnLast":1,"chara":[{"effect":"slideOutRight","id":800900},{"effect":"slideOutRight","id":801000},{"effect":"shake","id":102501}],"textClear":1},{"chara":[{"id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"（跟、跟着下车的人一起走……）"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"lipSynch":0},{"cheek":0,"effect":"slideInRight","face":"mtn_ex_010.exp.json","id":801100,"motion":0,"pos":0},{"cheek":0,"effect":"slideInRight","face":"mtn_ex_010.exp.json","id":800100,"motion":0,"pos":2}],"nameCenter":"静香","textCenter":"[chara:102501:effect_emotion_surprise_0][se:7226_shock]——！？"},{"chara":[{"id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"（咦！？@已经有人上来了！）"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"lipSynch":0,"motion":1}],"nameCenter":"静香","textCenter":"（这样下去，@又要下不了车了。）"},{"chara":[{"id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"（而且，上车的人@比刚才还多……！）"},{"chara":[{"id":102501,"lipSynch":0,"motion":300}],"nameCenter":"静香","textCenter":"（就想这样去最繁华的中央区，@对我来说，果然还是太早了吗……）"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_001.exp.json","id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"（可是……）"},{"autoTurnLast":1,"bg":"bg_adv_21421.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"