{"story":{"group_1":[{"autoTurnLast":0.3,"bg":"bg_adv_21421.jpg","bgm":"bgm01_anime02","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"呼……","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"eyeClose":0,"id":102501}],"nameLeft":"静香","textLeft":"原来神滨也有@这么安静的地方啊……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"这里还喜欢吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"嗯。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"果然还是绿树多、@又安静的地方，让人安心。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"大家一定@也会喜欢这里……"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"得把这里也@标在地图上才行。"},{"chara":[{"id":300201,"motion":0}],"nameRight":"空穗夏希","textRight":"好呀！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":400,"pos":2}],"nameRight":"空穗夏希","textRight":"啊，快吃鲷鱼烧吧！@刚烤好的，再放就要凉了。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"对哦，@难得买了热乎乎的呢……！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"我开动了。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"nameRight":"空穗夏希","textRight":"嗯，我也开动了！"},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"……真好吃。@累了的时候，甜食真是让人舒坦……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"你喜欢就好。@我有时会在社团活动后买来吃。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"社团活动……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"你感兴趣吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"嗯，我长大的地方孩子很少，@所以没有这样的活动……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":300,"pos":2}],"nameRight":"空穗夏希","textRight":"啊，也是……@人太少的话，确实办不起来呢。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"夏希，@你参加的是什么社团？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"我是棒球部的经理，@还兼任啦啦队员！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":300,"pos":0}],"nameLeft":"静香","textLeft":"经理？@啦啦队员？"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"就是帮棒球队员们练习，@再在比赛时给他们加油！"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"比赛……"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"会有很多年纪相仿的孩子，@聚在一起，对吧？"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"听起来好热闹……"},{"chara":[{"id":300201,"motion":0}],"nameRight":"空穗夏希","textRight":"可热闹了！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":200,"pos":2}],"nameRight":"空穗夏希","textBg":"shout","textRight":"冲呀！加油！必胜！！"},{"chara":[{"id":102501,"lipSynch":0,"motion":400}],"nameLeft":"静香","textLeft":"[chara:102501:effect_emotion_surprise_0][se:7226_shock]——！？"},{"chara":[{"id":300201,"motion":1}],"nameRight":"空穗夏希","textRight":"我们会像这样放开嗓子加油，@还会挂起一代代传下来的横幅。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"这样啊……@我有点想去看看了。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":200,"pos":2}],"nameRight":"空穗夏希","textRight":"那要不要来看比赛？"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"这周末，中央区的河滩球场@正好有一场交流赛。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"我也能去吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"当然！@一定要来哦！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"谢谢你！@我会把那天的时间空出来。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"nameRight":"空穗夏希","textRight":"啊，对了，@我们交换一下联系方式吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"好呀！"},{"autoTurnLast":1.5,"bg":"bg_adv_21421.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story02","chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"原来你会在河里钓鱼啊……","turnChangeOut":"fadeOut"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"我还挺拿手的哦。"},{"chara":[{"id":102501,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201}],"nameLeft":"静香","textLeft":"有机会来我们村子的话，@我可以教你。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"不过，离这里有点远……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"现在村子也在发展观光，@正努力让那里热闹起来呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"真不错……！@感觉能悠闲地过上一天！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"对吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":300,"pos":0}],"nameLeft":"静香","textLeft":"……啊，都这个时间了。@不知不觉休息得太久了呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":0,"pos":2}],"nameRight":"空穗夏希","textRight":"啊，真的呢……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"你还有什么@想去的地方吗？"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_001.exp.json","id":102501,"lipSynch":0}],"nameLeft":"静香","textLeft":"…………"},{"chara":[{"eyeClose":0,"id":102501,"motion":0}],"nameLeft":"静香","textLeft":"地图上的内容已经够了……@不过，我还想再去一个地方……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"能陪我去一趟@“电波塔”吗？"},{"chara":[{"id":300201,"motion":200}],"nameRight":"空穗夏希","textRight":"电波塔的话……@是在中央区呢。"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"是呀，@电波塔上有观景台，对吧？"},{"chara":[{"eyeClose":1,"id":102501}],"nameLeft":"静香","textLeft":"我想带大家从那里看看，@我们应当守护的人们的生活。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":0,"pos":2}],"nameRight":"空穗夏希","textRight":"应当守护……？"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":300,"pos":0}],"nameLeft":"静香","textLeft":"可是……"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"中央区是神滨最繁华的地方，@我实在没把握顺利穿过去……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":301,"pos":2}],"nameRight":"空穗夏希","textRight":"原、原来如此……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"既然这样，@那就让我来带路吧！"},{"autoTurnLast":2,"turnChangeIn":"fadeIn"}]},"version":3}