{"story":{"group_1":[{"autoTurnLast":0.3,"bg":"bg_adv_21041.jpg","bgm":"bgm03_story19","chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"荣区的购物中心就很大了，@没想到这里也有这么多店……","turnChangeOut":"fadeOut"},{"chara":[{"id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"这里有导览册哦！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"我们看看这个，@再决定去逛哪些店吧！"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"导览册……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"哎呀，这不是已经有地图了吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"不过，上面基本只写了@店铺的名字和位置，"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"再补上各家店的风格，@大家用起来就更方便了！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"风格……？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":200,"pos":2}],"nameRight":"空穗夏希","textRight":"比如可爱风、运动风，@还有辣妹风之类的……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"每家店卖的衣服，@风格都不一样！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"原来如此。"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"那我们就@一家家看看吧。"},{"chara":[{"id":300201,"motion":0}],"nameRight":"空穗夏希","textRight":"好呀！@先从二楼开始逛吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"嗯。"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":300201}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"lipSynch":0,"motion":200,"pos":1}],"nameCenter":"静香","textCenter":"（跟着夏希，@站上会动的楼梯就好了吧。）"},{"chara":[{"id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"…………@…………"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"lipSynch":0,"motion":0}],"nameCenter":"静香","textCenter":"（……不会吧。）"},{"chara":[{"id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"（看她上去明明那么轻松，@可我根本不知道该什么时候迈脚呀。）"},{"autoTurnLast":0.2,"chara":[{"id":102501,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":800600,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":801200,"motion":0,"pos":1}],"nameRight":"","textRight":"那个……@你不上去吗？"},{"chara":[{"id":102501,"motion":400,"pos":0}],"nameLeft":"静香","textLeft":"咦，啊……对不起。@请、请你先上去吧……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":801200,"pos":1}],"nameCenter":"","textCenter":"大姐姐，你不会坐这个吗？"},{"chara":[{"id":102501,"motion":300}],"nameLeft":"静香","textLeft":"呃，那个……是呀。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":801200,"pos":1}],"nameCenter":"","textCenter":"我也不会哦。"},{"chara":[{"id":801200}],"nameCenter":"","textCenter":"不过，只要牵着妈妈的手，@喊声“一、二”，就能上去了！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"原来如此……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"lipSynch":0}],"nameLeft":"静香","textLeft":"（可是，总不能麻烦@不认识的人陪我这样做……）","turnEffect":"thinking"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":801200},{"effect":"fadeout","id":800600}],"textClear":1,"turnEffect":"stop"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"静香……！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"夏希……！@你回来接我了呀。"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"不好意思，@能牵着我的手，陪我喊声“一、二”吗……！"},{"chara":[{"id":300201,"motion":300}],"nameRight":"空穗夏希","textRight":"牵着手，喊“一、二”？"},{"autoTurnLast":0.3,"bg":"bg_adv_21401.jpg","chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":801200,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp.json","id":800600,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"谢谢你，@多亏了你，我才顺利上来了。","turnChangeOut":"fadeOut"},{"chara":[{"id":801200}],"nameCenter":"","textCenter":"不客气。@太好啦，大姐姐！"},{"autoTurnLast":1,"chara":[{"effect":"fadeout","id":801200},{"effect":"fadeout","id":800600}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"nameLeft":"静香","textLeft":"还有夏希，也给你添麻烦了。"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"哪里哪里。@大家第一次都是这样的。"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"我得在导览册上写好，@坐自动扶梯的时候，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"要牵着会坐的人的手，@喊声“一、二”再上去。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":300}],"nameRight":"空穗夏希","textRight":"啊哈哈……"},{"autoTurnLast":1,"bg":"bg_adv_21411.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":801000,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":1,"pos":0}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story01","chara":[{"id":801000}],"nameRight":"","textRight":"说到最近的流行趋势，@那就是条纹款啦～","turnChangeOut":"fadeOut"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"流、流行趋势……？"},{"chara":[{"id":801000}],"nameRight":"","textRight":"小姐，你身材这么好，@修身款穿着也一定很合适。"},{"chara":[{"id":801000}],"nameRight":"","textRight":"啊！不过不过，@这边这条连衣裙说不定也不错！"},{"chara":[{"id":801000}],"nameRight":"","textRight":"最近也很流行粉彩色，@再搭上一件大一点的配饰……"},{"chara":[{"id":801000}],"nameRight":"","textRight":"你看！@是不是很好看呀？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":300,"pos":0}],"nameLeft":"静香","textLeft":"啊，是、是吗……"},{"chara":[{"id":102501},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"nameLeft":"静香","surround":"7202_telepathy","textLeft":"怎、怎么办……@拿来的衣服越来越多了……","turnEffect":"ef_adv_02"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"而且，她说的那些，@我也不太听得懂……"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"这些都必须买下来吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":400,"pos":2}],"nameRight":"空穗夏希","textRight":"不用的哦。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"pos":2}],"nameRight":"空穗夏希","textRight":"她只是给你一些搭配上的……@嗯，就是一些建议。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"看中了喜欢的，@再买下来就行了！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":400,"pos":0}],"nameLeft":"静香","textLeft":"原、原来如此……@这个也得记下来……"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300201}],"surround":"stop","textClear":1,"turnEffect":"stop"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":801000,"motion":0,"pos":2}],"nameLeft":"静香","textLeft":"那个，那就……"},{"chara":[{"id":801000}],"nameRight":"","textRight":"啊，对了！"},{"chara":[{"id":801000}],"nameRight":"","textRight":"简洁的白色上衣，@配上红色伞裙，"},{"chara":[{"id":801000}],"nameRight":"","textRight":"这一身你穿着也一定好看！"},{"chara":[{"id":102501,"motion":400}],"nameLeft":"静香","textLeft":"又、又多了一套……！"},{"autoTurnLast":0.3,"bg":"bg_adv_21401.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"lipSynch":0,"motion":300}],"nameLeft":"静香","textLeft":"…………[wait:0.8][chara:102501:lipSynch_1]呼……@这样就都逛过一遍了吧……","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"导览册上@已经写得满满的了呢。"},{"chara":[{"id":102501,"lipSynch":0,"motion":1}],"nameLeft":"静香","textLeft":"…………"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"……是不是有点太偏向@我自己的喜好了？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":0,"pos":2}],"nameRight":"空穗夏希","textRight":"确实，可爱风……或者说，@比较成熟的大姐姐风格的店，"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"你都记了不少东西呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"得再拿一本新的导览册，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"不能只顾着自己的喜好，@还是重新写一遍吧……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":1,"pos":2}],"nameRight":"空穗夏希","textRight":"你看起来也累了，@要不要休息一下？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"……也好，@我想找个安静一点的地方。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"我知道有个好地方哦。"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"路上@顺便买点点心吧！"},{"autoTurnLast":2,"turnChangeIn":"fadeIn"}]},"version":3}