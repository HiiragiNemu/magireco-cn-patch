{"story":{"group_1":[{"autoTurnLast":0.3,"bg":"bg_adv_13141.jpg","bgm":"bgm23_tokime01","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"＜时女一族决定与神滨魔法联盟@结盟的时候……＞","narrationBg":"black","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"＜应族长静香的邀请，@一族的少女们@也即将齐聚神滨市＞"},{"chara":[{"cheek":0,"id":102501,"motion":100,"pos":1}],"nameCenter":"静香","narrationEffect":"out","textCenter":"分家的孩子们@不是很快就要来了吗？"},{"chara":[{"id":102501}],"nameCenter":"静香","textCenter":"所以，我想做一份@神滨生活“地图”。"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":102501}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102701,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"motion":1,"pos":0}],"nameCenter":"千春&沙绪","textCenter":"神滨生活地图……？"},{"chara":[{"id":102501,"motion":200,"pos":0},{"id":102701}],"nameLeft":"静香","textLeft":"对，就是“地图”。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"把在神滨生活时@会用到的地方都标出来。"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"人生地不熟的，连该去哪里买什么@都不知道，多不方便呀？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"原来如此，@真是个好主意！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":100,"pos":2}],"nameRight":"千春","textRight":"嗯嗯！@有了它一定会方便很多！"},{"chara":[{"id":102501,"motion":1}],"nameLeft":"静香","textLeft":"所以呀，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"我打算趁你们两个去上学的时候，@一边逛街，一边把地图做出来。"},{"autoTurnLast":0.2,"chara":[{"id":102601,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102701,"motion":400,"mouthOpen":1,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"motion":400,"mouthOpen":1,"pos":0}],"nameCenter":"千春&沙绪","textCenter":"咦！？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":400,"pos":0}],"nameLeft":"静香","textLeft":"[chara:102501:effect_emotion_surprise_0][se:7226_shock]咦！？"},{"chara":[{"id":102501,"pos":0}],"nameLeft":"静香","textLeft":"怎、怎么了？@我说了什么奇怪的话吗……？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102701,"motion":300,"mouthOpen":0,"pos":2}],"nameRight":"沙绪","textRight":"……那个，@静香打算一个人去做吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"因为平时白天，@你们两个都不在嘛。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102601,"motion":0,"pos":2}],"nameRight":"千春","textRight":"话是这么说……"},{"chara":[{"id":102601,"motion":200}],"nameRight":"千春","textRight":"但静香，@你真的要一个人去吗……？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"虽然能用的时间会少一些，@不过还是等休息日一起去比较……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":1,"pos":0}],"nameLeft":"静香","textLeft":"……你们不同意？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102601,"motion":300,"pos":2}],"nameRight":"千春","textRight":"与其说不同意……@不如说是担心吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102701,"motion":200,"pos":2}],"nameRight":"沙绪","textRight":"……是的。@万一迷路了，可就麻烦了。"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"真是的，你们也太操心了。@我又不是小孩子。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102601,"motion":200,"pos":2}],"nameRight":"千春","textRight":"可是，静香，@你还不熟悉这里呀……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102701,"motion":1,"pos":2}],"nameRight":"沙绪","textRight":"城市里还有很多事情，@是静香不知道的哦？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"没问题的！"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"总不能一直拿@“还不习惯”当借口呀。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"何况，分家的孩子们@也马上就要来了。"},{"chara":[{"eyeClose":1,"id":102701,"lipSynch":0},{"cheek":0,"face":"mtn_ex_030.exp.json","id":102601,"lipSynch":0,"motion":0,"pos":0}],"nameCenter":"千春&沙绪","textCenter":"…………"},{"chara":[{"eyeClose":0,"id":102701}],"nameRight":"沙绪","textRight":"……我明白了。@既然你这么坚持，我们就不拦你了……"},{"chara":[{"eyeClose":0,"id":102601,"motion":200,"pos":0}],"nameLeft":"千春","textLeft":"不过，迷路了就联系我们哦。@你会用手机打电话吧？"},{"autoTurnLast":0.2,"chara":[{"id":102601,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"当然，这点事我还是会的。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"不过，你们就放心吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501}],"nameLeft":"静香","textLeft":"趁你们两个去上学的时候，@我一定会把地图做好的！"},{"autoTurnLast":2,"turnChangeIn":"fadeIn"}]},"version":3}