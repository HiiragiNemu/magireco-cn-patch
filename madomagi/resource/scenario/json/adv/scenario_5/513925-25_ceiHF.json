                        "id": 101001,
                        "motion": 200,
                        "pos": 0
                    }
                ],
                "nameLeft": "桃子",
                "textLeft": "但是，有个东西@无论如何都想让长老您看看…！"
            },
            {
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_001.exp.json",
                        "id": 101701,
                        "motion": 200,
                        "pos": 0
                    }
                ],
                "nameLeft": "御魂",
                "textLeft": "我们在村子的海边@捡到了这串手镯"
            },
            {
                "chara": [
                    {
                        "id": 800900
                    }
                ],
                "nameRight": "长老",
                "textRight": "这又是…@很古老的手镯啊…"
            },
            {
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_051.exp.json",
                        "id": 101701
                    }
                ],
                "nameLeft": "御魂",
                "textLeft": "啊，您认识吗？"
