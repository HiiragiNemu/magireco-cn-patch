        "turnChangeOut": "fadeOut"
      },
      {
        "nameNarration": "露",
        "narration": "露―@我总感觉…不能扔下它…"
      },
      {
        "autoTurnLast": 0.1,
        "narrationEffect": "out"
      },
      {
        "nameNarration": "巫",
        "narration": "「我和你的出身和立场都不同@绝不是能在此地被认同的关系」",
        "narrationEffect": "in"
      },
      {
        "narration": "「但是，就算自己因此十分悲伤@我也不会怨恨族人@我会改变这个村子@让大家都能自由幸福地生活下去」"
      },
      {
        "narration": "「所以，如果你还活着，就请想起我的事吧@我现在也在这里等着你…」"
      },
      {
        "autoTurnLast": 0.1,
        "narrationEffect": "out"
      },
      {
        "nameNarration": "露",
        "narration": "―露―@我莫名…觉得这就是在说我们…@但是，我绝不能…认同泰党…",
        "narrationAnchor": "bottom",
        "narrationCoverOpacity": 110,
        "narrationEffect": "in",
        "narrationFontSize": 30,
        "narrationLineMargin": 10,
        "narrationLineSpace": 20
      },
      {
        "nameNarration": "露",
        "narration": "―露―@触碰到你的话语…你的愤怒…@就算看见了你为人们着想的…和我一样的姿态…"
      },
      {
        "nameNarration": "露",
        "narration": "―露―@因为那样…父亲和玄云的话语…@就会变成错误的…了…"
      },
      {
        "nameNarration": "千鹤",
        "narration": "―千鹤―@…有的时候…就是会搞错吧…"
      },
      {
        "nameNarration": "千鹤",
        "narration": "―千鹤―@而且…我也觉得…@只有你不一样…"
      },
      {
        "nameNarration": "千鹤",
        "narration": "―千鹤―@因为我看到了…@你为被三乡杀害的农民们…挖坟墓的样子…"
      },
      {
        "nameNarration": "露",
        "narration": "―露―@是…这样吗…"
      },
      {
        "nameNarration": "千鹤",
        "narration": "―千鹤―@…这个，给你"
      },
      {
        "nameNarration": "露",
        "narration": "―露―@文书…？"
      },
      {
        "nameNarration": "千鹤",
        "narration": "―千鹤―@老爹…原本要烧掉的…被我保护下来了…@上面盖着…你们那里的群印…"
      },
      {
        "nameNarration": "露",
        "narration": "―露―@诶…"
      },
      {
        "nameNarration": "千鹤",
        "narration": "―千鹤―@那是我们…原本是一个整体的…证据…@把这个…拿给露的父亲看吧…"
      },
      {
        "autoTurnLast": 0.1,
        "narrationEffect": "out"
      },
      {
        "nameNarration": "千鹤",
        "narration": "「不行…已经…连发出声音都好难受…@念话已经是极限了…」",
        "narrationEffect": "in",
        "surround": "7202_telepathy"
      },
      {
        "nameNarration": "千鹤",
        "narration": "「流太多血了…」"
      },
      {
        "nameNarration": "露",
        "narration": "「我们既不是妖魔…也不是任何其他东西…@而是流着同样的血的…人类啊…」"
      },
      {
        "nameNarration": "露",
        "narration": "「就算是泰党…也不是怪物…」"
      },
      {
        "nameNarration": "千鹤",
        "narration": "「你以为…我是什么啊…」"
      },
      {
        "nameNarration": "露",
        "narration": "「可能…和我一样的孩子吧…」"
      },
      {
        "nameNarration": "千鹤",
        "narration": "「那什么啊…」"
      },
      {
        "nameNarration": "露",
        "narration": "「呵呵…」"
      },
