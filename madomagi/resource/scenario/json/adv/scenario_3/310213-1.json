      "id": 102103,
      "motion": 1
     }
    ],
    "nameCenter": "结菜",
    "narrationEffect": "out",
    "textCenter": "而且，如今不少升学名校@也允许学生自由着装。"
   },
   {
    "chara": [
     {
      "id": 102103
     }
    ],
    "nameCenter": "结菜",
    "textCenter": "这是为什么呢……"
