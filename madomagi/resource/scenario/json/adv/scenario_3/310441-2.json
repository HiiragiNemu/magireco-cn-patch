fadeout","id":800600},{"effect":"fadeout","id":800700}],"textClear":1},{"nameNarration":"命","narration":"最后，他抽中的@是一面小小的、廉价的化妆镜","narrationBg":"narration","narrationCoverOpacity":160,"narrationEffect":"in"},{"narration":"那个人把它递给我@露出了一副有点抱歉的表情…"},{"autoTurnLast":0.2,"bg":"black","narrationEffect":"out","turnChangeIn":"fadeIn","turnChangeInTime":0.5,"turnEffect":"stop"},{"nameCenter":"命的父亲的声音","textCenter":"对不起，命","turnChangeOut":"fadeOut"},{"autoTurnLast":1.2,"bg":"bg_adv_21401.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":104401,"lipSynch":0,"motion":0,"pos":1,"soulGem":0}],"turnChangeIn":"fadeIn","turnChangeInTime":0.6},{"chara":[{"id":104401,"lipSynch":0,"motion":400,"soulGem":0}],"nameCenter":"命","textCenter":"——！？","turnChangeOut":"fadeOut","turnChangeOutTime":1.2},{"chara":[{"id":104401,"lipSynch":0,"motion":0,"soulGem":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":801000,"motion":0,"pos":2}],"nameNarration":"命","narration":"不知不觉间，我的手颤抖了起来","narrationBg":"bg_adv_21401.jpg","narrationEffect":"in"},{"chara":[{"id":104401,"lipSynch":0,"pos":0,"soulGem":0}],"narration":"明明一直都忘记了这件事@为什么事到如今却又想了起来…？"},{"narration":"…那面化妆镜被扔到哪去了来着…？"},{"chara":[{"id":801000}],"nameRight":"","narrationEffect":"out","textRight":"那个，这位客人"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":104401,"motion":200,"soulGem":0}],"nameLeft":"命","textLeft":"[chara:104401:effect_emotion_surprise_0][se:7226_shock]诶…！？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":801000}],"nameRight":"","textRight":"请问您是想买什么？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":104401,"motion":1,"soulGem":0}],"nameLeft":"命","textLeft":"呃、呃…我…"},{"chara":[{"id":104401,"motion":0,"soulGem":0}],"nameLeft":"命","textLeft":"对不起…！"},{"bg":"black","nameNarration":"命","narration":"我慌忙把菜刀放回了原位@像逃跑一样离开了那个地方","narrationBg":"black","narrationEffect":"in"},{"narration":"虽然听见了叫住自己的声音@但我没有回头"},{"autoTurnLast":2,"narrationEffect":"out","turnChangeIn":"fadeIn"}]},"version":3}