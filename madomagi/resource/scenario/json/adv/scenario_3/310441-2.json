{"story":{"group_1":[{"autoTurnLast":0.2,"bg":"bg_adv_17061.jpg","bgm":"stop","chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":800600,"lipSynch":0,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story13","chara":[{"id":800600,"lipSynch":0}],"nameCenter":"命的母亲","textCenter":"…………","turnChangeOut":"fadeOut"},{"autoTurnLast":0.25,"chara":[{"id":800600,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":104401,"motion":0,"pos":2,"soulGem":0}],"nameRight":"命","textRight":"啊，妈妈"},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp3.json","id":800600}],"nameLeft":"命的母亲","textLeft":"命…？@你是刚回来吗"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":104401,"motion":1,"soulGem":0}],"nameRight":"命","textRight":"杵在这干嘛@快进家里来啊"},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":800600}],"nameLeft":"命的母亲","textLeft":"嗯…"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104401}],"nameNarration":"命","narration":"我注意到妈妈的脸颊有些红肿","narrationBg":"bg_adv_17061.jpg","narrationEffect":"in"},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp3.json","id":800600}],"narration":"…是被爸爸打的"},{"chara":[{"id":800600}],"nameLeft":"命的母亲","narrationEffect":"out","textLeft":"啊啊，这个？@我只是稍微跟别人打了一架而已…"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":104401,"motion":0,"soulGem":0}],"nameRight":"命","textRight":"爸爸回来了吗？"},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":800600,"lipSynch":0}],"nameLeft":"命的母亲","textLeft":"…………"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":800600}],"nameLeft":"命的母亲","textLeft":"呐，命@这个给你…"},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":800600},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":104401,"soulGem":0}],"nameNarration":"命","narration":"妈妈递给我的@是一张皱巴巴的一千日元纸币","narrationBg":"bg_adv_17061.jpg","narrationEffect":"in"},{"chara":[{"id":800600}],"nameLeft":"命的母亲","narrationEffect":"out","textLeft":"我一直没给你零花钱吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":104401,"motion":400,"soulGem":0}],"nameRight":"命","textRight":"诶，但是…"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":800600}],"nameLeft":"命的母亲","textLeft":"没事的…@这么点钱，你就别客气了"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":104401,"motion":0,"soulGem":0}],"nameNarration":"命","narration":"和普通的家庭相比@确实可以说是“这么点钱”吧","narrationBg":"bg_adv_17061.jpg","narrationEffect":"in"},{"narration":"但是，因为知道妈妈的脸颊红肿@一定就是因为这个@所以，我就算死也不会说这只是“这么点钱”"},{"chara":[{"id":104401,"motion":200,"soulGem":0}],"nameRight":"命","narrationEffect":"out","textRight":"…我会去工作的@我想让妈妈轻松一点"},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp3.json","id":800600}],"nameLeft":"命的母亲","textLeft":"这么小就去工作怎么行…！"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":104401,"motion":300,"soulGem":0}],"nameRight":"命","textRight":"因为…"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp3.json","id":800600}],"nameLeft":"命的母亲","textLeft":"你不用做那种事@妈妈会努力的…！"},{"chara":[{"eyeClose":1,"id":104401,"lipSynch":0,"soulGem":0}],"nameRight":"命","textRight":"…………"},{"nameNarration":"命","narration":"为什么妈妈必须得努力才行？","narrationBg":"bg_adv_17061.jpg","narrationEffect":"in"},{"narration":"明明都是那个人的错…"},{"autoTurnLast":0.2,"bg":"bg_adv_21294.jpg","narrationEffect":"out","turnChangeIn":"fadeIn","turnEffect":"sepiaFrame"},{"nameNarration":"命","narration":"忘记是什么时候了…@我曾经问过妈妈@她为什么没有离开那个人","narrationBg":"narration","narrationCoverOpacity":160,"narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"丢下那个人，和我在别的城市生活…@那样一来，一切就都能解决了吧@我是这么想的，但…"},{"nameNarration":"命的母亲","narration":"「哪有你说的那么简单」"},{"nameNarration":"命","narration":"听到这句话，我就知道@妈妈仍然对那个人有感情@所以她无法逃离这里，也没想过要逃离"},{"narration":"虽然很不可思议…@但夫妻或许就是那样的关系"},{"autoTurnLast":0.2,"bg":"black","bgm":"stop","narrationEffect":"out","turnChangeIn":"fadeIn","turnEffect":"stop"},{"nameNarration":"命","narration":"但我还是觉得@如果没有那个人就好了@我衷心如此祈愿","narrationBg":"black","narrationEffect":"in","turnChangeOut":"fadeOut"},{"autoTurnLast":1,"bg":"bg_adv_17061.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":104401,"lipSynch":0,"motion":0,"pos":1,"soulGem":0}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"bgm":"bgm03_story12","chara":[{"id":104401,"lipSynch":0,"soulGem":0}],"nameCenter":"命","textCenter":"…………","turnChangeOut":"fadeOut"},{"nameNarration":"命","narration":"不管是家里变得一团糟@还是必须在学校伪装自己@说到底都是那个人的错","narrationBg":"bg_adv_17061.jpg","narrationEffect":"in"},{"narration":"只要那个人还在@我们就无法变得幸福"},{"narration":"明明如此@妈妈却不愿意离开那个人…"},{"narration":"那要怎么做才好？@要怎么做才能离开这里？"},{"autoTurnLast":0.2,"bg":"black","narrationEffect":"out","turnChangeIn":"fadeIn"},{"nameNarration":"命","narration":"啊，这样啊…","narrationBg":"black","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"只要让那个人消失就好了"},{"autoTurnLast":1.5,"bg":"bg_adv_17061.jpg","bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":800600,"motion":0,"pos":0},{"cheek":0,"eyeClose":1,"face":"mtn_ex_020.exp3.json","id":104401,"motion":1,"pos":2,"soulGem":0}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"bgm":"bgm03_story08","chara":[{"id":104401,"lipSynch":0,"soulGem":0}],"nameRight":"命","textRight":"…………","turnChangeOut":"fadeOut"},{"chara":[{"id":800600}],"nameLeft":"命的母亲","textLeft":"…命？"},{"autoTurnLast":0.2,"chara":[{"eyeClose":0,"id":104401}]},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":104401,"motion":0,"soulGem":0}],"nameRight":"命","textRight":"我想起来有件事要办"},{"chara":[{"id":104401,"motion":100,"soulGem":0}],"nameRight":"命","textRight":"我稍微出趟门"},{"autoTurnLast":0.8,"chara":[{"effect":"fadeout","id":104401}],"se":"7107_arrivalone","textClear":1},{"chara":[{"id":800600,"pos":1}],"nameCenter":"命的母亲","textCenter":"啊，命…！"},{"bg":"black","nameNarration":"命","narration":"就由我来让那个人消失","narrationBg":"black","narrationEffect":"in"},{"narration":"我会强行@把妈妈从那个人身边拉开"},{"narration":"只要这么做@一切肯定都会好起来的…"},{"narration":"幸运的是@我手上正好有一张一千日元纸币"},{"narration":"这就是通往幸福的门票"},{"narration":"我要用这张门票…"},{"narration":"获取杀掉那个人的道具"},{"autoTurnLast":1.4,"bg":"bg_adv_21041.jpg","narrationEffect":"out","turnChangeIn":"fadeIn"},{"nameNarration":"命","narration":"为了买刀，我找了好几家店@但里面都没有","narrationBg":"bg_adv_21041.jpg","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"而且，看商品目录@只有我手里这点钱是怎么也买不起的…"},{"autoTurnLast":0.5,"bg":"bg_adv_21401.jpg","narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104401,"motion":0,"pos":1,"soulGem":0}],"nameNarration":"命","narration":"我找了一圈百円店@但里面也没有刀","narrationBg":"bg_adv_21401.jpg","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"不过，有一把菜刀"},{"narration":"刀刃的锋利程度如何？@只要扎进去就可以了，@所以不用想那么多也可以…？"},{"chara":[{"id":104401,"motion":400,"soulGem":0}],"nameCenter":"命","narrationEffect":"out","textCenter":"…总之@先买下来吧…？"},{"nameNarration":"命","narration":"我拿起了@装在透明塑料盒里的万能菜刀","narrationBg":"bg_adv_21401.jpg","narrationEffect":"in"},{"narration":"只用这个…只用100日元@我就能杀掉那个人了"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":104401,"motion":1,"soulGem":0}],"narration":"为了100日元就能解决的问题@我居然至今为止一直那么苦恼，就像笨蛋一样"},{"chara":[{"id":104401,"soulGem":0}],"nameCenter":"命","narrationEffect":"out","textCenter":"…我、我一定会动手…"},{"nameNarration":"命","narration":"我要杀掉那个人，然后变得幸福","narrationBg":"bg_adv_21401.jpg","narrationEffect":"in"},{"autoTurnLast":0.2,"bg":"black","narrationEffect":"out","turnChangeIn":"fadeIn"},{"nameNarration":"命","narration":"就在我这么想着握紧菜刀的时候","narrationBg":"black","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"不知为何，我想起了过去的事情"},{"autoTurnLast":0.2,"narrationEffect":"out"},{"autoTurnLast":1,"bg":"bg_adv_20351.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":801600,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":800600,"motion":0,"pos":2}],"turnChangeIn":"whiteIn","turnChangeInTime":1.3,"turnEffect":"sepiaFrame"},{"chara":[{"id":800600}],"nameRight":"命的母亲","textRight":"命，有什么喜欢的东西@都可以吃哦","turnChangeOut":"whiteOut","turnChangeOutTime":1},{"chara":[{"id":801600}],"nameLeft":"小时候的命","textLeft":"嗯、嗯…"},{"autoTurnLast":0.25,"chara":[{"effect":"fadeout","id":801600},{"effect":"