    "nameNarration": "佩尔内勒的手记",
    "narration": "[textBlack:据丘卜一族所说，自有史以前]@[textBlack:它们便一直干涉着我们的文明]@[textBlack:这的确是事实]",
    "narrationCoverOpacity": 0,
    "narrationEffect": "in",
