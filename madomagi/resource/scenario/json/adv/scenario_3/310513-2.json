   {
    "nameNarration": "卓玛",
    "narration": "―卓玛―@…………"
   },
   {
    "nameNarration": "赫露伽",
    "narration": "―赫露迦―@啊，你问震天雷吗？修女院里就有@以前见过用法，所以我记住了…"
   },
   {
    "narration": "―赫露迦―@这是我为谈判破裂时@准备的最后手段"
   },
   {
    "narration": "―赫露迦―@我原本打算用它把自己也一起炸掉"
   },
   {
    "nameNarration": "卓玛",
    "narration": "―卓玛―@…为什么要做到这种地步？"
   },
   {
    "nameNarration": "赫露伽",
    "narration": "―赫露迦―@因为我想保护卓玛"
