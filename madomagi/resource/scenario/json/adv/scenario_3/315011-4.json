        "nameNarration": "彩羽",
        "narration": "店里的小鹤乃，@从第一次见面起就总是活力十足。",
        "narrationAnchor": "bottom",
        "narrationCoverOpacity": 110,
        "narrationEffect": "in",
        "narrationFontSize": 30,
        "narrationLineMargin": 35,
        "narrationLineSpace": 20,
        "turnChangeOut": "fadeOut"
      },
      {
        "narration": "那时候的我完全想象不到，@她的笑容背后竟藏着悲伤。"
      },
      {
        "autoTurnLast": 0.1,
        "narrationEffect": "out"
      },
