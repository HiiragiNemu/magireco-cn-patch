          }
        ],
        "nameNarration": "彩羽",
        "narration": "从小玲奈那里听说传闻后@我开始接连收到好几封邮件",
        "narrationAnchor": "bottom",
        "narrationCoverOpacity": 110,
        "narrationEffect": "in",
        "narrationFontSize": 30,
        "narrationLineMargin": 35,
        "narrationLineSpace": 20
      },
      {
        "narration": "和八千代小姐她们一起调查后才知道@那些邮件来自“孤独的尽头”之谣@——“小爱”"
      },
      {
        "narration": "邮件的内容，是希望我们消除[textBlue:传闻]@救出二叶莎奈"
      },
      {
        "autoTurnLast": 0.1,
