      },
      {
        "nameNarration": "彩羽",
        "narration": "可是，为了救出小莎奈@能够前往孤独的尽头的人只有一个",
        "narrationAnchor": "bottom",
        "narrationCoverOpacity": 110,
        "narrationEffect": "in",
        "narrationFontSize": 30,
        "narrationLineMargin": 35,
        "narrationLineSpace": 20
      },
      {
        "narration": "也许，比起让弱小的我去@换成其他人会更好"
      },
      {
        "narration": "但小莎奈和我有些相似@我想凭自己的力量救出她"
      },
      {
        "narration": "之所以能够产生这样的想法@一定是因为在与大家共同生活的过程中"
      },
      {
        "narration": "我渐渐变得能够说出自己的意见@如今再回想起来，我深深感受到了这一点"
      },
      {
        "autoTurnLast": 0.1,
        "narrationEffect": "out"
