    "chara": [
     {
      "cheek": 0,
      "face": "mtn_ex_010.exp3.json",
      "id": 833000,
      "pos": 2
     }
    ],
    "nameRight": "长老",
    "textRight": "很快便为她所倾倒，@转而成为她的盟友。"
   },
   {
    "chara": [
     {
      "cheek": 0,
      "face": "mtn_ex_010.exp3.json",
      "id": 104801,
      "motion": 100,
      "pos": 0
     }
