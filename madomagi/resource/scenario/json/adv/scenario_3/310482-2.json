     {
      "id": 104801,
      "motion": 0,
      "pos": 0
     }
    ],
    "nameRight": "长老",
    "narrationEffect": "out",
    "textRight": "安东尼大人原本@与克里奥帕特拉大人处于对立关系，但…"
