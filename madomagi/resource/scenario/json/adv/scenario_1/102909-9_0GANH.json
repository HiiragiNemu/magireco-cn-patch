                    {
                        "id": 102801,
                        "voiceFullAuto": "fullvoice/section_102959/vo_full_102909-9-9"
                    }
                ],
                "nameRight": "姬奈",
                "textRight": "嘛，倒也可以"
            },
            {
                "autoTurnLast": 0.1,
                "bg": "black",
                "item": [
                    {
                        "path": "resource/scenario/img/part2_chapter8/102909_neomagus4.jpg",
                        "posX": 0,
