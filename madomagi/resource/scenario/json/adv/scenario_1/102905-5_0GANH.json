                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-6"
                    }
                ],
                "nameLeft": "莉薇娅",
                "textLeft": "如果是教授的话@应该不需要详细地进行说明了吧？"
            },
            {
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_000.exp3.json",
                        "id": 802401,
                        "motion": 1,
                        "pos": 2,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-7"
                    }
                ],
                "nameRight": "太助",
                "textRight": "原来如此…看你的样子@好像已经把握了我前来的理由呢"
            },
            {
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_011.exp3.json",
                        "id": 104101,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-8"
                    }
                ],
                "nameLeft": "莉薇娅",
                "textLeft": "我还没有把握到@教授记忆中的事情那种程度哦"
            },
            {
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_010.exp3.json",
                        "id": 104101,
                        "motion": 1,
                        "pos": 0,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-9"
                    }
                ],
                "nameLeft": "莉薇娅",
                "textLeft": "所以，虽然不知道具体细节"
            },
            {
                "chara": [
                    {
                        "id": 104101,
                        "voiceFull": "fullvoice/section_102936/vo_full_102905-5-10"
                    }
                ],
                "nameLeft": "莉薇娅",
                "textLeft": "但小那由他想要知道的@就是只有教授您知道的事情"
            },
            {
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_030.exp3.json",
                        "id": 802401,
                        "lipSynch": 0,
                        "voiceFullStop": "fullvoice/section_102936/vo_full_102905-5-10"
                    }
                ],
                "nameRight": "太助",
                "textRight": "…………[wait:0.8][chara:802401:lipSynch_1][chara:802401:voiceFull_fullvoice/section_102936/vo_full_102905-5-11]是啊…"
            },
            {
                "chara": [
                    {
                        "id": 802401,
                        "motion": 0,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-12",
                        "voiceFullStop": "fullvoice/section_102936/vo_full_102905-5-11"
                    }
                ],
                "nameRight": "太助",
                "textRight": "那由他首先想知道的@就是我消失的理由吧"
            },
            {
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_020.exp3.json",
                        "id": 103701,
                        "motion": 100,
                        "pos": 0,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-13"
                    }
                ],
                "nameLeft": "那由他",
                "textLeft": "不只是这个"
            },
            {
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_030.exp3.json",
                        "id": 103701,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-14"
                    }
                ],
                "nameLeft": "那由他",
                "textLeft": "虽然爸爸的确消失了@而且还音信不通"
            },
            {
                "chara": [
                    {
                        "id": 103701,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-15"
                    }
                ],
                "nameLeft": "那由他",
                "textLeft": "但我也很在意扩散魔法少女的事情@还有你和伯父谈话的内容"
            },
            {
                "chara": [
                    {
                        "id": 103701,
                        "motion": 400,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-16"
                    }
                ],
                "nameLeft": "那由他",
                "textLeft": "所以，请你按顺序告诉我吧…！"
            },
            {
                "chara": [
                    {
                        "id": 802401,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-17"
                    }
                ],
                "nameRight": "太助",
                "textRight": "…这些事情都互相纠缠在一起@所以我很难简洁地一件件说明"
            },
            {
                "chara": [
                    {
                        "id": 802401,
                        "motion": 100,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-18"
                    }
                ],
                "nameRight": "太助",
                "textRight": "所以，能从我消失之前的事情@开始回顾吗…？"
            },
            {
                "chara": [
                    {
                        "id": 103701,
                        "motion": 0,
                        "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-19"
                    }
                ],
                "nameLeft": "那由他",
                "textLeft": "我明白了…"
            },
            {
                "autoTurnLast": 1,
                "bgm": "stop",
                "chara": [
                    {
                        "eyeClose": 1,
                        "id": 802401,
                        "motion": 0
                    }
                ],
                "textClear": 1
            },
            {
                "autoTurnLast": 1,
                "bg": "black",
                "turnChangeIn": "fadeIn",
                "turnChangeInTime": 1.2
            },
            {
                "bgm": "bgm23_folklore05",
                "nameNarration": "太助",
                "narration": "「自从我知道了那由他成为魔法少女的事情@并相信着这件事开始调查的时候@我就有一件感到疑惑的事情」",
                "narrationEffect": "in",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-20"
            },
            {
                "narration": "「那就是在人类的历史之中@魔法少女不为人所知地存在着的事实」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-21"
            },
            {
                "narration": "「明明魔法少女不仅从魔女手中守护着我们@还有着足以促使人类进化、@左右历史进程的影响力@她们却不知为何被隐藏在历史的阴影之中」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-22"
            },
            {
                "narration": "「这成为了一个巨大的疑问@填满了我的内心」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-23"
            },
            {
                "autoTurnLast": 0.01,
                "bg": "bg_adv_20091.jpg",
                "narrationEffect": "out",
                "turnChangeIn": "fadeIn"
            },
            {
                "nameNarration": "太助",
                "narration": "「在为寻找魔法少女的痕迹而环游诸国@调查过留下了名字的女性和她们的历史后@“虽然会根据时代和文化不同改变名称，@但魔法少女一直都存在着”@我得出了这样的结论」",
                "narrationEffect": "in",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-24"
            },
            {
                "narration": "「在过去的文献中大量存在的@夸张了事实的表现手法@以及将空想像事实一样记述的表现手法」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-25"
            },
            {
                "narration": "「一般的解释认为，那些都是@古代的掌权者们为了彰显自己的权威而做的@事实上，也存在很多类似神话和英雄谭的记载」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-26"
            },
            {
                "narration": "「联系一下那由他从丘比那里听说的@自古以来就有魔法少女存在的说法@就算魔法少女存在于那些神话和英雄谭中@绝对也不是什么不可思议的事情」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-27"
            },
            {
                "narration": "「但是不管怎样调查，记载在文献中的@都只有如同仅限一时的梦幻一般的内容@这些内容也从未超出过神话和英雄谭的范畴」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-28"
            },
            {
                "narration": "「明明不管是哪个时代，在我们的周围@都有像那由他和灯花一样的魔法少女存在@她们却决不会被作为普遍存在的现象认知@只会作为传说而留下名字而已」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-29"
            },
            {
                "autoTurnLast": 0.01,
                "bg": "black",
                "narrationEffect": "out",
                "turnChangeIn": "fadeIn"
            },
            {
                "nameNarration": "太助",
                "narration": "「那么，没有成为传说的@平凡的魔法少女们又怎么样了呢…」",
                "narrationEffect": "in",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-30"
            },
            {
                "narration": "「谁也不会宣扬自己打倒了魔女的事情@也不会讲述自己的愿望@就像在遗传因子级别被编码了一样@她们一直将隐藏自己的真实身份@当作理所应当的事情」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-31"
            },
            {
                "narration": "「让我尤其强烈地感觉到了这一点的@是我在数年前于神滨相遇的魔法少女们」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-32"
            },
            {
                "autoTurnLast": 0.01,
                "bg": "bg_adv_14021.jpg",
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_021.exp3.json",
                        "id": 100200,
                        "motion": 301,
                        "pos": 0
                    },
                    {
                        "cheek": 0,
                        "face": "mtn_ex_030.exp3.json",
                        "id": 100600,
                        "motion": 1,
                        "pos": 2
                    }
                ],
                "narrationEffect": "out",
                "turnChangeIn": "fadeIn"
            },
            {
                "nameNarration": "太助",
                "narration": "「当时的她们分裂成了东西两个阵营@为了互相争夺魔女而血流成河」",
                "narrationCoverOpacity": 150,
                "narrationEffect": "in",
                "turnChangeOut": "fadeOut",
                "turnEffect": "blackFrame",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-33"
            },
            {
                "narration": "「但是，她们从未将@自己的痛苦向任何人倾诉@而是故作平常地继续着日常生活」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-34"
            },
            {
                "autoTurnLast": 0.01,
                "bg": "bg_adv_20021.jpg",
                "chara": [
                    {
                        "cheek": 0,
                        "face": "mtn_ex_020.exp3.json",
                        "id": 102100,
                        "motion": 0,
                        "pos": 0
                    },
                    {
                        "cheek": 0,
                        "face": "mtn_ex_012.exp3.json",
                        "id": 102400,
                        "motion": 1,
                        "pos": 2
                    }
                ],
                "narrationEffect": "out",
                "turnChangeIn": "fadeIn"
            },
            {
                "nameNarration": "太助",
                "narration": "「那份违和感@在我造访二木市的时候也没有改变」",
                "narrationCoverOpacity": 150,
                "narrationEffect": "in",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-35"
            },
            {
                "narration": "「然后，看过了从不倾诉自己的窘境的@魔法少女们的姿态和城市的样子的我@感受到了新的违和感」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-36"
            },
            {
                "narration": "「那就是，在对残留于历史中的资料@和魔法少女们感到疑问之前@我们自身就已经很奇怪了」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-37"
            },
            {
                "autoTurnLast": 0.01,
                "bg": "black",
                "narrationEffect": "out",
                "turnChangeIn": "fadeIn",
                "turnEffect": "stop"
            },
            {
                "nameNarration": "太助",
                "narration": "「魔法少女之间的争斗会产生不自然的死@明明如此，我们却不知为何不会关注这些牺牲@而是像自然的事情一样放任自流」",
                "narrationEffect": "in",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-38"
            },
            {
                "narration": "「我对我们的异样感到了困惑…」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-39"
            },
            {
                "narration": "「即便如此，正因如此…！@我也相信将魔法少女的存在扩散到世间是有意义的@开始执笔《魔法少女 其希望与绝望》@并写完了上卷，正打算着手下卷的写作」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-40"
            },
            {
                "autoTurnLast": 0.01,
                "bg": "bg_adv_50021.jpg",
                "narrationEffect": "out",
                "turnChangeIn": "fadeIn"
            },
            {
                "nameNarration": "太助",
                "narration": "「我再次来到过去造访过的时女村落@希望能对名为巫的存在进行调查@却被身为村落之长的神子柴赶了出去@在那之后，我就集中于执笔一事了」",
                "narrationEffect": "in",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-41"
            },
            {
                "autoTurnLast": 0.01,
                "bg": "bg_adv_21461.jpg",
                "narrationEffect": "out",
                "turnChangeIn": "fadeIn"
            },
            {
                "nameNarration": "太助",
                "narration": "「但是，那由他应该也记得@在进行下卷的写作时@我的身体慢慢坏了下去，变得无法执笔了」",
                "narrationEffect": "in",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-42"
            },
            {
                "narration": "「于是，满心想设法写完下卷的我@将根据地变为汤国市@在进行温泉治疗的同时继续整理起了书的内容」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-43"
            },
            {
                "autoTurnLast": 0.01,
                "bg": "bg_adv_53011.jpg",
                "narrationEffect": "out",
                "turnChangeIn": "fadeIn"
            },
            {
                "nameNarration": "太助",
                "narration": "「然后，我发现在那座城市里@至少在学生之间@大家都知道魔法少女的事情」",
                "narrationEffect": "in",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-44"
            },
            {
                "narration": "「虽然仍不完全，但那正是@我想达成的目标化为现实的姿态」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-45"
            },
            {
                "narration": "「但是，那是个@魔法少女的人间地狱」",
                "voiceFullAuto": "fullvoice/section_102936/vo_full_102905-5-46"
            },
            {
                "autoTurnLast": 0.01
            },
