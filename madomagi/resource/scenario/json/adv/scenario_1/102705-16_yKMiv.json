            "motion": 300,
            "pos": 0,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-13"
          }
        ],
        "nameLeft": "拉比",
        "textLeft": "…根据PROMISED BLOOD的@态度不同，事态到底会如何发展呢"
