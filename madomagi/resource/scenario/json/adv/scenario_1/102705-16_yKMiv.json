            "id": 103600,
            "motion": 100,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-18"
          }
        ],
        "nameRight": "丽",
        "textRight": "她们正在筹划@将魔法少女的存在发送给全世界哦"
