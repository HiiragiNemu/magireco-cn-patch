      {
        "chara": [
          {
            "id": 103600,
            "motion": 300,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-11"
          }
        ],
        "nameRight": "丽",
        "textRight": "总之，现在我们正在@精细地计算剩下的金钱"
