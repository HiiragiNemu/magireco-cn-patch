      {
        "chara": [
          {
            "id": 103300,
            "motion": 0,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-16"
          }
        ],
        "nameLeft": "拉比",
        "textLeft": "是什么呢？"
