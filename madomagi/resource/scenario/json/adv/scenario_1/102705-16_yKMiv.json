        "chara": [
          {
            "eyeClose": 1,
            "id": 103400,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-27"
          }
        ],
        "nameRight": "旭",
        "textRight": "嘛，还是做好警戒@最重要就是了…"
