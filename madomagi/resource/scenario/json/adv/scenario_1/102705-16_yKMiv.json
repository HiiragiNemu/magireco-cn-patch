        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_010.exp3.json",
            "id": 103600,
            "motion": 1,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-14"
          }
        ],
        "nameRight": "丽",
        "textRight": "啊，这么说了@我和佐鸟笼目聊过一次"
