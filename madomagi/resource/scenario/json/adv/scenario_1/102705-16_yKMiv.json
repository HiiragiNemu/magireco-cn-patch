      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_030.exp3.json",
            "id": 103400,
            "motion": 300,
            "pos": 2,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-25"
          }
        ],
        "nameRight": "旭",
        "textRight": "只不过，就算被发送给整个世界@我觉得魔法少女也是不会传播开的"
