            "motion": 100,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-22"
          }
        ],
        "nameLeft": "拉比",
        "textLeft": "因为找到了恰当的时机@我就为了让她和里见灯花断交"
