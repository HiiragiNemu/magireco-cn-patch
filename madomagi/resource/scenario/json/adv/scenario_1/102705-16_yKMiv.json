            "id": 103500,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-8"
          }
        ],
        "nameLeft": "亚历山德拉",
        "textLeft": "或许马上就要到@向其他的团体露脸的时机了"
