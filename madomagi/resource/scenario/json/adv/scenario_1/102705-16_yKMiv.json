      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_000.exp3.json",
            "id": 103300,
            "motion": 1,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-30"
          }
        ],
        "nameLeft": "拉比",
        "textLeft": "虽然涨潮之时已经很近了@但是，我还想再多看看状况"
