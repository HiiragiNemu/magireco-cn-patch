      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_030.exp3.json",
            "id": 103500,
            "motion": 1,
            "pos": 2,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-28"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "还有，小拉比"
