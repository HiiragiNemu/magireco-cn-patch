      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_000.exp3.json",
            "id": 103300,
            "motion": 0,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-20"
          }
        ],
        "nameLeft": "拉比",
        "textLeft": "事先做好了准备@真是太好了"
