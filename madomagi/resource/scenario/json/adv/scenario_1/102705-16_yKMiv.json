      {
        "chara": [
          {
            "id": 103300,
            "motion": 0,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-24"
          }
        ],
        "nameLeft": "拉比",
        "textLeft": "如果事情真的如丽所说@那我的做法就是正确的"
