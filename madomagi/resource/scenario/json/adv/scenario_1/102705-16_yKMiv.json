        "chara": [
          {
            "id": 103300,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-44"
          }
        ],
        "nameLeft": "拉比",
        "textLeft": "他们被法家战胜，@然后消失了"
