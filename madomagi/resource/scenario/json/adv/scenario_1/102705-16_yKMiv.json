      {
        "chara": [
          {
            "id": 103500,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-16-29"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "我们一直要@潜伏到什么时候呢？"
