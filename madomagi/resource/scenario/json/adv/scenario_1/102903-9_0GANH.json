            {
                "bgm": "bgm03_story04",
                "nameNarration": "树里",
                "narration": "—树里—@喂，你干什么…",
                "narrationAnchor": "bottom",
                "narrationCoverOpacity": 110,
                "narrationEffect": "in",
                "narrationFontSize": 30,
                "narrationLineMargin": 35,
                "narrationLineSpace": 20,
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-1"
            },
            {
                "nameNarration": "结菜",
                "narration": "—结菜—@你刚才…@是在尝试自杀吧！",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-2"
            },
            {
                "nameNarration": "树里",
                "narration": "—树里—@别开玩笑了，树里大人我吗？@怎么可能啊，你是笨蛋吗？",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-3"
            },
            {
                "nameNarration": "结菜",
                "narration": "—结菜—@我们的交情可没法被那种话糊弄过去@是吧，树里…？",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-4"
            },
            {
                "nameNarration": "树里",
                "narration": "—树里—@…………",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-5"
            },
            {
                "nameNarration": "结菜",
                "narration": "—结菜—@说实话吧…",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-6"
            },
            {
                "nameNarration": "树里",
                "narration": "—树里—@啊啊，是的@我在尝试打碎自己的灵魂宝石",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-7"
            },
            {
                "narration": "—树里—@…直说，对现在的二木来说@没有树里大人会是压倒性的有利吧",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-8"
            },
            {
                "nameNarration": "结菜",
                "narration": "—结菜—@事到如今，你在说什么呢…？",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-9"
            },
            {
                "nameNarration": "树里",
                "narration": "—树里—@我是那种从过去就一直寻求争斗的类型@而且还没法控制积蓄起来的力量",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-10"
            },
            {
                "narration": "—树里—@如果和神滨市的战斗结束了@树里大人果然会想和大姐互相残杀",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-11"
            },
            {
                "narration": "—树里—@明明难得你把大家团结起来@这样肯定很碍事吧",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-12"
            },
            {
                "nameNarration": "结菜",
                "narration": "—结菜—@如果是之前的你，应该不会顾虑这种事的@你是突然想改变人设吗",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-13"
            },
            {
                "nameNarration": "树里",
                "narration": "—树里—@三日月庄的最强对我说过",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-14"
            },
            {
                "narration": "—树里—@只要树里大人还在@没有争斗的世界肯定不会到来",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-15"
            },
            {
                "narration": "—树里—@只要还有从最开始就寻求着争斗的家伙在@平稳就不会造访这个世界",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-16"
            },
            {
                "nameNarration": "结菜",
                "narration": "—结菜—@这倒是真的…@但是，你居然会接受这种话…",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-17"
            },
            {
                "nameNarration": "树里",
                "narration": "—树里—@如果是以前，树里大人只要自己满足就好了@但现在，能称为同伴的人实在是多过头了",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-18"
            },
            {
                "narration": "—树里—@虽然在至今为止都持续着弱肉强食的争斗的二木市尽情大闹一场也没有问题",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-19"
            },
            {
                "narration": "—树里—@但大姐你们正在为了终结那个时代@认真地团结着大家",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-20"
            },
            {
                "narration": "—树里—@那意味着今天的同伴可能是明天的敌人@这种道理无法通用的时代即将到来",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-21"
            },
            {
                "narration": "—树里—@如果树里大人一个人举起反旗大闹一场@剩下的就只有同伴的不幸而已",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-22"
            },
            {
                "narration": "—树里—@如果时代要变化，树里大人就不再必要了@龙之崎总有一天也会对我离心，而且这样就好",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-23"
            },
            {
                "nameNarration": "结菜",
                "narration": "—结菜—@就算使用强硬的手段，你也掌握着龙之崎的忠心@现在可不是你该死去的时候",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-24"
            },
            {
                "narration": "—结菜—@如果树里消失了，二木市的平衡就会崩溃@再次产生出混乱",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-25"
            },
            {
                "narration": "—结菜—@再加上，如果小青真的要背叛@我们就没心情去管自动净化系统了",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-26"
            },
            {
                "nameNarration": "树里",
                "narration": "—树里—@你是想说，我只是待在这里就有意义吗？@我还真是被高看了呢",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-27"
            },
            {
                "narration": "—树里—@那，树里大人无法消失的火焰要怎么办",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-28"
            },
            {
                "narration": "—树里—@既然我这边能为了长久地生存下去@而自由大闹的时代已经结束了",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-29"
            },
            {
                "narration": "—树里—@我就没法毫无理由地战斗了",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-30"
            },
            {
                "bgm": "stop",
                "nameNarration": "结菜",
                "narration": "—结菜—@至少，我们有必要为了小青而战",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-31"
            },
            {
                "nameNarration": "树里",
                "narration": "—树里—@啊？",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-32"
            },
            {
                "bgm": "bgm23_promised05",
                "nameNarration": "结菜",
                "narration": "—结菜—@那孩子发生了改变@并不只是因为[textYellow:心魔]",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-33"
            },
            {
                "narration": "—结菜—@那孩子是在我们镌刻下的历史@这个前提下坏掉了…",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-34"
            },
            {
                "narration": "—结菜—@那么，我们从今往后战斗的理由@就是为了拯救小青了",
                "voiceFullAuto": "fullvoice/section_102920/vo_full_102903-9-35"
            },
