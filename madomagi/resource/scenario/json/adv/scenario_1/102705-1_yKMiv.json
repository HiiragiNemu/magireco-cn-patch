      {
        "bgm": "bgm03_story06",
        "nameNarration": "",
        "narration": "「神滨东西之间的格差问题@从以前就一直受到广泛的讨论@但是，这次的选举@对生活在这里的市民们@也会造成巨大的影响」",
        "narrationBg": "",
        "narrationEffect": "in",
        "turnChangeOut": "fadeOut",
        "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-1-7"
      },
