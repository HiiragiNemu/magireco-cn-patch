      },
      {
        "chara": [
          {
            "id": 101700,
            "motion": 100,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-1-8"
          }
        ],
        "nameLeft": "御魂",
        "textLeft": "我们现在已经做不到任何事情，@只能这样迎接明天的投票开票了呢"
      },
      {
