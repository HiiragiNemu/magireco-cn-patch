          {
            "cheek": 0,
            "face": "mtn_ex_041.exp3.json",
            "id": 101700,
            "motion": 0,
            "pos": 0,
            "voiceFullAuto": "fullvoice/section_102705/vo_full_102705-1-12"
          }
        ],
        "nameLeft": "御魂",
        "textLeft": "但是，我好像不太行呢…"
