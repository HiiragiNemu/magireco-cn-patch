            "pos": 2,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-15"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "怎么会，完全不会不正常啊！"
      },
      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_010.exp3.json",
            "id": 102801,
            "pos": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-16"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "直说，会这么说我的@也只有魔法少女了吧"
      },
      {
        "chara": [
          {
            "id": 102801,
            "motion": 1,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-17"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "毕竟你们都习惯了愿望啊魔法啊@这些特别的力量"
      },
      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_030.exp3.json",
            "id": 103501,
            "motion": 300,
            "pos": 2,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-18"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "虽然确实也有点免疫了，@但刚才那样也太露骨了…"
      },
      {
        "chara": [
          {
            "id": 102801,
            "motion": 300,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-19"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "但是，人家在“这里”告诉他们@已经死了的人在我的脑子里面之后"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-20"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "大家就都害怕起来，@连父母都对人家敬而远之了"
      },
      {
        "chara": [
          {
            "cheek": 0,
            "id": 103501,
            "lipSynch": 0,
            "motion": 0,
            "pos": 2,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-21"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "…………"
      },
      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_050.exp3.json",
            "id": 103501,
            "motion": 400,
            "pos": 2,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-22"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "…诶…？@刚才，你是不是说了“这里”？"
      },
      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_030.exp3.json",
            "id": 102801,
            "motion": 0,
            "pos": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-23"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "对，这里就是男票死掉@然后进到人家脑子里的地方"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-24"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "虽然在宝崎的时候@已经对其他人说过这件事了"
      },
      {
        "chara": [
          {
            "id": 102801,
            "motion": 100,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-25"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "但是，人家还没有告诉莎夏@自己要站上顶点的理由吧？"
      },
      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_030.exp3.json",
            "id": 103501,
            "motion": 100,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-26"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "你就是为了告诉我这件事@才带我来这里的吗…？"
      },
      {
        "chara": [
          {
            "id": 102801,
            "motion": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-27"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "莎夏还是@人家头一个带到这里来的人"
      },
      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_010.exp3.json",
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-28"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "因为你救过人家一命@所以，人家也想好好地告诉你"
      },
      {
        "chara": [
          {
            "id": 103501,
            "motion": 1,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-29"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "真的可以告诉我吗…？"
      },
      {
        "chara": [
          {
            "id": 102801,
            "motion": 200,
            "pos": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-30"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "不如说，希望你能听人家讲@因为，你是人家的好姐妹嘛"
      },
      {
        "chara": [
          {
            "id": 103501,
            "lipSynch": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-31"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "…………"
      },
      {
        "chara": [
          {
            "id": 103501,
            "motion": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-32"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "小姬为什么那么想站上顶点呢？"
      },
      {
        "autoTurnLast": 0.4,
        "bg": "bg_adv_21146.jpg",
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_021.exp3.json",
            "id": 102801,
            "motion": 0,
            "pos": 0
          },
          {
            "cheek": 0,
            "face": "mtn_ex_030.exp3.json",
            "id": 103501,
            "motion": 0,
            "pos": 2
          }
        ],
        "turnChangeIn": "fadeIn"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-33"
          }
        ],
        "nameNarration": "姬奈",
        "narration": "「嘛，那是因为人家没能救到痛苦的彦君@让他就那么死掉了啊」",
        "narrationBg": "bg_adv_21146.jpg",
        "narrationEffect": "in",
        "turnChangeOut": "fadeOut"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-34"
          }
        ],
        "narration": "「那时候，我处在一个很受欢迎的小团体里@彦君却是个和谁都不产生联系的阴暗系角色」"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-35"
          }
        ],
        "narration": "「即便如此，身为他儿时玩伴的人家@还是非常喜欢知识渊博、什么事情都能教我的彦君@他是绝对无法被人替代的，@自从出生开始就命中注定的，人家的男票」"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-36"
          }
        ],
        "narration": "「直说，我俩定位很不一样，所以一旦暴露就糟了@虽然一直把我们的关系作为秘密，@但我们还是被其他人看见了两人在一起的样子」"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-37"
          }
        ],
        "narration": "「其中也有对人家告白结果被甩了的人在@所以，在那之后事情就变得很不得了了」"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-38"
          }
        ],
        "narration": "「虽然人家也被冷眼相待，但彦君受到的@就是人家完全无从知晓的、地狱一般的对待了…@但是，彦君看起来和平时没什么不同@所以虽然很不想承认，但人家完全没注意到…」"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-39"
          }
        ],
        "narration": "「人家什么也没能做到@等人家注意到，一切都已经晚了…」"
      },
      {
        "chara": [
          {
            "id": 102801,
            "lipSynch": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-40"
          }
        ],
        "narration": "「亏成为了魔法少女，@现在彦君也在人家的脑袋里好好活着@但是，就像刚才被人敬而远之那样@我们还是不能自由地交往」"
      },
      {
        "autoTurnLast": 0.1,
        "narrationEffect": "out"
      },
      {
        "chara": [
          {
            "id": 102801,
            "lipSynch": 1,
            "motion": 300,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-41"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "直说，不觉得这样很蠢吗？@班里的权力关系什么的"
      },
      {
        "chara": [
          {
            "id": 102801,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-42"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "真的很想让他们不要随便干涉@其他人乐意爱上什么样的人啊"
      },
      {
        "chara": [
          {
            "cheek": 1,
            "face": "mtn_ex_050.exp3.json",
            "id": 103501,
            "pos": 2,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-43"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "[chara:103501:effect_emotion_surprise_0][se:7226_shock]——!?"
      },
      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_050.exp3.json",
            "id": 102801,
            "motion": 0,
            "pos": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-44"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "莎夏…？"
      },
      {
        "chara": [
          {
            "cheek": 1,
            "face": "mtn_ex_030.exp3.json",
            "id": 103501,
            "motion": 300,
            "tear": 1,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-45"
          }
        ],
        "nameRight": "亚历山德拉",
        "textRight": "真的是啊，为什么要限制别人@和喜欢的人坠入爱河呢…"
      },
      {
        "chara": [
          {
            "cheek": 0,
            "face": "mtn_ex_030.exp3.json",
            "id": 102801,
            "motion": 100,
            "pos": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-46"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "就算限制也是没用的不是吗…？@破坏这种限制绝对会更幸福吧…？"
      },
      {
        "chara": [
          {
            "cheek": 1,
            "face": "mtn_ex_020.exp3.json",
            "id": 103501,
            "motion": 0,
            "tear": 1,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-47"
          }
        ],
        "nameRight": "亚历山德拉",
