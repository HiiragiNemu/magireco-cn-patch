            "face": "mtn_ex_011.exp3.json",
            "id": 102801,
            "motion": 100,
            "pos": 0,
            "voiceFullAuto": "fullvoice/section_102604/vo_full_102604-1-14"
          }
        ],
        "nameLeft": "姬奈",
        "textLeft": "脑子不正常的人@这也是人家转学的其中一个理由"
