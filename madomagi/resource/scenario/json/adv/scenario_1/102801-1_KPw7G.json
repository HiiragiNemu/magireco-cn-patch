                "narrationPosX": 150,
                "progressNarration": "[textBlack:令さんと郁美さんの死によってもたらされた]@[textBlack:二木市を結ぶ株分けのミラーズの消滅。]",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102801/vo_full_102801-1-1"
            },
            {
                "progressNarration": "[textBlack:それはプロミストブラッドを]@[textBlack:窮地に追い込むことになったけど、]@[textBlack:同時にイブという魔女に戻りたいと思っている]@[textYellow:キモチ][textBlack:の本音を知る切っ掛けにもなった。]",
                "voiceFullAuto": "fullvoice/section_102801/vo_full_102801-1-2"
            },
            {
                "progressNarration": "[textBlack:その本音からわかったのは、]@[textBlack:各グループのメンバーが12人に絞り込まれ、]@[textBlack:それ以外の魔法少女が戦おうとすると]@[textYellow:キモチ][textBlack:の結界に飛ばされるようになったのは、]",
                "voiceFullAuto": "fullvoice/section_102801/vo_full_102801-1-3"
            },
            {
                "progressNarration": "[textBlack:力のある魔法少女を潰し合わせるという]@[textYellow:キモチ][textBlack:の悪意によるものだということ。]",
                "voiceFullAuto": "fullvoice/section_102801/vo_full_102801-1-3b"
            },
            {
                "progressNarration": "[textBlack:それは、][textYellow:キモチ][textBlack:の石を奪い合うのをやめて]@[textBlack:魔法少女たちが共通の敵と戦うための]@[textBlack:希望の光にも見えたけど、]",
                "voiceFullAuto": "fullvoice/section_102801/vo_full_102801-1-4"
            },
            {
                "progressNarration": "[textBlack:４つの][textYellow:キモチ][textBlack:の石を手に入れて]@[textBlack:支配感を覚えていた紅晴さんには響かず、]@[textBlack:争いの幕引きにはならなかった。]",
                "voiceFullAuto": "fullvoice/section_102801/vo_full_102801-1-5"
            },
            {
                "progressNarration": "[textBlack:ここから記すのは、そんな追い詰められた]@[textBlack:プロミストブラッドの行く末と、]@[textBlack:その端で動いていた魔法少女たちの様子。]",
                "voiceFullAuto": "fullvoice/section_102801/vo_full_102801-1-6"
            },
            {
                "progressNarration": "[textBlack:今思えば、この時期で良かったと思う。]@[textBlack:いろはさんが自分の目的を見つけたのが…。]",
                "voiceFullAuto": "fullvoice/section_102801/vo_full_102801-1-7"
            },
