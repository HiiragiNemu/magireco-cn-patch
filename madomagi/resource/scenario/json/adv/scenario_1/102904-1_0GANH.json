                "narrationCoverOpacity": 0,
                "narrationEffect": "in",
                "narrationHAlignment": "left",
                "narrationPosX": 150,
                "progressNarration": "[textBlack:佐鳥様の代役として、]@[textBlack:私、“篠目ヨヅル”が]@[textBlack:時女一族の様子を記録することになった。]",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102922/vo_full_102904-1-4"
            },
            {
                "progressNarration": "[textBlack:水徳寺に伺ったときから感じたのは重い空気。]@[textBlack:時女様が重大な決断を下そうとしていることと]@[textBlack:南津様と三浦様が床に伏せていることが]@[textBlack:空気を重くしている原因のようだった。]",
                "voiceFullAuto": "fullvoice/section_102922/vo_full_102904-1-5"
            },
            {
                "progressNarration": "[textBlack:とはいえ、優しさを失った私には、]@[textBlack:誰かがケガや病で倒れたときに、]@[textBlack:相手を心配するべきかどうかがわからない。]",
                "voiceFullAuto": "fullvoice/section_102922/vo_full_102904-1-6"
            },
            {
                "progressNarration": "[textBlack:このときの私は、過去の自分を振り返りながら]@[textBlack:優しさを纏めたノートを頼りにして]@[textBlack:彼女たちの感情を推し量ることができた。]",
                "voiceFullAuto": "fullvoice/section_102922/vo_full_102904-1-7"
            },
            {
                "progressNarration": "[textBlack:だが、文字を起こすとなると話は別なので、]@[textBlack:なるべく簡潔に]@[textBlack:事実だけを述べるように記していく。]",
                "voiceFullAuto": "fullvoice/section_102922/vo_full_102904-1-8"
            },
