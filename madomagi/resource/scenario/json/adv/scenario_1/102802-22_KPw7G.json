        "narrationHAlignment": "left",
        "narrationPosX": 80,
        "progressNarration": "[textBlack:「朔夜说过，]@[textBlack:就算是PROMISED BLOOD的成员]@[textBlack:你也会一一询问，看来是真的啊」]",
