        "chara": [
          {
            "id": 304401,
            "voiceFullAuto": "fullvoice/section_102802/vo_full_102802-22-64"
          }
        ],
        "progressNarration": "[textBlack:「而且，我还伤害了玲奈]@[textBlack:所以如果我们都能活下来]@[textBlack:我就必须好好向她道歉才行」]"
      },
      {
        "chara": [
          {
            "id": 304401,
            "motion": 300,
            "voiceFullAuto": "fullvoice/section_102802/vo_full_102802-22-65"
          }
