                "narrationCoverOpacity": 0,
                "narrationEffect": "in",
                "narrationHAlignment": "left",
                "narrationPosX": 150,
                "progressNarration": "[textBlack:『怖がってる場合じゃない！』]@[textBlack:って、あの時の私に怒鳴ってやりたくなる。]@[textBlack:望まない状況を現実にしないために]@[textBlack:頑張るんじゃなかったのって諭したくなる…。]",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-16"
            },
            {
                "progressNarration": "[textBlack:だけど、今さら後悔しても仕方ないし、]@[textBlack:鬱屈とするぐらいなら、]@[textBlack:過去を反省した方がいいこともわかってる…。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-17"
            },
            {
                "progressNarration": "[textBlack:だから、今一度さかのぼってみよう。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-18"
            },
            {
                "progressNarration": "[textBlack:いろはさんたちが動いて、]@[textBlack:令さんやアリナさんたちが動いて、]@[textBlack:紅晴さんたちが動いて、]@[textBlack:静香さんたちが動いていて]@[textBlack:ひめなさんたちも動き出した…。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-19"
            },
            {
                "progressNarration": "[textBlack:あの戻れなくなった時間に…。]",
