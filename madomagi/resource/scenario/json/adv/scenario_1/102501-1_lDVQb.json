                "narrationHAlignment": "left",
                "narrationPosX": 150,
                "progressNarration": "[textBlack:言葉にできないような暗い感情が]@[textBlack:私の中を満たしている。]",
                "turnChangeOut": "fadeOut",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-1"
            },
            {
                "progressNarration": "[textBlack:おかげで頭には靄がかかったようで]@[textBlack:いまだにしっかりと働かない。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-2"
            },
            {
                "progressNarration": "[textBlack:原因は私のせい。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-3"
            },
            {
                "progressNarration": "[textBlack:自分の気持ちを理解しているのに]@[textBlack:受け入れようとせず]@[textBlack:現実からも目を背けて逃げているからだ…。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-4"
            },
            {
                "progressNarration": "[textBlack:…思い返せば、事の始まりは今から少し前。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-5"
            },
            {
                "progressNarration": "[textBlack:いろはさんたちが、ういちゃんを助けて、]@[textBlack:プロミストブラッドのみんなが]@[textYellow:キモチ][textBlack:の石を２つ手に入れた時のこと。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-6"
            },
            {
                "progressNarration": "[textBlack:あの頃の私は、]@[textBlack:灯花ちゃんとねむちゃんの力を借りて、]@[textBlack:自分が纏めたものを令さんの写真と一緒に]@[textBlack:発信しようとしていた。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-7"
            },
            {
                "progressNarration": "[textBlack:残された][textYellow:キモチ][textBlack:の石が“残り２つ”になって、]@[textBlack:もうすぐ奪い合いが始まるのを予感しながら、]@[textBlack:焦る気持ちを抑えて…。]",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-8"
            },
            {
