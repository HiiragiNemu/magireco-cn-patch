            "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-9"
          }
        ],
        "nameCenter": "笼目",
        "textCenter": "哈啊…@[textYellow:心魔]石总共有八个…",
        "turnChangeOut": "fadeOut"
      },
      {
        "chara": [
          {
            "eyeClose": 0,
            "id": 102001,
            "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-10"
          }
        ],
        "nameCenter": "笼目",
        "textCenter": "其它办法都没有用，所以一定会变成相互争夺的局面吧…"
      },
      {
        "chara": [
          {
            "id": 102001,
            "lipSynch": 0,
            "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-11"
          }
        ],
        "nameCenter": "小阿鲁",
        "textCenter": "＜你是在担心大家吗…？＞"
      },
      {
        "chara": [
          {
            "id": 102001,
            "lipSynch": 1,
            "motion": 0,
            "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-12"
          }
        ],
        "nameCenter": "笼目",
        "textCenter": "嗯，但是…"
      },
      {
        "chara": [
          {
            "eyeClose": 1,
            "id": 102001,
            "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-13"
          }
        ],
        "nameCenter": "笼目",
        "textCenter": "现在在担心的是能不能@追得上大家…毕竟我不强…"
      },
      {
        "nameNarration": "笼目",
        "narrationEffect": "in",
        "narrationHAlignment": "left",
        "narrationPosX": 150,
        "progressNarration": "但是，那时候的我已经见过了无数次@魔法少女的战斗，并害怕着那样的事情。",
        "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-14"
      },
      {
        "progressNarration": "就算有身为谣的小莉在，@我也一直在不安着，@自己什么时候是不是也会被卷进去。",
        "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-15"
      },
      {
        "autoTurnLast": 0.01,
        "bg": "black",
        "item": [
          {
            "iPhoneXScale": 1,
            "path": "resource/scenario/img/51030_fishing_homura/51030_homura_dairy.jpg",
            "posX": 0,
