            {
                "chara": [
                    {
                        "eyeClose": 1,
                        "id": 102001,
                        "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-13"
                    }
                ],
                "nameCenter": "笼目",
                "textCenter": "现在在担心的是能不能@追得上大家…毕竟我不强…"
            },
            {
                "nameNarration": "笼目",
                "narrationEffect": "in",
                "narrationHAlignment": "left",
                "narrationPosX": 150,
                "progressNarration": "だけど、あの時の私は、@魔法少女の戦いを何度も見て怖がっていた。",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-14"
            },
            {
                "progressNarration": "ウワサのリィちゃんがいたとしても、@いつか私も巻き込まれてしまうんだろうって@不安になっていた。",
                "voiceFullAuto": "fullvoice/section_102501/vo_full_102501-1-15"
            },
            {
