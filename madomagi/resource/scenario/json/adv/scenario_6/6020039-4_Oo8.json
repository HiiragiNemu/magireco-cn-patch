{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_18101.jpg","bgm":"bgm01_anime03","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":305201,"motion":400}],"nameCenter":"阿什莉·泰勒","textCenter":"啊！你们两个也要参加@比赛吗？","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305201}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300601,"motion":100,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":303101,"motion":0,"pos":0}],"nameLeft":"绫野梨花","nameRight":"木崎衣美里","textRight":"对呀！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":303101,"motion":100}],"textLeft":"不过我们不是冲着冠军来的……@就想开开心心玩一场。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300601,"motion":1}],"textRight":"是啊！既然人都来了，@当然得把所有项目都玩个够吧！"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":1,"pos":0}],"nameLeft":"阿什莉·泰勒","textLeft":"没错，衣美里！@最重要的就是开心！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":303101,"motion":1,"pos":2}],"nameRight":"绫野梨花","textRight":"阿什打算夺冠吗？"},{"chara":[{"id":303101}],"textRight":"奖品就是你喜欢的那个@设计师的衣服，对吧？"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":200}],"textLeft":"没错！我绝对会拿下第一名。@你们等着瞧！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300601,"motion":200,"pos":2}],"nameRight":"木崎衣美里","textRight":"哇，厉害！@弄得我也开始兴奋起来了！"},{"autoTurnLast":0.01,"bg":"bg_adv_narration.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":303101,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_011.exp.json","id":300601,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":303101,"motion":100},{"id":300601,"motion":100}],"nameNarration":"阿什莉·泰勒","narration":"这两位可爱时尚达人@就是梨花和衣美里。@我们在荣区的一家店里认识，@一见面就特别合得来。@和她们聊穿搭总是超开心！","narrationBg":"","narrationCoverOpacity":110,"narrationEffect":"in","turnChangeOut":"fadeOut"},{"autoTurnLast":0.01,"bg":"bg_adv_18101.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":305201,"motion":400}],"nameCenter":"阿什莉·泰勒","narrationEffect":"out","textCenter":"对了，差点忘记！@我也给你们俩挑了推荐款！","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":0}],"textCenter":"跟我来！"},{"autoTurnLast":0.01,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":303101,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_011.exp.json","id":300601,"motion":0,"pos":2}],"turnChangeIn":"rollInFast"},{"chara":[{"id":300601,"motion":400}],"nameLeft":"绫野梨花","nameRight":"木崎衣美里","textRight":"不愧是阿什！@每次推荐的搭配都超棒！","turnChangeOut":"rollOutFast"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":303101,"motion":400}],"textLeft":"每一件都好——可爱！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300601},{"effect":"fadeout","id":303101}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":305201,"motion":1,"pos":1}],"nameCenter":"阿什莉·泰勒","textCenter":"嗯？"},{"chara":[{"id":305201}],"textCenter":"这里的东西也不见了？@难道又卖光了？"},{"autoTurnLast":0.2,"chara":[{"id":305201,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":801000,"motion":0,"pos":0}],"nameLeft":"","nameRight":"阿什莉·泰勒","textRight":"不好意思！"},{"chara":[{"id":305201}],"textRight":"那边那些不同颜色的背带裤，@已经有人买走了吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":801000}],"textLeft":"背带裤……哦，是那些啊！@说起来，它们怎么不见了？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":801000}],"textLeft":"每笔生意我不可能都记得，@既然没了，应该就是卖出去了吧！"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305201,"motion":300}],"textRight":"又卖光了……太可惜了！"},{"autoTurnLast":0.2,"chara":[{"id":305201,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":303101,"motion":1,"pos":2}],"nameLeft":"阿什莉·泰勒","nameRight":"绫野梨花","textRight":"你本来想买什么？"},{"chara":[{"id":305201,"motion":0}],"textLeft":"不同颜色的同款背带裤……@我想给你们搭成姐妹装！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300601,"motion":0,"pos":2}],"nameRight":"木崎衣美里","textRight":"我和梨花？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300601,"motion":100}],"textRight":"天哪！也太棒了吧！@光是想想就觉得超好玩！"},{"chara":[{"cheek":2,"face":"mtn_ex_010.exp.json","id":305201,"motion":400}],"textLeft":"对吧？！"},{"chara":[{"cheek":2,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201}],"textLeft":"稍等一下哦，@我马上给你们重新搭一套。"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":300601}],"textClear":1},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp.json","id":305201,"lipSynch":0,"motion":0,"pos":1}],"nameCenter":"阿什莉·泰勒","textCenter":"……"},{"chara":[{"cheek":2,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":1}],"nameNarration":"阿什莉·泰勒","narration":"完成！@上衣选同款……@重点来了！@用同一种牛仔布做的短裤和短裙，@这样就既相配又各有特色！","narrationBg":"","narrationCoverOpacity":110,"narrationEffect":"in"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":305201}],"narrationEffect":"out","textClear":1},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":303101,"motion":100,"pos":0},{"cheek":1,"face":"mtn_ex_011.exp.json","id":300601,"motion":1,"pos":2}],"nameLeft":"绫野梨花","nameRight":"木崎衣美里","textLeft":"哇！也太可爱了！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":303101}],"textLeft":"我们穿着这样的姐妹装@一起去游乐园，肯定很可爱吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300601,"motion":200}],"textRight":"真的吗？我超喜欢这个主意！@感觉一定特别好玩！"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":305201,"motion":100,"pos":0}],"nameLeft":"阿什莉·泰勒","textLeft":"太好啦！穿上这套，@你们就是清爽活力的学生风！"},{"chara":[{"id":300601,"motion":0}],"textRight":"你自己不买吗？"},{"chara":[{"id":305201,"motion":0}],"textLeft":"这个嘛……"},{"chara":[{"cheek":2,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":200}],"textLeft":"啊，对了！我要买这个发圈！@拿来参加比赛正合适。"},{"chara":[{"cheek":2,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305201}],"textLeft":"看，还有其他颜色的@同款发圈！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":303101,"motion":200,"pos":2}],"nameRight":"绫野梨花","textRight":"你要和熊乃介配成同款吗？"},{"chara":[{"cheek":2,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":300}],"textLeft":"哇，这主意太棒了！"},{"chara":[{"id":305201}],"textLeft":"我本来就想给理子买个纪念品，@所以想着和她用同款……"},{"chara":[{"cheek":2,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":305201,"motion":400}],"textLeft":"[chara:305201:effect_emotion_joy_0][se:7222_happy]可是如果我、理子和熊乃介都戴同款，@那简直可爱到犯规！"},{"autoTurnLast":2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":303101,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300601,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":305201}],"nameCenter":"绫野梨花","nameLeft":"阿什莉·泰勒","nameRight":"木崎衣美里","textLeft":"离比赛开始还有点时间……@我要去给造型做最后调整！","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":303101,"motion":400}],"textCenter":"加油！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300601,"motion":100}],"textRight":"好！我们也要拼尽全力！"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":305201}],"textClear":1},{"autoTurnLast":0.2,"chara":[{"id":303101,"motion":0,"pos":0}]},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300601,"motion":200}],"textRight":"好了！我们也差不多该……[chara:300601:lipSynch_0][wait:0.8][chara:300601:motion_300][chara:101700:cheek_0][chara:300601:face_mtn_ex_050.exp.json][chara:300601:lipSynch_1]我的天哪！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":303101,"motion":0}],"nameLeft":"绫野梨花","textLeft":"怎么了？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300601,"motion":0}],"textRight":"梨梨！快看那边！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":303101,"motion":200}],"textLeft":"哦，对！我们走！"},{"nameNarration":"","narration":"＜距离旧衣搭配大赛开始@还有一小时。＞","narrationBg":"bg_adv_18101.jpg","narrationEffect":"in","turnChangeIn":"fadeIn","turnChangeOut":"fadeOut"},{"autoTurnLast":2,"narrationEffect":"out","turnChangeIn