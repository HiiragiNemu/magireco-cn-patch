{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_18101.jpg","bgm":"bgm01_anime03","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":302301,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_011.exp.json","id":301601,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_000.exp.json","id":302901,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":301601,"motion":100}],"nameCenter":"粟根心","textCenter":"啊！阿什，你也来了！","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":302301},{"effect":"fadeout","id":301601},{"effect":"fadeout","id":302901}],"textClear":1},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":0,"pos":1}],"nameCenter":"阿什莉·泰勒","textCenter":"心！还有爱实、真良……@你们都来了！"},{"autoTurnLast":0.01,"bg":"bg_adv_narration.jpg","chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":302301,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":301601,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_000.exp.json","id":302901,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":302301,"motion":200},{"id":302901,"motion":200}],"nameNarration":"阿什莉·泰勒","narration":"她们三个都是中央学园的魔法少女。@我因为心亲手做的可爱蕾丝饰品@认识了她们！","narrationBg":"","narrationCoverOpacity":110,"narrationEffect":"in","turnChangeOut":"fadeOut"},{"autoTurnLast":0.01,"bg":"bg_adv_18101.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":302301,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_011.exp.json","id":301601,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":301601}],"nameLeft":"江利爱实","nameRight":"粟根心","narrationEffect":"out","textRight":"谢谢你邀请我们！@淘旧衣的活动真的很有趣。","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":302301,"motion":100}],"textLeft":"是啊，我平时只关注喜欢的品牌，@所以这里的一切都很新鲜。"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":100,"pos":0}],"nameLeft":"阿什莉·泰勒","textLeft":"听你这么说，我好开心！"},{"chara":[{"eyeClose":0,"id":305201,"motion":0}],"textLeft":"真良呢？玩得开心吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":302901,"motion":300,"pos":2}],"nameRight":"加贺见真良","textRight":"我不确定这算不算“开心”，@但我也不想马上回去。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":301601,"motion":200,"pos":0}],"nameLeft":"粟根心","textLeft":"那应该就是玩得开心吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":302301,"motion":1,"pos":0}],"nameLeft":"江利爱实","textLeft":"如果完全没兴趣，@你一开始也不会来。"},{"chara":[{"id":302901,"motion":200}],"textRight":"真正让我感兴趣的是……"},{"chara":[{"id":302901}],"textRight":"阿什莉如此着迷的“可爱”，@究竟是什么。"},{"chara":[{"cheek":2,"face":"mtn_ex_010.exp.json","id":305201,"motion":200,"pos":0}],"nameLeft":"阿什莉·泰勒","textLeft":"啊，对了！我刚才逛的时候@找到了一些想给你们看的可爱衣服！"},{"chara":[{"cheek":2,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201}],"textLeft":"现在就让你们见识一下@只属于我的“可爱”风格！"},{"autoTurnLast":0.01,"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":1,"pos":1}],"turnChangeIn":"rollInFast"},{"nameNarration":"阿什莉·泰勒","narration":"先从心开始！@高腰伞裙，配合身的白色衬衫！@重点是裙子上的蝴蝶结！@不张扬，却很有存在感，@华丽得恰到好处！","narrationBg":"","narrationCoverOpacity":110,"narrationEffect":"in","turnChangeOut":"rollOutFast"},{"autoTurnLast":0.2,"chara":[{"id":305201,"pos":0}],"narrationEffect":"out","textClear":1},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":301601,"motion":400,"pos":2}],"nameLeft":"阿什莉·泰勒","nameRight":"粟根心","textRight":"哇！好可爱……也很成熟呢。"},{"chara":[{"id":305201,"motion":100}],"textLeft":"穿去稍微高档一点的@餐厅再合适不过了。"},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":301601,"motion":0}],"textRight":"下次和家人出去吃饭时@我会试着穿的。谢谢！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":301601}],"textClear":1},{"chara":[{"id":305201},{"cheek":1,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":400,"pos":1}],"nameNarration":"阿什莉·泰勒","narration":"接下来是我给爱实挑的！@这套甜美风穿去约会再合适不过！@荷叶边和蕾丝很多，@但沉稳的配色又很优雅，@正好让你换个全新的形象！","narrationBg":"","narrationCoverOpacity":110,"narrationEffect":"in"},{"autoTurnLast":0.2,"chara":[{"id":305201,"pos":0}],"narrationEffect":"out","textClear":1},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":302301,"motion":100,"pos":2}],"nameRight":"江利爱实","textRight":"[chara:302301:effect_emotion_joy_0][se:7222_happy]好可爱！[chara:302301:lipSynch_0][wait:0.8][chara:302301:eyeClose_1][chara:302301:cheek_2][chara:302301:face_mtn_ex_010.exp.json][chara:302301:lipSynch_1]只要穿上这套，隼人@肯定就会……嘿……嘿嘿嘿……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":305201,"motion":0}],"textLeft":"呃……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":301601,"motion":300,"pos":2}],"nameRight":"粟根心","textRight":"等她一下，她很快就会回过神来。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":200},{"cheek":0,"face":"mtn_ex_000.exp.json","id":302901,"motion":0,"pos":2}],"textLeft":"总、总之，最后是真良！"},{"chara":[{"cheek":2,"face":"mtn_ex_010.exp.json","id":305201,"motion":0}],"textLeft":"这只是我的个人偏好，不过……[chara:305201:lipSynch_0][wait:0.8][chara:101700:cheek_2][chara:305201:face_mtn_ex_011.exp.json][chara:305201:eyeClose_1][chara:305201:lipSynch_1]@我给你挑了条纯白连衣裙！"},{"chara":[{"id":302901,"motion":100}],"nameRight":"加贺见真良","textRight":"为什么？"},{"chara":[{"cheek":2,"eyeClose":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":400}],"textLeft":"因为特别适合你！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":301601,"motion":100,"pos":2}],"nameRight":"粟根心","textRight":"我懂她的意思。[chara:301601:lipSynch_0][wait:0.8][chara:301601:cheek_0][chara:301601:face_mtn_ex_011.exp.json][chara:301601:lipSynch_1]爱实，你也懂吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":302301,"motion":400,"pos":0}],"nameLeft":"江利爱实","textLeft":"[chara:302301:effect_emotion_surprise_0][se:7226_shock]……唔？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":302301,"motion":200}],"textLeft":"对、对呀！真良穿白色连衣裙@一定会特别好看。"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp.json","id":302901,"motion":300,"pos":2}],"nameRight":"加贺见真良","textRight":"原来如此，这就是大家眼中的@“可爱”吗……"},{"chara":[{"eyeClose":0,"id":302901}],"textRight":"那我就试穿看看。"},{"autoTurnLast":0.2,"chara":[{"id":302301,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":302301,"motion":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":0,"pos":0}],"nameRight":"江利爱实","textRight":"阿什，你不买点自己的衣服吗？"},{"chara":[{"id":305201,"motion":1}],"nameLeft":"阿什莉·泰勒","textLeft":"还没呢！我本来想从@这家摊位买条连衣裙……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305201}],"textLeft":"可刚才逛的时候，@我一直拿不定主意选哪件……"},{"chara":[{"id":302301,"motion":1}],"textRight":"左边那件很可爱吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":301601,"motion":0,"pos":2}],"nameRight":"粟根心","textRight":"嗯，而且还是你最喜欢的颜色！"},{"chara":[{"cheek":2,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":100}],"textLeft":"既然你们两个都推荐，@那我就买这件！"},{"autoTurnLast":2,"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305201,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":301601,"motion":1,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":305201}],"nameLeft":"阿什莉·泰勒","nameRight":"粟根心","textLeft":"好啦，接下来我得先失陪了。","turnChangeOut":"fadeOut"},{"chara":[{"id":305201,"motion":200}],"textLeft":"想夺冠的话，@我必须把参赛造型搭配到完美！"},{"chara":[{"id":301601}],"textRight":"咦？阿什也要参加@旧衣搭配大赛吗？"},{"chara":[{"cheek":1,"eyeClose":1,"face":"mtn_ex_011.exp.json","id":305201,"motion":100}],"textLeft":"没错！冠军我志在必得！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":302301,"motion":100,"pos":2}],"nameRight":"江利爱实","textRight":"哇！那你加油！"},{"chara":[{"id":305201,"motion":400}],"textLeft":"谢——谢——！[chara:305201:lipSynch_0][wait:0.8][chara:101700:cheek_1][chara:305201:face_mtn_ex_010.exp.json][chara:305201:eyeClose_0][chara:305201:lipSynch_1]我出发啦！"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":305201}],"textClear":1},{"autoTurnLast":0.2,"chara":[{"id":302301,"motion":0,"pos":0}]},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":302901,"lipSynch":0,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":301601,"motion":0,"pos":1}],"nameCenter":"粟根心","nameLeft":"江利爱实","nameRight":"加贺见真良","textRight":"……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":301601,"motion":100}],"textCenter":"你在看什么？"},{"chara":[{"id":302901,"motion":100}],"textRight":"这个。我觉得……阿什莉会喜欢。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":302301,"motion":200}],"textLeft":"真的！这也太可爱了吧！"},{"nameNarration":"","narration":"＜距离旧衣搭配大赛开始@还有三小时。＞","narrationBg":"bg_adv_18101.jpg","narrationEffect":"in","turnChangeIn":"fadeIn","turnChangeOut":"fadeOut"},{"autoTurnLast":2,"narrationEffect":"out","turnChangeIn":"fadeIn"}]},"version":3}
