{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":801501,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305801,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"bgm":"bgm23_tokime02","chara":[{"id":801501}],"nameRight":"水德寺的住持","textRight":"……嗯，有事想和老衲商量？","turnChangeOut":"fadeOut"},{"chara":[{"id":305801,"motion":100}],"nameLeft":"南津凉子","textLeft":"对！@是爷爷拜托我的。"},{"chara":[{"id":801501}],"nameRight":"水德寺的住持","textRight":"是净安寺的住持？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305801,"motion":1}],"nameLeft":"南津凉子","textLeft":"是啊。@想请您替这些东西做个供养……"},{"chara":[{"id":801501}],"nameRight":"水德寺的住持","textRight":"看起来是女子的旧衣服啊。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305801}],"nameLeft":"南津凉子","textLeft":"整理家里的寺院时，@翻出了妈妈的遗物。"},{"chara":[{"id":305801}],"nameLeft":"南津凉子","textLeft":"可爷爷说，我们寺院@不做遗物供养，"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":801501}],"nameRight":"水德寺的住持","textRight":"原来如此，是想请老衲焚化供养。@嗯，老衲答应了。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":801501}],"nameRight":"水德寺的住持","textRight":"嗯……这里面好像还有@连价签都没摘的东西……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305801,"motion":300,"pos":0}],"nameLeft":"南津凉子","textLeft":"啊，你说这件？"},{"chara":[{"id":305801}],"nameLeft":"南津凉子","textLeft":"就是穿在泳衣外面的@上衣……"},{"chara":[{"id":305801}],"nameLeft":"南津凉子","textLeft":"类似T恤的那种。"},{"chara":[{"cheek":0,"face":"mtn_ex_012.exp3.json","id":305801,"motion":100}],"nameLeft":"南津凉子","textLeft":"她本来好像打算@穿着去打沙滩网球。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":801501}],"nameRight":"水德寺的住持","textRight":"这样啊……结果，@还是没机会穿上呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":801501}],"nameRight":"水德寺的住持","textRight":"连没穿过的新衣服也拿来供养，@老衲觉得似乎有些不妥。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":305801,"motion":300}],"nameLeft":"南津凉子","textLeft":"是这样啊……"},{"chara":[{"id":305801}],"nameLeft":"南津凉子","textLeft":"既没老化掉粉，@也没变得破破烂烂的，"},{