102701,"motion":200,"pos":2}],"nameRight":"沙绪","textRight":"是的……！@我们两个就够了。"},{"chara":[{"id":102501,"motion":0}],"nameLeft":"静香","textLeft":"是吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701}],"nameRight":"沙绪","textRight":"嗯……！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102501},{"effect":"fadeout","id":102701}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":200,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"nameLeft":"千春","textLeft":"夏希，@静香就拜托你了。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":100,"pos":2}],"nameRight":"空穗夏希","textRight":"好的，交给我吧！"},{"autoTurnLast":2,"bg":"bg_adv_18054.jpg","bgm":"stop","chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":1,"pos":2}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story19","chara":[{"id":102501,"motion":400}],"nameLeft":"静香","textLeft":"哇……@能看见大海呢！","turnChangeOut":"fadeOut"},{"chara":[{"id":300201,"motion":0}],"nameRight":"空穗夏希","textRight":"果然很少有机会看见吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":1}],"nameLeft":"静香","textLeft":"是啊！@我们村子在山里嘛。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501}],"nameLeft":"静香","textLeft":"而且，来到神滨以后，@也很少有机会来南凪……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501}],"nameLeft":"静香","textLeft":"不管看几次，都觉得很新鲜！"},{"autoTurnLast":1,"bg":"bg_adv_13131.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0,"pos":2}],"turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"你知道约会对象@有什么喜好吗？","turnChangeOut":"fadeOut"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"一直都在身边，@我想多少还是了解的。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":200}],"nameRight":"空穗夏希","textRight":"这样啊……！"},{"chara":[{"id":300201,"lipSynch":0}],"nameRight":"空穗夏希","textRight":"（也就是说，是从小定下的婚约？@不愧是一族的本家……！）"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":300}],"nameLeft":"静香","textLeft":"唔……@不过，让我想想……"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"带去人多的地方，@大概会吓一跳……"},{"chara":[{"eyeClose":1,"id":102501}],"nameLeft":"静香","textLeft":"到处都是摩天楼的地方，@应该也不太习惯……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":300}],"nameRight":"空穗夏希","textRight":"摩天……？@……是指大楼吧。"},{"chara":[{"eyeClose":0,"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"可是，带去@自然风光多的地方，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"又会觉得@跟没来神滨一样……"},{"chara":[{"id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"真难办呢……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201}],"nameRight":"空穗夏希","textRight":"……啊，@大海怎么样？"},{"autoTurnLast":1,"bg":"bg_adv_18054.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":1,"pos":2}],"turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":300201}],"nameRight":"空穗夏希","textRight":"会喜欢这里吗？","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":100}],"nameLeft":"静香","textLeft":"嗯，一定会的！@我都能想象到那副开心的样子。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":100}],"nameRight":"空穗夏希","textRight":"呵呵，@你们感情真好呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501}],"nameLeft":"静香","textLeft":"……还好啦。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":300201,"motion":0}],"nameRight":"空穗夏希","textRight":"说起来，@对方是个什么样的人呢？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"咦……什么样……？@[chara:102501:lipSynch_0][wait:0.8][chara:102501:cheek_0][chara:102501:face_mtn_ex_030.exp.json][chara:102501:lipSynch_1]我还真没怎么想过……"},{"chara":[{"cheek":0,"eyeClose":1,"