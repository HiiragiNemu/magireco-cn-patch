{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13131.jpg","bgm":"bgm01_anime03","chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":300201,"motion":1,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":300201}],"nameCenter":"空穗夏希","textCenter":"你们好——！","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"id":300201,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"……咦，夏希？@你怎么来了？"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102501},{"effect":"fadeout","id":300201}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":100,"pos":2},{"cheek":0,"face":"mtn_ex_030.exp.json","id":102601,"motion":300,"pos":0}],"nameRight":"沙绪","textRight":"是我们请她来的。"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"说到神滨的事情，@我想还是神滨本地人更熟悉。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701}],"nameRight":"沙绪","textRight":"对吧，小千？"},{"chara":[{"id":102601,"lipSynch":0}],"nameLeft":"千春","textLeft":"…………[wait:0.8][chara:102601:lipSynch_1]嗯。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"原来如此。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":300,"pos":2}],"nameRight":"空穗夏希","textRight":"那个……你看起来@好像没什么精神……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102701,"motion":300,"pos":0}],"nameLeft":"沙绪","textLeft":"啊，小千她……@那个，昨天……"},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp.json","id":102601,"motion":200,"pos":0}],"nameLeft":"千春","textLeft":"我被拒绝了啦……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":300201,"motion":400}],"nameRight":"空穗夏希","textRight":"[chara:300201:effect_emotion_surprise_0][se:7226_shock]咦……！？"},{"chara":[{"eyeClose":1,"id":102601,"motion":300}],"nameLeft":"千春","textLeft":"我也@好想去约会啊……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":300201,"motion":300}],"nameRight":"空穗夏希","textRight":"那可真是……那个……"},{"chara":[{