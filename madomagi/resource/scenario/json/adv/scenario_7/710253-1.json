{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_001.exp3.json","id":102601,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm23_tokime02","chara":[{"id":102601,"motion":300}],"nameCenter":"千春","textCenter":"唔唔唔～","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"eyeClose":0,"id":102601,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":1,"pos":2}],"nameRight":"沙绪","textRight":"小千，怎么了？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":200,"pos":2}],"nameRight":"静香","textRight":"说起来，你在看什么呢？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102601,"motion":1}],"nameLeft":"千春","textLeft":"是小纱奈@为静香画的那本绘本呀。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"就是为了让静香清醒过来，@我们在她心里演过的那个故事呢。"},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/3003_act_stage.ExportJson","zOrder":"messageBack"}],"autoTurnLast":1,"bg":"bg_adv_50016.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102602,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"autoTurnLast":2,"turnChangeOut":"fadeOut"},{"autoTurnLast":1,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102701,"motion":1,"pos":2}],"deleteArmatureList":[1],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"motion":300}],"nameLeft":"静香","textLeft":"唔……虽然是很重要的回忆，@但提起来还是让我有些难受呢。","turnChangeOut":"fadeOut"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"我们也一样……什么是恶，@什么是善……让人想了很多。"},{"autoTurnLast":0.2,"chara":[{"id":102501,"motion":1,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102601,"motion":0,"pos":0}],"nameRight":"静香","textRight":"……所以，小千，@你重读这个故事，在烦恼什么呢？"},{"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":102601,"pos":0}],"nameLeft":"千春","textLeft":"也不是什么大事啦，@就是有点在意这之后发生了什么。"},{"autoTurnLast":1,"item":[{"iPhoneXScale":1,"path":"resource/scenario/img/51030_fishing_homura/51030_yu_dairy.jpg","posX":0,"posY":0,"visible":"appear","zOrder":"bgFront"}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"季节更替，春天到来时，@小鸟离开了小镇，@约定明年还会再来。","narrationEffect":"in","turnChangeOut":"fadeOut"},{"nameNarration":"","narration":"望着那个渐渐远去的身影，@乌龟在心中许下了诺言：@下次小鸟来小镇之前，@要和老虎一起学会把温柔带给别人。"},{"autoTurnLast":1,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102601,"motion":0,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"的确，小鸟离开小镇以后，@乌龟它们会怎么样呢？","turnChangeOut":"fadeOut"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"老虎应该会向大家@报恩、赎罪吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102601,"motion":200}],"nameCenter":"千春","textCenter":"小鸟在离开小镇之前，@肯定也会做些什么……"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102701},{"effect":"fadeout","id":102601}],"textClear":1},{"autoTurnLast":0.2,"chara":[{"id":102501,"pos":1}],"textClear":1},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp3.json","id":102501,"lipSynch":0,"motion":1}],"nameCenter":"静香","textCenter":"（老虎的话……）"},{"autoTurnLast":0.2,"bgm":"stop","textClear":1},{"autoTurnLast":2,"bg":"bg_adv_50016.jpg","chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":102502,"motion":0,"pos":1}],"turnChangeIn":"fadeIn","turnChangeInTime":1,"turnEffect":"ef_adv_10"},{"bgm":"bgm23_tokime01","nameNarration":"","narration":"这是发生在远离人类城镇的地方，@一个动物们生活的世界里的故事。","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"老虎曾为了家人抢夺镇上的食物，@为此受了罚……后来，它得到了宽恕和救助，@开始和大家一起在镇上生活。@不过，它有一件烦心事。"},{"narration":"那就是，该怎样和镇上的大家相处。"},{"narration":"虽然温柔的小鸟救了老虎，@但要和镇上的居民们交好，@还是没那么容易。"},{"narration":"于是，老虎决定向镇上的大家赎罪，@也报答大家愿意让自己住下来的恩情。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":300}],"nameCenter":"静香","narrationEffect":"out","textCenter":"……可是，@做些什么才好呢……"},{"chara":[{"id":102502}],"nameCenter":"静香","textCenter":"打猎，把食物还给大家……@只做这些，本来就是应该的。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102502,"motion":400}],"nameCenter":"静香","textCenter":"……有了！"},{"chara":[{"id":102502}],"nameCenter":"静香","textCenter":"做些热乎乎的饭菜，@请大家吃吧！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102502}],"nameCenter":"静香","textCenter":"因为温暖的东西，@也能让心暖起来。"},{"chara":[{"id":102502}],"nameNarration":"","narration":"老虎想起自己快冻僵时，@小鸟曾用羽毛替自己取暖，@于是作出了这个决定。@可是，还有一个问题。","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in"},{"autoTurnLast":0.01,"bg":"bg_adv_19305.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102502,"motion":0,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102502}],"nameCenter":"静香","textCenter":"猎物已经打回来了，@一切准备就绪……不过，","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502}],"nameCenter":"静香","textCenter":"大家……@都喜欢吃什么样的菜呢？"},{"nameNarration":"","narration":"老虎还没和大家熟悉起来，@不知道镇上的居民们喜欢吃什么。","narrationBg":"bg_adv_19305.jpg","narrationEffect":"in"},{"narration":"老虎本想偷偷准备好一切，@可还是决定去和小鸟商量。"},{"autoTurnLast":0.5,"bg":"bg_adv_50016.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102602,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_000.exp3.json","id":102502,"motion":1,"pos":0}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102602}],"nameRight":"千春","textRight":"大家都喜欢的，@热乎乎的食物啊……","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102602}],"nameRight":"千春","textRight":"我也刚来这里不久，@不过，看大家常常吃火锅吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102502,"motion":100}],"nameLeft":"静香","textLeft":"火锅……这个的话，@也许我也做得来……！"},{"nameNarration":"","narration":"听了小鸟的话，老虎立刻动手做了起来，@可是……","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in"},{"autoTurnLast":0.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":0,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102502,"motion":300}],"nameCenter":"静香","textCenter":"……怎么办，@味道总觉得淡淡的，差了点什么……","turnChangeOut":"fadeOut"},{"chara":[{"eyeClose":1,"id":102502,"motion":1}],"nameNarration":"","narration":"老虎平时只做三人份的饭菜，@第一次给这么多人做火锅，本就手忙脚乱，@又因为太想做好，处处使不上劲，@结果怎么也做不顺利。","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in"},{"chara":[{"id":102502}],"nameCenter":"静香","narrationEffect":"out","textCenter":"这样怎么能@向大家赎罪呢……"},{"chara":[{"id":102502,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102702,"motion":0,"pos":2}],"nameNarration":"","narration":"老虎正不知如何是好时，@乌龟闻着香味走了过来。","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in"},{"nameRight":"沙绪","narrationEffect":"out","textRight":"这个味道……@……你在做火锅吗？"},{"chara":[{"eyeClose":0,"id":102502,"motion":1}],"nameLeft":"静香","textLeft":"那个……我想向大家@赎罪，也想报恩。"},{"chara":[{"id":102502}],"nameLeft":"静香","textLeft":"可是味道总觉得不太对，@算不上好吃……"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102702,"motion":200}],"nameRight":"沙绪","textRight":"……让我看看。"},{"chara":[{"id":102702}],"nameRight":"沙绪","textRight":"……嗯，没关系，@只是缺了些食材。"},{"chara":[{"id":102702}],"nameRight":"沙绪","textRight":"要我帮忙吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502,"motion":0}],"nameLeft":"静香","textLeft":"咦？"},{"chara":[{"cheek":1,"id":102702,"motion":1}],"nameRight":"沙绪","textRight":"……我是说，@要我帮忙吗？"},{"chara":[{"id":102702}],"nameRight":"沙绪","textRight":"镇上的火锅需要放些特别的食材……@我来教你吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":200}],"nameLeft":"静香","textLeft":"可、可是，这是为了赎罪，@我得一个人做才行……"},{"chara":[{"eyeClose":1,"id":102702,"motion":100}],"nameRight":"沙绪","textRight":"……你已经是镇上的一员了，@而且也不能浪费这些食材呀。"},{"chara":[{"eyeClose":0,"id":102702}],"nameRight":"沙绪","textRight":"去蛇奶奶家，@要一些酒来吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502,"motion":100}],"nameLeft":"静香","textLeft":"好、好的！"},{"autoTurnLast":0.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102702,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102502,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102702}],"nameRight":"沙绪","textRight":"接下来，去狸猫爷爷家。","turnChangeOut":"fadeOut"},{"chara":[{"id":102502,"motion":200}],"nameLeft":"静香","textLeft":"我知道了！"},{"nameNarration":"","narration":"照着乌龟的吩咐，老虎跑了许多人家，@收集做火锅需要的食材。","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in"},{"narration":"老虎担心，自己曾经抢过镇上的食物，@大家还愿不愿意分给自己。@可是，早已闻到火锅香味的居民们，@都爽快地拿出了食物。"},{"autoTurnLast":0.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102702,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102502,"motion":0,"pos":0}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102702,"motion":100}],"nameRight":"沙绪","textRight":"好了，完成了！","turnChangeOut":"fadeOut"},{"chara":[{"id":102502}],"nameLeft":"静香","textLeft":"谢谢你，乌龟。@……嗯，好香啊。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":300},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102702}],"nameLeft":"静香","textLeft":"不过，我真是不争气呢。@明明是为了赎罪、报恩，"},{"chara":[{"id":102502}],"nameLeft":"静香","textLeft":"到头来，还是让乌龟@和镇上的大家帮了忙……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102602,"motion":0,"pos":2},{"id":102502,"motion":0}],"nameNarration":"","narration":"乌龟正想着该说些什么，@小鸟也闻着香味，@领着镇上的居民们走了过来。","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in"},{"chara":[{"id":102602,"motion":100}],"nameRight":"千春","narrationEffect":"out","textRight":"哇，好香！@这锅是老虎做的吗？"},{"chara":[{"id":102502,"motion":0}],"nameLeft":"静香","textLeft":"嗯，不过，@大半都是乌龟帮忙做的，"},{"chara":[{"id":102502}],"nameLeft":"静香","textLeft":"还多亏镇上的大家@分给我食物……"},{"chara":[{"eyeClose":1,"id":102502}],"nameLeft":"静香","textLeft":"……我是想@赎罪，也想报恩……"},{"chara":[{"eyeClose":0,"id":102502,"motion":1}],"nameLeft":"静香","textLeft":"那个……还是想再向大家说一声，@对不起。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":300,"pos":2}],"nameRight":"沙绪","textRight":"……要说该道歉的，@……我们也一样。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502,"motion":0}],"nameLeft":"静香","textLeft":"咦？"},{"chara":[{"eyeClose":1,"id":102702,"motion":0}],"nameRight":"沙绪","textRight":"以前你冻得发抖时，@我们也没有伸手帮你。"},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":102502,"motion":0},{"cheek":1,"face":"mtn_ex_010.exp3.json","id":102702,"motion":0,"pos":2}],"nameNarration":"","narration":"不知是谁说了一声“我们才该说对不起”，@老虎这才明白，大家愿意分给自己食物，@也是在用各自的方式弥补过去的过错。","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in"},{"chara":[{"eyeClose":0,"id":102702}],"narration":"大家没有互相说“别放在心上”，@而是一起说着“我开动了”，@吃起了火锅。"},{"narration":"“热乎乎的，真好吃呀。”@镇上的居民们一边说，@一边也给老虎盛了一份，大家一起吃了起来。"},{"chara":[{"id":102502,"motion":100},{"id":102702}],"nameLeft":"静香","narrationEffect":"out","textLeft":"呼……嗯，真好吃。@多亏了乌龟呢。"},{"chara":[{"eyeClose":1,"id":102702,"motion":300}],"nameRight":"沙绪","textRight":"老虎猎来的肉，@……也很好吃哦。"},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":102602,"motion":200,"pos":2}],"nameRight":"千春","textRight":"嗯！味道都煮进去了，@连心里都觉得暖乎乎的！"},{"nameNarration":"","narration":"老虎想，自己一定不会忘记，@那天吃到的火锅的滋味。","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in"},{"narration":"那一锅温暖了心的，@热乎乎的火锅。"},{"autoTurnLast":1.5,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":102501,"motion":0,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn","turnChangeInTime":1,"turnEffect":"stop"},{"chara":[{"id":102501,"lipSynch":0}],"nameCenter":"静香","textCenter":"（呵呵……大概就是这样吧。）","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"id":102501,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102501,"motion":100},{"cheek":0,"face":"mtn_ex_010.exp3.j