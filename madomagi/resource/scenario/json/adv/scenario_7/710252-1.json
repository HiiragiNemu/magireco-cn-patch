{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13141.jpg","bgm":"bgm01_anime03","chara":[{"cheek":2,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"motion":200}],"nameCenter":"静香","textCenter":"我、我说……大家真的都@穿成那样游泳吗？","turnChangeOut":"fadeOut"},{"chara":[{"cheek":2,"face":"mtn_ex_030.exp.json","id":102501}],"nameCenter":"静香","textCenter":"不会因为是电视，@所以夸张了些吧……？"},{"autoTurnLast":0.2,"chara":[{"id":102501,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":200,"pos":2}],"nameRight":"千春","textRight":"没有哦？@那就是游泳时穿的泳衣呀。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102701,"motion":1,"pos":2}],"nameRight":"沙绪","textRight":"原来静香@没有穿过泳衣呢……"},{"chara":[{"id":102501,"motion":300}],"nameLeft":"静香","textLeft":"那、那样的打扮……@怎么可能穿得出去呀……"},{"chara":[{"eyeClose":1,"id":102501}],"nameLeft":"静香","textLeft":"又、又不是内衣……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"motion":1,"pos":2}],"nameRight":"千春","textRight":"咦？@可是，你会游泳吧？"},{"chara":[{"id":102601}],"nameRight":"千春","textRight":"那你是穿什么游泳的……？@[chara:102601:lipSynch_0][wait:0.8][chara:102601:motion_400][chara:102601:lipSynch_1]难道……"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0}],"nameLeft":"静香","textLeft":"唔……有点难解释呢……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":100},{"id":102601,"motion":0}],"nameLeft":"静香","textLeft":"对了，刚才放过的@那个海女的节目，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"跟那种衣服比较像吧……？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"原来如此……@比泳衣遮得更多呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":0,"pos":2}],"nameRight":"千春","textRight":"机会难得，@静香也买件泳衣试试吧？"},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp.json","id":102501,"motion":400}],"nameLeft":"静香","textLeft":"……咦？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":100}],"nameRight":"千春","textRight":"有了泳衣，就能去海边@或者泳池玩了哦！"},{"chara":[{"cheek":2,"face":"mtn_ex_030.exp.json","id":102501,"motion":200}],"nameLeft":"静香","textLeft":"我要穿上那种泳衣……？@在大家面前……露出那么多……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":1}],"nameRight":"千春","textRight":"很普通呀，@我就穿过哦。"},{"chara":[{"id":102601}],"nameRight":"千春","textRight":"沙绪也穿过吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"当然，@我也穿过的。"},{"chara":[{"cheek":2,"face":"mtn_ex_050.exp.json","id":102501,"lipSynch":0,"motion":0}],"nameLeft":"静香","textLeft":"…………"},{"chara":[{"cheek":2,"face":"mtn_ex_030.exp.json","id":102501}],"nameLeft":"静香","textLeft":"……既然这样，@那就去看看吧……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":100,"pos":2}],"nameRight":"千春","textRight":"太好了……！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":200,"pos":2}],"nameRight":"沙绪","textRight":"这就出发吧。"},{"autoTurnLast":2,"bg":"bg_adv_21411.jpg","chara":[{"cheek":2,"face":"mtn_ex_030.exp.json","id":102551,"motion":1,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102551,"lipSynch":0}],"nameCenter":"静香","textCenter":"…………","turnChangeOut":"fadeOut"},{"chara":[{"eyeClose":1,"id":102551}],"nameCenter":"静香","textCenter":"那个……怎么样？"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102551}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701,"motion":100,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":0,"pos":0}],"nameRight":"沙绪","textRight":"特别好看哦。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":200}],"nameLeft":"千春","textLeft":"嗯！@很可爱！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":800600,"motion":0,"pos":2}],"nameRight":"","textRight":"是的，您身材这么苗条，@穿起来特别合适。"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102601},{"effect":"fadeout","id":800600}],"textClear":1},{"chara":[{"cheek":2,"face":"mtn_ex_050.exp.json","id":102551,"motion":300,"pos":1}],"nameCenter":"静香","textCenter":"是、是吗……？"},{"chara":[{"id":102551}],"nameCenter":"静香","textCenter":"既然大家都这么说，@那我就买下来吧……"},{"chara":[{"cheek":2,"face":"mtn_ex_030.exp.json","id":102551,"motion":200}],"nameCenter":"静香","textCenter":"可是，穿成这样走到大家面前，@果然还是……唔……"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102551}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":0,"pos":0}],"nameRight":"沙绪","textRight":"不如也穿给@族里的大家看看，怎么样？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701}],"nameRight":"沙绪","textRight":"这样应该能慢慢习惯，@大家也一定会夸你的。"},{"chara":[{"id":102601,"motion":200}],"nameLeft":"千春","textLeft":"有了自信，@应该就不会那么害羞了吧！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102601},{"effect":"fadeout","id":102701}],"textClear":1},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp.json","id":102551,"motion":0,"pos":1}],"nameCenter":"静香","textCenter":"……你们两个@穿泳衣都不会害羞吗……？"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102551}],"textClear":1},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp.json","id":102601,"motion":0,"pos":0},{"cheek":1,"face":"mtn_ex_050.exp.json","id":102701,"motion":0,"pos":2}],"nameCenter":"千春&沙绪","textCenter":"…………"},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp.json","id":102701,"motion":300}],"nameRight":"沙绪","textRight":"也不是完全@不会害羞啦……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":100}],"nameLeft":"千春","textLeft":"可是，在海边或者泳池，@大家都穿得差不多嘛！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102601},{"effect":"fadeout","id":102701}],"textClear":1},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp.json","id":102551,"motion":200,"pos":1}],"nameCenter":"静香","textCenter":"……这样啊。"},{"chara":[{"id":102551}],"nameCenter":"静香","textCenter":"既然你们两个都这么说，@那我就买下来吧……"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":102551,"motion":100}],"nameCenter":"静香","textCenter":"我也想去海边和泳池看看……"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102551}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":200,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":1,"pos":2}],"nameLeft":"千春","textLeft":"嗯嗯！@我觉得很好哦！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701,"motion":100}],"nameRight":"沙绪","textRight":"买下来吧……！"},{"autoTurnLast":2,"bg":"bg_adv_13141.jpg","bgm":"stop","chara":[{"cheek":2,"face":"mtn_ex_030.exp.json","id":102551,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102650,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102750,"motion":1,"pos":2}],"turnChangeIn":"fadeIn"},{"bgm":"bgm23_tokime02","chara":[{"id":102551,"motion":100}],"nameLeft":"静香","textLeft":"……怎么样？","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102650},{"effect":"fadeout","id":102750}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305801,"motion":1,"pos":2}],"nameRight":"南津凉子","textRight":"在那之前，@为什么要在这里穿泳衣……？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102650,"motion":1,"pos":0}],"nameLeft":"千春","textLeft":"因为静香她呀，"},{"chara":[{"id":102650}],"nameLeft":"千春","textLeft":"说自己没穿过泳衣，@我们就去买回来了。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102650,"motion":200,"pos":0}],"nameLeft":"千春","textLeft":"第一次穿泳衣！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102750,"motion":1,"pos":2}],"nameRight":"沙绪","textRight":"静香说，穿着泳衣@出现在大家面前会害羞，"},{"chara":[{"id":102750}],"nameRight":"沙绪","textRight":"所以，我们想先让她@在熟人面前习惯一下……"},{"chara":[{"cheek":2,"face":"mtn_ex_030.exp.json","id":102551,"motion":300,"pos":0}],"nameLeft":"静香","textLeft":"呜呜……@果然很奇怪吗……？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":305801,"motion":0,"pos":2}],"nameRight":"南津凉子","textRight":"没有，不奇怪。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":305801,"motion":100}],"nameRight":"南津凉子","textRight":"该怎么说呢……这