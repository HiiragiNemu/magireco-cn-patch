{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_20331.jpg","chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":104101,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"bgm":"bgm03_story21","chara":[{"id":104101}],"nameLeft":"莉薇娅","textLeft":"……真是的，夜鹤说有事要办，@到底跑哪儿去了？","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104101,"motion":300}],"nameLeft":"莉薇娅","textLeft":"再不早点去排队，@章鱼烧说不定就卖完了……"},{"nameRight":"夜鹤的声音","textRight":"……咦，老师，@您不买章鱼烧了吗？"},{"chara":[{"id":104101,"motion":200},{"cheek":0,"face":"mtn_ex_000.exp.json","id":104050,"motion":1,"pos":2}],"nameLeft":"莉薇娅","textLeft":"……可算来了。@让我等这么久，还说这种话……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":104101,"motion":400}],"nameLeft":"莉薇娅","textLeft":"[chara:104101:effect_emotion_surprise_0][se:7226_shock]……等等，你怎么@穿着泳衣！？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":104101,"motion":100}],"nameLeft":"莉薇娅","textLeft":"只是吃个章鱼烧，@也不用这么郑重其事吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104050}],"nameRight":"夜鹤","textRight":"章鱼烧……？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":104101}],"nameLeft":"莉薇娅","textLeft":"咦，难道不是吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104101,"motion":1}],"nameLeft":"莉薇娅","textLeft":"我还以为你是想吃章鱼烧，@才跟着我来的呢……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104050,"motion":100}],"nameRight":"夜鹤","textRight":"不是的，我是来实践@从老师那里学到的温柔。"},{"chara":[{"id":104050}],"nameRight":"夜鹤","textRight":"机会难得，@我想换个和平时不同的环境试试。"},{"chara":[{"id":104101,"motion":100}],"nameLeft":"莉薇娅","textLeft":"哦，是这样啊。"},{"chara":[{"id":104101}],"nameLeft":"莉薇娅","textLeft":"那我就在这里，@边享用美食边等你……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":104101,"motion":200}],"nameLeft":"莉薇娅","textLeft":"你就去忙@自己的事情吧。"},{"chara":[{"id":104050,"motion":0}],"nameRight":"夜鹤","textRight":"好的，谢谢老师。"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":104101}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104050,"lipSynch":0,"motion":100,"pos":1}],"nameCenter":"夜鹤","textCenter":"（如今，我已经@从老师那里学到了很多……）"},{"chara":[{"id":104050,"lipSynch":0}],"nameCenter":"夜鹤","textCenter":"（一定能温柔地对待初次见面的人，@和对方建立良好的关系……！）"},{"nameRight":"","textRight":"啊，请、请让一下……！"},{"autoTurnLast":0.3,"chara":[{"cheek":0,"effect":"slideInLeftFast","face":"mtn_ex_030.exp.json","id":800100,"motion":0,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"effect":"shake","face":"mtn_ex_051.exp.json","id":104050,"motion":400}],"nameCenter":"夜鹤","textCenter":"……哎呀。"},{"chara":[{"id":800100}],"nameRight":"","textRight":"对、对不起，@我正赶时间……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104050,"motion":1,"pos":0}],"nameLeft":"夜鹤","textLeft":"没关系，不用在意。"},{"chara":[{"id":800100}],"nameRight":"","textRight":"那、那我先走……@[chara:800100:lipSynch_0][wait:0.8][chara:800100:effect_shake]……唔！"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104050,"motion":0}],"nameLeft":"夜鹤","textLeft":"不好，你的脚在流血。"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104050,"lipSynch":0,"motion":300}],"nameLeft":"夜鹤","textLeft":"（看到有人受伤时……）"},{"chara":[{"id":104050,"lipSynch":0}],"nameLeft":"夜鹤","textLeft":"（尽自己所能给予照料，@关心对方，这就是温柔……！）"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104050,"motion":0}],"nameLeft":"夜鹤","textLeft":"这位小姐，@我们去那边的水龙头处处理伤口吧。"},{"autoTurnLast":0.5,"chara":[{"id":104050,"pos":1}],"textClear":1},{"chara":[{"id":104050,"motion":200}],"nameCenter":"夜鹤","textCenter":"来，请抓稳了。"},{"chara":[{"cheek":2,"face":"mtn_ex_050.exp.json","id":800100}],"nameRight":"","textRight":"[chara:800100:effect_emotion_surprise_0][se:7226_shock]……呀！？@你、你要做什么……！"},{"autoTurnLast":0.01,"bg":"bg_adv_20251.jpg","chara":[{"cheek":2,"face":"mtn_ex_050.exp.json","id":800100,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_000.exp.json","id":104050,"motion":0,"pos":0}],"turnChangeIn":"rollInFast"},{"chara":[{"id":800100,"lipSynch":0,"pos":2}],"nameRight":"","textRight":"（居、居然被@公主抱了……）","turnChangeOut":"rollOutFast"},{"chara":[{"id":104050,"motion":300,"pos":0}],"nameLeft":"夜鹤","textLeft":"嗯……看来伤口不深。@先清洗一下伤口吧。"},{"bgm":"stop","nameCenter":"","textCenter":"喂，那边的小哥。"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104050,"motion":1,"pos":0}],"nameLeft":"夜鹤","textLeft":"……您是在叫我吗？"},{"bgm":"bgm03_story10","chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":800400,"motion":0,"pos":2}],"nameRight":"","textRight":"仔细一看，@原来是位漂亮姐姐啊。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":800500,"motion":0,"pos":2}],"nameRight":"","textRight":"姐姐，那边那个姑娘，@可是我们先看上的啊。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":800100,"motion":0,"pos":2}],"nameRight":"","textRight":"那、那个……这些人@一直纠缠着我搭讪……"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104050,"lipSynch":0,"motion":300,"pos":0}],"nameLeft":"夜鹤","textLeft":"（原来如此……@她是在逃跑时撞到了我……）"},{"chara":[{"id":104050,"lipSynch":0,"pos":0}],"nameLeft":"夜鹤","textLeft":"（这时候，帮她摆脱麻烦，@就是温柔……！）"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104050,"motion":100,"pos":0}],"nameLeft":"夜鹤","textLeft":"……这里交给我。@小姐，你先走吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":800100,"pos":2}],"nameRight":"","textRight":"好、好的……！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":104050}],"textClear":1},{"autoTurnLast":0.5,"chara":[{"id":800100,"pos":1}]},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":800500,"motion":0,"pos":0}],"nameLeft":"","textLeft":"[chara:800500:effect_shake][chara:800100:effect_shake]等等，谁准你走了？"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":800500,"pos":0}],"nameLeft":"","textLeft":"喂，被你这么一撞，@我的骨头都断了。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":800400,"motion":0,"pos":2}],"nameRight":"","textRight":"这可得@赔我点精神损失费啊。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":800100,"motion":0,"pos":1}],"nameCenter":"","textCenter":"你、你胡说……！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":800100},{"effect":"fadeout","id":800400}],"textClear":1},{"autoTurnLast":0.2,"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":800500,"motion":0,"pos":2}]},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104050,"lipSynch":0,"motion":300,"pos":0}],"nameLeft":"夜鹤","textLeft":"（……看到有人受伤，@要尽自己所能……）"},{"chara":[{"eyeClose":1,"id":104050,"motion":0,"pos":0}],"nameLeft":"夜鹤","textLeft":"……骨折的话，@就不是我能处理的了。"},{"bgm":"stop","chara":[{"eyeClose":0,"id":104050,"motion":0,"pos":0}],"nameLeft":"夜鹤","textLeft":"我把您送到海边的小店，@在那里叫救护车吧。"},{"bgm":"bgm01_anime03","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104050,"motion":200,"pos":1}],"nameCenter":"夜鹤","textCenter":"我会用公主抱把您抱过去，@请不要乱动哦。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":800500,"pos":2}],"nameRight":"","textRight":"[chara:800500:effect_emotion_surprise_0][se:7226_shock]哈！？"},{"chara":[{"cheek":0,"effect":"shake","face":"mtn_ex_020.exp.json","id":800500,"pos":2}],"nameRight":"","textRight":"放、放开我！@你干什么啊！"},{"autoTurnLast":0.01,"bg":"bg_adv_20331.jpg","chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104050,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp.json","id":800500,"motion":0,"pos":2}],"turnChangeIn":"rollInFast"},{"chara":[{"id":104050,"motion":300,"pos":0}],"nameLeft":"夜鹤","textLeft":"那么，接下来叫救护车……","turnChangeOut":"rollOutFast"},{"chara":[{"id":800500,"pos":2}],"nameRight":"","textRight":"你、你到底怎么回事啊！@明明是女的，力气却这么大……！"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":800400,"motion":0,"pos":2}],"nameRight":"","textRight":"我、我的骨折已经好了，@我们这就走……！"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":800400}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104050,"motion":1,"pos":0}],"nameLeft":"夜鹤","textLeft":"……骨折好了？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":800100,"motion":0,"pos":2}],"nameRight":"","textRight":"那、那个，@真是太感谢您了……！"},{"chara":[{"id":800100,"pos":2}],"nameRight":"","textRight":"多亏您，我才得救了！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104050,"motion":100,"pos":0}],"nameLeft":"夜鹤","textLeft":"不用客气。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":800100,"pos":2}],"nameRight":"","textRight":"那么，我就先走了……"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":800100}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104050,"lipSynch":0,"motion":300,"pos":0}],"nameLeft":"夜鹤","textLeft":"（虽然不太明白，@不过，事情好像已经解决了。）"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104050,"lipSynch":0,"pos":0}],"nameLeft":"夜鹤","textLeft":"（这大概说明……）"},{"autoTurnLast":0.2,"chara":[{"id":104050,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":104101,"motion":0,"pos":0}],"nameLeft":"莉薇娅","textLeft":"哎，夜鹤，"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":104101,"motion":100,"pos":0}],"nameLeft":"莉薇娅","textLeft":"你好像卷进了@什么怪事里啊。"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp.json","id":104050,"motion":0,"pos":2}],"nameRight":"夜鹤","textRight":"啊，老师。"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp.json","id":104050,"motion":100,"pos":2}],"nameRight":"夜鹤","textRight":"虽然刚才@遇到了一点麻烦……"},{"chara":[{"id":104050,"pos":2}],"nameRight":"夜鹤","textRight":"但也因此学到了重要的一课。"},{"bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104050,"motion":400,"pos":2}],"nameRight":"夜鹤","textRight":"那就是……公主抱，是不论男女@都适用的温柔技巧！"},{"bgm":"bgm03_story20","chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":104101,"motion":0,"pos":0}],"nameLeft":"莉薇娅","textLeft":"……哈？"},{"chara":[{"id":104050,"motion":1,"pos":2}],"nameRight":"夜鹤","textRight":"今后，我会积极地@运用公主抱……"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp.json","id":104101,"motion":400,"pos":0}],"nameLeft":"莉薇娅","textLeft":"等等！"},{"chara":[{"id":104101}],"nameLeft":"莉薇娅","textLeft":"公主抱@可不是什么万能招数哦？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104101,"motion":0}],"nameLeft":"莉薇娅","textLeft":"不如说，能派上用场的时候，@恐怕才是少数吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":104050,"motion":300,"pos":2}],"nameRight":"夜鹤","textRight":"……原来如此。@温柔真是一门深奥的学问……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104101,"motion":200,"pos":0}],"nameLeft":"莉薇娅","textLeft":"回去以后，@还得再好好学学什么是温柔。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":104050,"motion":1,"pos":2}],"nameRight":"夜鹤","textRight":"是。"},{"chara":[{"eyeClose":1,"id":104050,"lipSynch":0,"pos":2}],"nameRight":"夜鹤","textRight":"（……我一定会@再次回到这片沙滩……）"},{"chara":[{"eyeClose":0,"id":104050,"lipSynch":0,"motion":100,"pos":2}],"nameRight":"夜鹤","textRight":"（到那时，我一定要@完美地演绎出真正的温柔……！）"},{"autoTurnLast":2,"turnChangeIn":"fadeIn"}]},"version":3}