{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13143.jpg","bgm":"bgm23_tokime02","chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":1,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"“情人节”就快到了呢！","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501}],"nameLeft":"静香","textLeft":"所以，我有件事想和你们商量……"},{"bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"lipSynch":0},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102701,"motion":0}],"nameCenter":"千春&沙绪","textCenter":"[chara:102601:effect_emotion_surprise_0][chara:102701:effect_emotion_surprise_0][se:7226_shock]——！？"},{"chara":[{"id":102601,"lipSynch":0},{"id":102701}],"nameCenter":"千春&沙绪","textCenter":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":1}],"nameLeft":"静香","textLeft":"……咦？@你们这是怎么了？"},{"bgm":"bgm23_tokime03","chara":[{"id":102601}],"nameCenter":"千春","textCenter":"静香居然……"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"知道……"},{"chara":[{"id":102601,"motion":400,"mouthOpen":1},{"id":102701,"motion":400,"mouthOpen":1}],"nameCenter":"千春&沙绪","textBg":"shout","textCenter":"情人节……！？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":300,"pos":0},{"id":102601,"mouthOpen":0},{"id":102701,"mouthOpen":0}],"nameLeft":"静香","textLeft":"……也不用@这么吃惊吧。"},{"autoTurnLast":0.2,"chara":[{"id":102601,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102601,"motion":200}],"nameRight":"千春","textRight":"可那是情人节啊？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"以前在村子里的时候，@应该没接触过这些吧……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"今天白天出门时，@夏希告诉我的。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"motion":0,"pos":0}],"nameLeft":"千春","textLeft":"夏希告诉你的……？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":200}],"nameRight":"沙绪","textRight":"那应该就没问题了。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":100}],"nameLeft":"千春","textLeft":"也是呢！"},{"autoTurnLast":0.2,"chara":[{"id":102601,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"……你们这是什么意思？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102601,"motion":1}],"nameRight":"千春","textRight":"就是，怕你@理解成了奇怪的意思嘛……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102701,"motion":300,"pos":2}],"nameRight":"沙绪","textRight":"只听到一知半解的，"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"万一和大家通常理解的@不是一回事，就不好了……"},{"bgm":"stop","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_020.exp.json","id":102501,"lipSynch":0}],"nameLeft":"静香","textLeft":"…………[wait:0.8][chara:102501:lipSynch_1]唔……"},{"bgm":"bgm23_tokime02","chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":1},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102701,"motion":0}],"nameLeft":"静香","textLeft":"……情人节是@女孩子的特别日子。"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"可以把巧克力送给@喜欢的男孩子，向他告白，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"也可以把巧克力送给特别的人，@表达平日里的感谢，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"还可以约会。"},{"chara":[{"id":102501,"motion":100}],"nameLeft":"静香","textLeft":"怎么样？@我说得对吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701,"motion":100}],"nameRight":"沙绪","textRight":"嗯，说得没错！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":200,"pos":2}],"nameRight":"千春","textRight":"对……！@完全正确。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501}],"nameLeft":"静香","textLeft":"呵呵。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":200}],"nameLeft":"静香","textLeft":"所以啊……"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"机会难得，@我也想参与一下。"},{"autoTurnLast":2,"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"……我打算，","turnChangeOut":"fadeOut"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"在情人节当天，"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"请对方来神滨，@一起约会。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102601,"motion":200}],"nameRight":"千春","textRight":"原来如此呀……"},{"chara":[{"id":102601}],"nameRight":"千春","textRight":"因为族里的事情，@平时很难待在一起，"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":0}],"nameRight":"千春","textRight":"这样的日子当然想一起过呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"我也觉得很好。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701}],"nameRight":"沙绪","textRight":"无论是“本命巧克力”，@还是“神滨约会”。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":100,"pos":0}],"nameLeft":"静香","textLeft":"对吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":200}],"nameRight":"沙绪","textRight":"你们两位的感情更加深厚，@对一族来说也是件重要的事。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":200}],"nameLeft":"静香","textLeft":"不过……"},{"chara":[{"id":102501}],"nameLeft":"静香","textLeft":"我还有很多不懂的地方，@想请你们帮忙准备。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701,"motion":1,"pos":2}],"nameRight":"沙绪","textRight":"当然可以。@对吧，小千？"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp.json","id":102601,"lipSynch":0,"motion":300,"pos":0}],"nameLeft":"千春","textLeft":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102701}],"nameRight":"沙绪","textRight":"小千？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102601,"motion":0}],"nameLeft":"千春","textLeft":"啊，抱歉。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":100}],"nameLeft":"千春","textLeft":"我当然也会帮忙的！"},{"autoTurnLast":0.2,"chara":[{"id":102601,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"太好了。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102501,"motion":200}],"nameLeft":"静香","textLeft":"不过，你刚才好像在发呆，@没事吧？"},{"chara":[{"cheek":1,"face":"mtn_ex_010.exp.json","id":102601,"motion":1}],"nameRight":"千春","textRight":"是这样的……"},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":102601}],"nameRight":"千春","textRight":"我也在想，要不要@鼓起勇气邀请一下呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":1}],"nameLeft":"静香","textLeft":"这不是很好吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp.json","id":102601,"motion":200}],"nameRight":"千春","textRight":"只是，我有个很强的竞争对手，@不知道能不能成功……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"pos":0}],"nameLeft":"静香","textLeft":"情人节不就是让女孩子@主动出击的日子吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":100}],"nameLeft":"静香","textLeft":"可不能先泄气呀，小千！"},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp.json","id":102601,"motion":0}],"nameRight":"千春","textRight":"嗯……！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":200}],"nameLeft":"静香","textLeft":"夏希要是听见我们这么聊，@一定会吓一跳吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"呵呵……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701}],"nameRight":"沙绪","textRight":"得准备好巧克力，@再安排一次美好的约会才行呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"motion":0}],"nameLeft":"静香","textLeft":"是啊。"},{"chara":[{"id":102701,"motion":200}],"nameRight":"沙绪","textRight":"我有个提议。"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"不如和族里的大家@一起做巧克力，怎么样？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501}],"nameLeft":"静香","textLeft":"一起做……？"},{"chara":[{"id":102701,"motion":1}],"nameRight":"沙绪","textRight":"嗯。情人节还有一种@叫“友情巧克力”的习俗，"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"就是朋友之间@互赠巧克力。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":100,"pos":0}],"nameLeft":"千春","textLeft":"做好就能互相交换了呢，@听起来很有趣……！"},{"chara":[{"id":102701,"motion":100}],"nameRight":"沙绪","textRight":"也能借此感谢大家@平日里对我们的支持。"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp.json","id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"“友情巧克力”……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501}],"nameLeft":"静香","textLeft":"真不错！@就这么办吧！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102701,"motion":400}],"nameRight":"沙绪","textRight":"太好了。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102601,"motion":200,"pos":0}],"nameLeft":"千春","textLeft":"那从明天开始，@我们就着手准备吧！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102701,"motion":1}],"nameRight":"沙绪","textRight":"听说有情人节专柜，"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"要不要去@购物中心看看？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp.json","id":102501,"motion":0,"pos":0}],"nameLeft":"静香","textLeft":"购物中心……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp.json","id":102501,"lipSynch":0}],"nameLeft":"静香","textLeft":"（约会也得准备一身新衣服，@正好一起去看看。）","turnEffect":"thinking"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp.json","id":102501,"motion":100}],"nameLeft":"静香","textLeft":"嗯，@明天我们三个一起去吧！","turnEffect":"stop"},{"autoTurnLast":2,"turnChangeIn":"fadeIn"}]},"version":3}