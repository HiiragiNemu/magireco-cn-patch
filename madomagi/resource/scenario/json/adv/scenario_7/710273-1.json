{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_001.exp3.json","id":102601,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm23_tokime02","chara":[{"id":102601,"motion":300}],"nameCenter":"千春","textCenter":"唔唔唔～","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"eyeClose":0,"id":102601,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":1,"pos":2}],"nameRight":"沙绪","textRight":"小千，怎么了？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":200,"pos":2}],"nameRight":"静香","textRight":"说起来，你在看什么呢？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102601,"motion":1}],"nameLeft":"千春","textLeft":"是小纱奈@为静香画的那本绘本呀。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"就是为了让静香清醒过来，@我们在她心里演过的那个故事呢。"},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/3003_act_stage.ExportJson","zOrder":"messageBack"}],"autoTurnLast":1,"bg":"bg_adv_50016.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102602,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"autoTurnLast":2,"turnChangeOut":"fadeOut"},{"autoTurnLast":1,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102701,"motion":1,"pos":2}],"deleteArmatureList":[1],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"motion":300}],"nameLeft":"静香","textLeft":"唔……虽然是很重要的回忆，@但提起来还是让我有些难受呢。","turnChangeOut":"fadeOut"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"我们也一样……什么是恶，@什么是善……让人想了很多。"},{"autoTurnLast":0.2,"chara":[{"id":102501,"motion":1,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102601,"motion":0,"pos":0}],"nameRight":"静香","textRight":"……所以，小千，@你重读这个故事，在烦恼什么呢？"},{"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":102601,"pos":0}],"nameLeft":"千春","textLeft":"也不是什么大事啦，@就是有点在意这之后发生了什么。"},{"autoTurnLast":1,"item":[{"iPhoneXScale":1,"path":"resource/scenario/img/51030_fishing_homura/51030_yu_dairy.jpg","posX":0,"posY":0,"visible":"appear","zOrder":"bgFront"}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"季节更替，春天到来时，@小鸟离开了小镇，@约定明年还会再来。","narrationEffect":"in","turnChangeOut":"fadeOut"},{"nameNarration":"","narration":"望着那个渐渐远去的身影，@乌龟在心中许下了诺言：@下次小鸟来小镇之前，@要和老虎一起学会把温柔带给别人。"},{"autoTurnLast":1,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102601,"motion":0,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"的确，小鸟离开小镇以后，@乌龟它们会怎么样呢？","turnChangeOut":"fadeOut"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"老虎应该会向大家@报恩、赎罪吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102601,"motion":200}],"nameCenter":"千春","textCenter":"小鸟在离开小镇之前，@肯定也会做些什么……"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102501},{"effect":"fadeout","id":102601}],"textClear":1},{"autoTurnLast":0.2,"chara":[{"id":102701,"pos":1}]},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_050.exp3.json","id":102701,"lipSynch":0}],"nameCenter":"沙绪","textCenter":"（乌龟的话……）"},{"autoTurnLast":0.2,"bgm":"stop","textClear":1},{"autoTurnLast":2,"bg":"bg_adv_50016.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":1,"pos":1}],"turnChangeIn":"fadeIn","turnChangeInTime":1,"turnEffect":"ef_adv_10"},{"bgm":"bgm23_tokime01","nameNarration":"","narration":"这是发生在远离人类城镇的地方，@一个动物们生活的世界里的故事。","narrationBg":"","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"曾为家人抢夺镇上食物的老虎，@在小鸟离开以后，@虽然仍有些不知所措，@却也努力和乌龟一起，把温柔带给大家。"},{"narration":"眼看着，即将和大家一起度过的@第二个冬天越来越近，@乌龟和老虎却遇到了一个问题。"},{"narration":"那就是……"},{"autoTurnLast":1,"bg":"bg_adv_21843.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102702,"motion":0,"pos":2}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102502}],"nameLeft":"静香","textLeft":"小鸟留下的羽毛……@做成的被子，怎么全都不见了！","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702}],"nameNarration":"","narration":"小鸟在冰雪消融时离开小镇，@把换羽时掉落的羽毛留作临别礼物。@老虎它们将羽毛做成了过冬的被子，@可是，那些被子竟然全都不见了。","narrationBg":"bg_adv_21843.jpg","narrationEffect":"in"},{"chara":[{"id":102702,"motion":100}],"nameRight":"沙绪","narrationEffect":"out","textRight":"难道……是遭贼了……？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":400}],"nameLeft":"静香","textLeft":"[chara:102502:effect_emotion_surprise_0][se:7226_shock]不、不是我哦！？"},{"chara":[{"id":102702,"motion":1}],"nameRight":"沙绪","textRight":"我知道，@你已经不会再做那种事了。"},{"chara":[{"id":102702},{"id":102502,"motion":0}],"nameRight":"沙绪","textRight":"……可是，小鸟送给我们的@那么珍贵的羽毛，竟然被偷走了……"},{"chara":[{"eyeClose":1,"id":102702}],"nameRight":"沙绪","textRight":"本来还打算拿去给@刚出生的小兔子取暖呢……"},{"nameNarration":"","narration":"小鸟的羽毛被子，不只能在寒冬中@让大家睡得暖和舒适，@还要用来为幼儿和老人取暖。@被子遭窃，对小镇来说是件大事。","narrationBg":"bg_adv_21843.jpg","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102502,"motion":200}],"nameLeft":"静香","narrationEffect":"out","textLeft":"……去找犯人吧。@那里好像有脚印。"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_020.exp3.json","id":102702,"motion":200}],"nameRight":"沙绪","textRight":"……真的呢，我们追上去吧。"},{"autoTurnLast":0.01,"bg":"bg_adv_19305.jpg","turnChangeIn":"fadeIn"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102502,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":1,"pos":2}],"nameNarration":"","narration":"为了找回大家珍贵的被子，@老虎和乌龟沿着小屋边的小小脚印，@一路追到了山里。","narrationBg":"bg_adv_19305.jpg","narrationEffect":"in","turnChangeOut":"fadeOut"},{"chara":[{"id":102502,"motion":300}],"nameLeft":"静香","narrationEffect":"out","textLeft":"这里……是我们@以前住过的地方呢……"},{"chara":[{"id":102502}],"nameLeft":"静香","textLeft":"那时候，应该没有@别的孩子住在这里……"},{"chara":[{"id":102702,"motion":300}],"nameRight":"沙绪","textRight":"说不定，它们住进了@老虎你们以前的家里……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102702}],"nameNarration":"","narration":"沙沙。","narrationBg":"","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102502,"lipSynch":0,"motion":100}],"nameLeft":"静香","narrationEffect":"out","textLeft":"——！？@[wait:0.8][chara:102502:lipSynch_1]你在那里吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102702,"motion":200}],"nameRight":"沙绪","textRight":"是你们吗？@偷走被子的。"},{"nameCenter":"","textCenter":"对、对不起！@我们道歉，别吃我们……"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102502},{"effect":"fadeout","id":102702}],"textClear":1},{"autoTurnLast":0.1,"bg":"bg_adv_19305.jpg","bgChangeEffect":"cameraPan"},{"autoTurnLast":2,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":801200,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":801202,"motion":0,"pos":2}]},{"nameNarration":"","narration":"出现在它们面前的，是一对年幼的黄鼠狼姐妹。","narrationBg":"bg_adv_19305.jpg","narrationEffect":"in"},{"chara":[{"id":801200}],"nameLeft":"","narrationEffect":"out","textLeft":"那、那个……@实在太冷了……"},{"chara":[{"id":801203}],"nameRight":"","textRight":"对不起……@我们会还回去的，请不要吃我们……"},{"nameNarration":"","narration":"乌龟觉得，抢走小鸟送来的珍贵羽毛，@抢走那些用来温暖大家的羽毛，@是很坏很坏的行为。","narrationBg":"bg_adv_19305.jpg","narrationEffect":"in"},{"chara":[{"id":801200,"pos":2}],"narration":"可是，眼前这两个瑟瑟发抖的孩子，@和当初因抢夺食物而受到惩罚、@差点冻僵的老虎，@实在太像了……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102702,"motion":1,"pos":0}],"narration":"乌龟想起了小鸟当时说过的话，@也想起自己曾向即将离开的小鸟许诺，@要和老虎一起，把温柔传递出去。"},{"chara":[{"eyeClose":1,"id":102702}],"nameLeft":"沙绪","narrationEffect":"out","textLeft":"……我和老虎，@都不会吃你们的。"},{"chara":[{"eyeClose":0,"id":102702,"motion":100}],"nameLeft":"沙绪","textLeft":"所以……你们愿意的话，@要不要和我们一起到镇上去？"},{"chara":[{"id":102702}],"nameLeft":"沙绪","textLeft":"不用抢夺，@也能找到温暖的地方。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":801200}],"nameRight":"","textRight":"真、真的吗……？@我们……也能去吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":1}],"nameLeft":"沙绪","textLeft":"偷走被子，@确实是很坏的行为……"},{"chara":[{"id":102702}],"nameLeft":"沙绪","textLeft":"可是，如果这是痛苦造成的，@我愿意抚平那份痛苦。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102502,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"我以前，也曾这样@得到小鸟的帮助。"},{"chara":[{"id":102502}],"nameLeft":"静香","textLeft":"所以，我不可能@把你们丢在这里不管。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102702,"motion":200,"pos":0}],"nameLeft":"沙绪","textLeft":"你们也愿意和我们一起，@把温柔传递给别人吗？"},{"autoTurnLast":0.2,"chara":[{"id":801200,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":801202,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_011.exp3.json","id":801200}],"nameCenter":"","textCenter":"……嗯！"},{"autoTurnLast":1,"bg":"bg_adv_50016.jpg","turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"就这样，乌龟和老虎带着被子，@也带着黄鼠狼姐妹回到了小镇。@它们和大家一起裹着被子取暖，@等待小鸟归来。","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"后来……"},{"autoTurnLast":1.5,"bg":"bg_adv_50016.jpg","chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":102602,"motion":0,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102602,"motion":100}],"nameCenter":"千春","textCenter":"我回来啦——！","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102602}],"textClear":1},{"chara":[{"cheek":1,"face":"mtn_ex_011.exp3.json","id":102502,"motion":100,"mouthOpen":1,"pos":0},{"cheek":1,"face":"mtn_ex_011.exp3.json","id":102702,"motion":1,"mouthOpen":1,"pos":2}],"nameCent