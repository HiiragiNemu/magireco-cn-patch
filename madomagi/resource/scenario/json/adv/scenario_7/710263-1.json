{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_001.exp3.json","id":102601,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm23_tokime02","chara":[{"id":102601,"motion":300}],"nameCenter":"千春","textCenter":"唔唔唔～","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"eyeClose":0,"id":102601,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":1,"pos":2}],"nameRight":"沙绪","textRight":"小千，怎么了？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":200,"pos":2}],"nameRight":"静香","textRight":"说起来，你在看什么呢？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102601,"motion":1}],"nameLeft":"千春","textLeft":"是小纱奈@为静香画的那本绘本呀。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"就是为了让静香清醒过来，@我们在她心里演过的那个故事呢。"},{"armatureList":[{"animation":["action"],"armatureId":1,"filePath":"resource/image_native/effect/story/general/3003_act_stage.ExportJson","zOrder":"messageBack"}],"autoTurnLast":1,"bg":"bg_adv_50016.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102602,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"autoTurnLast":2,"turnChangeOut":"fadeOut"},{"autoTurnLast":1,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102701,"motion":1,"pos":2}],"deleteArmatureList":[1],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"motion":300}],"nameLeft":"静香","textLeft":"唔……虽然是很重要的回忆，@但提起来还是让我有些难受呢。","turnChangeOut":"fadeOut"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"我们也一样……什么是恶，@什么是善……让人想了很多。"},{"autoTurnLast":0.2,"chara":[{"id":102501,"motion":1,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102601,"motion":0,"pos":0}],"nameRight":"静香","textRight":"……所以，小千，@你重读这个故事，在烦恼什么呢？"},{"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":102601,"pos":0}],"nameLeft":"千春","textLeft":"也不是什么大事啦，@就是有点在意这之后发生了什么。"},{"autoTurnLast":1,"item":[{"iPhoneXScale":1,"path":"resource/scenario/img/51030_fishing_homura/51030_yu_dairy.jpg","posX":0,"posY":0,"visible":"appear","zOrder":"bgFront"}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"季节更替，春天到来时，@小鸟离开了小镇，@约定明年还会再来。","narrationEffect":"in","turnChangeOut":"fadeOut"},{"nameNarration":"","narration":"望着那个渐渐远去的身影，@乌龟在心中许下了诺言：@下次小鸟来小镇之前，@要和老虎一起学会把温柔带给别人。"},{"autoTurnLast":1,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102601,"motion":0,"pos":1}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102701}],"nameRight":"沙绪","textRight":"的确，小鸟离开小镇以后，@乌龟它们会怎么样呢？","turnChangeOut":"fadeOut"},{"chara":[{"id":102501,"motion":200}],"nameLeft":"静香","textLeft":"老虎应该会向大家@报恩、赎罪吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102601,"motion":200}],"nameCenter":"千春","textCenter":"小鸟在离开小镇之前，@肯定也会做些什么……"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102701},{"effect":"fadeout","id":102501}],"textClear":1},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_050.exp3.json","id":102601,"lipSynch":0,"motion":0}],"nameCenter":"千春","textCenter":"（小鸟的话……）"},{"autoTurnLast":0.2,"bgm":"stop","textClear":1},{"autoTurnLast":2,"bg":"bg_adv_50016.jpg","chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":102602,"motion":0,"pos":1}],"turnChangeIn":"fadeIn","turnChangeInTime":1,"turnEffect":"ef_adv_10"},{"bgm":"bgm23_tokime01","nameNarration":"","narration":"这是发生在远离人类城镇的地方，@一个动物们生活的世界里的故事。","narrationBg":"","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"曾为家人抢夺镇上食物的老虎，@已经悔改，也渐渐融入了小镇。@这时，小鸟望着逐渐消融的积雪，@却有一件烦心事。"},{"chara":[{"eyeClose":1,"id":102602,"motion":300}],"nameCenter":"千春","narrationEffect":"out","textCenter":"唔唔唔……@该怎么办才好呢……"},{"autoTurnLast":0.2,"chara":[{"id":102602,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":801600,"motion":0,"pos":2}],"nameRight":"","textRight":"小鸟，怎么了？"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":102602,"motion":100}],"nameLeft":"千春","textLeft":"啊，是老虎的妹妹呀！"},{"chara":[{"cheek":0,"face":"mtn_ex_040.exp3.json","id":102602}],"nameLeft":"千春","textLeft":"……我呀，已经决定@春天就去别的地方了。"},{"chara":[{"id":102602}],"nameLeft":"千春","textLeft":"……可我有点担心，@老虎和乌龟能不能好好相处。"},{"nameNarration":"","narration":"自从老虎抢过食物以后，@虽然它和乌龟算是和好了，@可相处起来，似乎还是有些别扭。","narrationBg":"bg_adv_50016.jpg","narrationEffect":"in"},{"chara":[{"id":102602,"motion":0}],"narration":"有没有办法，让它们变得更亲近些呢？@小鸟希望能在离开小镇之前，@想办法解决这件事。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":801600}],"nameRight":"","narrationEffect":"out","textRight":"我、我！@我有个好主意！"},{"autoTurnLast":0.5,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102602,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":801600,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102602}],"nameLeft":"千春","textLeft":"嗯嗯……@[chara:102602:lipSynch_0][wait:0.8][chara:102602:lipSynch_1][chara:102602:cheek_0][chara:102602:face_mtn_ex_010.exp3.json]嗯，这个主意好！","turnChangeOut":"fadeOut"},{"autoTurnLast":1.5,"bg":"bg_adv_50016.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102702,"motion":1,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102502}],"nameLeft":"静香","textLeft":"……咦，你怎么@在这里？","turnChangeOut":"fadeOut"},{"chara":[{"id":102702,"motion":100}],"nameRight":"沙绪","textRight":"是小鸟叫我来的。@……你呢？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":300}],"nameLeft":"静香","textLeft":"是我妹妹叫我来的……@可是，又没见到她。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":300}],"nameRight":"沙绪","textRight":"……看来我们的情况一样呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102702}],"nameNarration":"","narration":"“呀——@救——命——啊——”","narrationBg":"","narrationEffect":"in"},{"chara":[{"id":102502,"motion":400}],"nameLeft":"静香","narrationEffect":"out","textLeft":"这个声音！是我妹妹！@在山那边……还有小鸟的气味……"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102702,"motion":200}],"nameRight":"沙绪","textRight":"我们走！"},{"autoTurnLast":1,"bg":"bg_adv_19305.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":801600,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102602,"motion":1,"pos":0}],"turnChangeIn":"fadeIn"},{"chara":[{"id":801600}],"nameRight":"","textRight":"我在山路上设了些陷阱，@得让它们两个齐心协力，才能过去。","turnChangeOut":"fadeOut"},{"chara":[{"id":801600}],"nameRight":"","textRight":"这样，等走到这里时，@它们就一起克服困难，成为好朋友了！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102602,"motion":100}],"nameLeft":"千春","textLeft":"然后回去一起吃火锅，@就能让它们更加亲近啦！"},{"nameNarration":"","narration":"虎妹妹的主意是，@让老虎和乌龟一起努力来救自己和小鸟，@这样，它们的关系就会更亲近。可是……","narrationBg":"bg_adv_19305.jpg","narrationEffect":"in"},{"autoTurnLast":0.01,"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102502,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102702,"motion":1,"pos":2}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"chara":[{"id":102502,"motion":200}],"nameLeft":"静香","textLeft":"……也就是说，@这一切都是你们安排好的，对吧。","turnChangeOut":"fadeOut"},{"chara":[{"id":102702,"motion":200}],"nameRight":"沙绪","textRight":"居然还在森林里@布置了那么复杂的陷阱……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102602,"motion":300,"pos":0}],"nameLeft":"千春","textLeft":"哇、哇哇……"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102502,"motion":100,"pos":2}],"nameRight":"静香","textRight":"真是的！@害我们担心成这样！"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":102702,"motion":1,"pos":2}],"nameRight":"沙绪","textRight":"是啊，这件事，@你们可得好好解释清楚！"},{"autoTurnLast":0.5,"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102602,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"计划被老虎和乌龟识破，@虎妹妹和小鸟挨了好一顿训。@不过，","narrationBg":"bg_adv_19305.jpg","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"得知这个计划是出于它们的好意后，@老虎和乌龟叹了口气，@又露出了为难的神情。"},{"chara":[{"id":102702,"motion":300}],"nameRight":"沙绪","narrationEffect":"out","textRight":"你们说是为了@让我们变得更亲近……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":1,"pos":2}],"nameRight":"静香","textRight":"这让我们怎么生气呀……"},{"chara":[{"id":102602,"motion":300}],"nameLeft":"千春","textLeft":"呜……对不起嘛……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":100,"pos":2}],"nameRight":"沙绪","textRight":"……不过，你们其实@不用这么担心的。"},{"chara":[{"id":102702}],"nameRight":"沙绪","textRight":"听说小鸟要出发以后，@我们就已经商量过了。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102502,"motion":200,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102602}],"nameRight":"静香","textRight":"这一次，要由我们两个，@把从小鸟那里得到的温柔传递出去。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":801600,"motion":0,"pos":0}],"nameLeft":"","textLeft":"[chara:801600:effect_emotion_surprise_0][se:7226_shock]那我呢！？"},{"chara":[{"id":102502,"motion":1}],"nameRight":"静香","textRight":"当然，@也要请你多多帮忙呀。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102702,"motion":200,"pos":2}],"nameRight":"沙绪","textRight":"所以，放心吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102602,"motion":200,"pos":0}],"nameLeft":"千春","textLeft":"……这样啊，@原来是这样啊……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102702,"motion":0}],"nameRight":"沙绪","textRight":"小鸟？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102602,"motion":1}],"nameLeft":"千春","textLeft":"没什么，只是没想到你们两个@已经这么要好了，我好开心！"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":300},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502,"motion":0,"pos":0}],"nameRight":"沙绪","textRight":"要好……@也还没到那种程度吧……对吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102502,"motion":100}],"nameLeft":"静香","textLeft":"嗯，总觉得……还差点，对吧？"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102702},{"effect":"fadeout","id":102502}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102602,"motion":100,"pos":1}],"nameCenter":"千春","textCenter":"呵呵。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102602}],"nameCenter":"千春","textCenter":"好，我决定了！"},{"autoTurnLast":1.5,"bg":"bg_adv_50016.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102602,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102702,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102702,"motion":100}],"nameRight":"沙绪","textRight":"你真的@要离开小镇吗？","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":801600,"motion":300,"pos":2}],"nameRight":"","textRight":"……不再多待一阵子吗？"},{"chara":[{"eyeClose":1,"id":102602,"motion":300}],"nameLeft":"千春","textLeft":"不了，再待下去，@我一定会舍不得走的。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":102502,"motion":1,"pos":2}],"nameRight":"静香","textRight":"明年还会@回来吧？"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":102602,"motion":100}],"nameLeft":"千春","textLeft":"嗯，我会带好多旅途中的故事回来，@你们可要好好期待哦！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102502}],"nameRight":"静香","textRight":"嗯，虽然会舍不得，@不过……一路顺风，小鸟。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102702,"motion":200,"pos":2}],"nameRight":"沙绪","textRight":"我们会等着，@向你说“欢迎回来”的那一天。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102602,"motion":200}],"nameLeft":"千春","textLeft":"嗯，我出发啦！"},{"autoTurnLast":0.01,"bg":"bg_adv_24012.jpg","chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102602,"motion":1,"pos":1}],"turnChangeIn":"fadeIn"},{"nameNarration":"","narration":"小鸟振翅飞翔，望着渐渐变小的小镇，@心里虽有几分寂寞，@却也充满了希望和期待。","narrationBg":"bg_adv_24012.jpg","narrationCoverOpacity":110,"narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"明年再见面时，@大家会变成什么样呢？@到了新的地方，又会邂逅谁呢……"},{"chara":[{"id":102602}],"nameCenter":"千春","narrationEffect":"out","textCenter":"好，接下来去哪里呢！"},{"autoTurnLast":0.2,"textClear":1},{"autoTurnLast":1.5,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102601,"motion":1,"pos":1}],"turnChangeIn":"fadeIn","turnChangeInTime":1,"turnEffect":"stop"},{"autoTurnLast":2.5,"turnChangeOut":"fadeOut"},{"autoTurnLast":1,"bg":"bg_adv_21241.jpg","bgm":"stop","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_050.exp3.json","id":102601,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"chara":[{"eyeClose":0,"id":102601,"lipSynch":0}],"nameCenter":"千春","textCenter":"（这是我前不久，@想象出来的后续故事……）","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102601}],"textClear":1},{"autoTurnLast":2,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102701,"motion":1,"pos":2}],"textClear":1},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102701},{"effect":"fadeout","id":102501}]},{"autoTurnLast":2,"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":102301,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102401,"motion":1,"pos":2}]},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102301},{"effect":"fadeout","id":102401}]},{"autoTurnLast":2,"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102201,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_000.exp3.json","id":102101,"motion":0,"pos":0}]},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102301}]},{"autoTurnLast":0.2,"chara":[{"id":102101,"pos":2}]},{"bgm":"bgm03_story02","chara":[{"id":102101},{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102501,"motion":1,"pos":0}],"nameRight":"结菜","textRigh