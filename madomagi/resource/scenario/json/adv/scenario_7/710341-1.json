{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13141.jpg","chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":0,"pos":1}],"turnChangeIn":"fadeIn"},{"bgm":"bgm23_tokime01","chara":[{"id":102501,"motion":200,"pos":1}],"nameCenter":"静香","textCenter":"旭，凉子，@“万圣节”……是什么呀？","turnChangeOut":"fadeOut"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102501}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103401,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305801,"motion":0,"pos":2}],"nameLeft":"旭","textLeft":"怎么突然@问起这个来了……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305801,"motion":100,"pos":2}],"nameRight":"南津凉子","textRight":"啊，说起来，现在街上@到处都在过万圣节呢。"},{"autoTurnLast":0.2,"chara":[{"id":305801,"pos":0}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305801,"pos":0},{"cheek":1,"face":"mtn_ex_050.exp3.json","id":102501,"motion":0,"pos":2}],"nameLeft":"南津凉子","textLeft":"满眼都是不认识的东西，@是不是觉得自己被冷落了呀！"},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":102501,"motion":1,"pos":2}],"nameRight":"静香","textRight":"倒、倒也不是……@只是想多了解些事情嘛。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103401,"motion":100,"pos":0}],"nameLeft":"旭","textLeft":"嗯，有这份好学的心，@是好事。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":305801,"motion":1,"pos":0}],"nameLeft":"南津凉子","textLeft":"不过，这种事@问千春她们不就……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":300,"pos":2}],"nameRight":"静香","textRight":"这个嘛……我是想瞒着她们两个，@办一场万圣节聚会。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102501,"pos":2}],"nameRight":"静香","textRight":"要是我一个人准备好了，@小千她们一定会吓一跳吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103401,"motion":200,"pos":0}],"nameLeft":"旭","textLeft":"啊，原来是想办@万圣节派对。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305801,"motion":200,"pos":2}],"nameRight":"南津凉子","textRight":"哦，这主意不错啊！"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103401,"motion":1,"pos":0}],"nameLeft":"旭","textLeft":"那就由在下，@简单说明一下万圣节吧……"},{"autoTurnLast":1.5,"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305801,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"chara":[{"id":102501,"motion":100,"pos":2}],"nameRight":"静香","textRight":"唔……也就是说，@有点像盂兰盆节吗？","turnChangeOut":"fadeOut"},{"chara":[{"id":305801,"pos":0}],"nameLeft":"南津凉子","textLeft":"细说的话，按时节来算，@叫彼岸节倒更贴切些。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103401,"motion":300,"pos":0}],"nameLeft":"旭","textLeft":"嗯……万圣节和彼岸节……@也不算毫无相似之处。"},{"chara":[{"cheek":0,"face":"mtn_ex_001.exp3.json","id":102501,"motion":200,"pos":2}],"nameRight":"静香","textRight":"彼岸节……那应该@也有悼念逝者的意思吧。"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_030.exp3.json","id":102501,"pos":2}],"nameRight":"静香","textRight":"之前的战斗中，很多人受了伤，@也有人失去了生命……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":103401,"pos":0}],"nameNarration":"","narration":"…………","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305801,"motion":400,"pos":0},{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":102501,"motion":0,"pos":2}],"nameLeft":"南津凉子","narrationEffect":"out","textLeft":"不过嘛，这种节日，@还是要过得开心才有意思啊。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305801,"pos":0}],"nameLeft":"南津凉子","textLeft":"过盂兰盆节时，不也会一边悼念逝者，@一边跳盆舞、热闹一番吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102501,"motion":400,"pos":2}],"nameRight":"静香","textRight":"也是……提起盂兰盆节，@我就会想到好吃的水果呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103401,"motion":100,"pos":0}],"nameLeft":"旭","textLeft":"确实如此。@节日本来的意义固然重要，"},{"chara":[{"id":103401,"pos":0}],"nameLeft":"旭","textLeft":"但其中最重要的，是缅怀逝者的心，@而不是形式。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102501,"motion":100,"pos":2}],"nameRight":"静香","textRight":"原来如此……我明白了。"},{"chara":[{"id":102501,"pos":2}],"nameRight":"静香","textRight":"我要在水德寺，@办一场我自己的万圣节派对！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305801,"motion":200,"pos":0}],"nameLeft":"南津凉子","textLeft":"好嘞！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102501},{"effect":"fadeout","id":305801}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103401,"lipSynch":0,"motion":1,"pos":1}],"nameCenter":"旭","textCenter":"（不过……在寺院里过万圣节，@还真是有些奇妙……）"},{"autoTurnLast":1.5,"bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102501,"motion":1,"pos":1}],"turnChangeIn":"fadeIn"},{"autoTurnLast":0.1,"bgm":"bgm23_tokime02","turnChangeOut":"fadeOut"},{"chara":[{"id":102501,"pos":1}],"nameCenter":"静香","textCenter":"[chara:102501:effect_emotion_joy_0][se:7222_happy]那么，各位，@万圣节快乐！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":102501}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102601,"motion":200,"pos":0},{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102701,"motion":100,"pos":1},{"cheek":0,"face":"mtn_ex_011.exp3.json","id":304701,"motion":200,"pos":2}],"nameNarration":"大家","narration":"“万圣节快乐！”","narrationCoverOpacity":100,"narrationEffect":"in"},{"autoTurnLast":0.3,"chara":[{"effect":"fadeout","id":102601},{"effect":"fadeout","id":102701},{"effect":"fadeout","id":304701}],"narrationEffect":"out","textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":102601,"motion":100,"pos":2},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102501,"motion":0,"pos":0}],"nameRight":"千春","textRight":"这些真的都是@静香一个人准备的吗！？"},{"chara":[{"id":102501,"motion":200,"pos":0}],"nameLeft":"静香","textLeft":"嗯，不过旭她们@也给了我不少建议，"},{"chara":[{"id":102501,"pos":0}],"nameLeft":"静香","textLeft":"还向住持借用了@寺里各种各样的东西。"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":102701,"motion":300,"pos":2}],"nameRight":"沙绪","textRight":"静香竟然也会过万圣节了……@总觉得你长大了呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":304701,"motion":100,"pos":2}],"nameRight":"青叶知花","textRight":"虽然没想到会在寺里办，@但这样也很棒呢！"},{"autoTurnLast":0.2,"chara":[{"id":102501,"motion":0,"pos":2}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103450,"motion":200,"pos":0}],"nameLeft":"旭","textLeft":"不过，还真是@下了不少功夫啊。"},{"chara":[{"id":102501,"pos":2}],"nameRight":"静香","textRight":"毕竟决定得仓促，@装扮就来不及准备了。"},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp3.json","id":103450,"motion":300,"pos":0}],"nameLeft":"旭","textLeft":"只有在下一个人穿戴整齐，@倒有点不好意思了。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102501,"motion":300,"pos":2}],"nameRight":"静香","textRight":"不会呀，这身打扮很适合你。@是鹰……对吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103450,"motion":100,"pos":0}],"nameLeft":"旭","textLeft":"正是，很适合在下@这个狙击手吧？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103450,"pos":0}],"nameLeft":"旭","textLeft":"是萨莎她们@帮在下做的。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305801,"motion":1,"pos":2},{"id":103450,"motion":0,"pos":0}],"nameRight":"南津凉子","textRight":"不过，这还真是@日式的万圣节啊。"},{"chara":[{"id":305801,"pos":2}],"nameRight":"南津凉子","textRight":"和果子，@还有彼岸节常见的水果拼盘……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305801,"motion":400,"pos":2}],"nameRight":"南津凉子","textRight":"连装饰灯都换成了@盂兰盆节的提灯！"},{"autoTurnLast":0.2,"chara":[{"id":305801,"pos":0}],"textClear":1},{"chara":[{"cheek":1,"face":"mtn_ex_030.exp3.json","id":102501,"motion":1,"pos":2}],"nameRight":"静香","textRight":"……很奇怪吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305801,"motion":0,"pos":0}],"nameLeft":"南津凉子","textLeft":"不会，我倒挺喜欢。@有种和洋结合的感觉。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103450,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102501,"pos":2}],"nameLeft":"旭","textLeft":"嗯，很有时女一族@的风格。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305801,"motion":200,"pos":0}],"nameLeft":"南津凉子","textLeft":"再跳个盆舞就完美了！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102501,"motion":100,"pos":2}],"nameRight":"静香","textRight":"呵呵，好呀！@我来教大家本家传下来的时女音头！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103450,"motion":400,"pos":0}],"nameLeft":"旭","textLeft":"万圣节渐渐被@彼岸节吞没了……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":103450,"pos":0}],"nameLeft":"旭","textLeft":"话说，连盆舞都加进来，@这下可真是全混在一起了！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305801,"motion":400,"pos":2}],"nameRight":"南津凉子","textRight":"千春、沙绪、知花！@大家一起来跳吧！"},{"autoTurnLast":0.2,"chara":[{"effect":"fadeout","id":103450},{"effect":"fadeout","id":305801}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102601,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":102701,"motion":0,"pos":1},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":304701,"motion":0,"pos":2}],"nameLeft":"千春","textLeft":"时女音头！？@那我来放音乐！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102601,"motion":200,"pos":0}],"nameNarration":"","narration":"～♪","narrationEffect":"in"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":304701,"motion":400,"pos":2}],"nameRight":"青叶知花","narrationEffect":"out","textRight":"明明是第一次听，@却让人有种思乡之情呢……"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":102701,"motion":400,"pos":1}],"nameCenter":"沙绪","textCenter":"以前常和奶奶她们@一起跳呢，呵呵。"},{"autoTurnLast":0.3,"chara":[{"effect":"fadeout","id":102601},{"effect":"fadeout","id":102701},{"effect":"fadeout","id":304701}],"textClear":1},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":103450,"motion":1,"pos":1}],"nameCenter":"旭","textCenter":"……啊，真是的，@还真开心啊……"},{"autoTurnLast":0.2,"bgm":"stop","textClear":1},{"autoTurnLast":2,"bg":"bg_adv_13142.jpg","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103450,"motion":1,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305801,"motion":0,"pos":2}],"turnChangeIn":"fadeIn","turnChangeInTime":1.5},{"bgm":"bgm03_story02","chara":[{"id":305801,"pos":2}],"nameRight":"南津凉子","textRight":"哎呀，玩得真痛快。","turnChangeOut":"fadeOut","turnChangeOutTime":1.5},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103450,"motion":300,"pos":0}],"nameLeft":"旭","textLeft":"呵呵，确实如此。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103450,"pos":0}],"nameLeft":"旭","textLeft":"静香她们似乎也累坏了，@都睡着了。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103450,"pos":0}],"nameLeft":"旭","textLeft":"明明是悼念逝者的聚会，@却闹成这样……会不会挨训呢。"},{"chara":[{"eyeClose":1,"id":305801,"motion":1,"pos":2}],"nameRight":"南津凉子","textRight":"没关系，让祖先们知道，@我们过得好好的就行了。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103450,"motion":100,"pos":0}],"nameLeft":"旭","textLeft":"既然凉子阁下这么说，@在下就放心了。"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_030.exp3.json","id":305801,"motion":0,"pos":2}],"nameRight":"南津凉子","textRight":"……我说，你啊。"},{"chara":[{"id":305801,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103450,"motion":0,"pos":0}],"nameRight":"南津凉子","textRight":"在二木市，你见到过吧？@那些已经死去的人。"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":103450,"pos":0}],"nameLeft":"旭","textLeft":"……是的。"},{"chara":[{"id":305801,"motion":300,"pos":2}],"nameRight":"南津凉子","textRight":"……那个人……也在那里吗？@就是……那个……"},{"nameNarration":"","narration":"…………","narrationEffect":"in"},{"chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_020.exp3.json","id":305801,"motion":0,"pos":2}],"nameRight":"南津凉子","narrationEffect":"out","textRight":"……没什么，忘了吧。@我已经决定了。"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_010.exp3.json","id":305801,"motion":100,"pos":2}],"nameRight":"南津凉子","textRight":"等到了净土，@我要自己去见那个人。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103450,"lipSynch":0,"pos":0}],"nameLeft":"旭","textLeft":"…………"},{"autoTurnLast":1,"bg":"bg_adv_21911.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":302100,"motion":0,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":103450,"motion":1,"pos":0}],"turnChangeIn":"fadeIn","turnEffect":"blackFrame"},{"chara":[{"eyeClose":1,"id":302100,"motion":200}],"nameRight":"铃鹿 朔夜","textRight":"那家伙的话，@总有一天会亲自来告诉我的。","turnChangeOut":"fadeOut"},{"autoTurnLast":1,"bg":"bg_adv_13142.jpg","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":103450,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":305801,"motion":0,"pos":2}],"turnChangeIn":"fadeIn","turnEffect":"stop"},{"chara":[{"id":103450,"motion":300,"pos":0}],"nameLeft":"旭","textLeft":"……是这样啊。","turnChangeOut":"fadeOut"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":305801,"motion":200,"pos":2}],"nameRight":"南津凉子","textRight":"……真开心啊。@静香式的万圣节。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":103450,"motion":100,"pos":0}],"nameLeft":"旭","textLeft":"是啊，明年也请她@再办一次吧。"},{"autoTurnLast":0.2,"textClear":1},{"autoTurnLast":2.5,"turnChangeIn":"fadeIn","turnChangeInTime":1}]},"version":3}