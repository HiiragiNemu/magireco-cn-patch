{"story":{"group_1":[{"autoTurnLast":0.01,"bg":"bg_adv_13111.jpg","bgm":"bgm23_puella01","chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104051,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103950,"motion":0,"pos":2}],"turnChangeIn":"fadeIn"},{"nameNarration":"夜鹤","narration":"圣诞节前的一个星期，@Puella Care@举办了一场特别活动。","narrationBg":"","narrationEffect":"in","turnChangeOut":"fadeOut"},{"narration":"内容是，我和月出里一起，@打扮成“东方三贤士”，@为在街上遇到的魔法少女们@免费进行调整。"},{"narration":"这期间……@发生了一件让我受益良多的事。"},{"autoTurnLast":0.5,"bgm":"stop","chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300651,"motion":0,"pos":0},{"cheek":0,"face":"mtn_ex_011.exp3.json","id":300850,"motion":0,"pos":2}],"narrationEffect":"out","turnChangeIn":"fadeIn"},{"bgm":"bgm01_anime03","chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300850,"motion":100,"pos":2}],"nameRight":"志伸晶","textRight":"听说可以@免费帮我们做调整呢！","turnChangeOut":"fadeOut"},{"chara":[{"id":300850}],"nameRight":"志伸晶","textRight":"真厉害啊，艾米莉！"},{"chara":[{"id":300651,"lipSynch":0,"motion":300}],"nameLeft":"木崎衣美里","textLeft":"…………"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300850,"motion":0}],"nameRight":"志伸晶","textRight":"怎么了？@艾米莉。"},{"chara":[{"id":300651,"motion":1}],"nameLeft":"木崎衣美里","textLeft":"我们好歹也在经营咨询所，@却只是单方面地“接受别人的帮助”……"},{"chara":[{"id":300651}],"nameLeft":"木崎衣美里","textLeft":"这样真的好吗……@[chara:300651:lipSynch_0][wait:0.8][chara:300651:motion_0][chara:300651:cheek_0][chara:300651:face_mtn_ex_020.exp.json][chara:300651:lipSynch_1]…………不，不好！"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300850,"motion":200,"pos":2}],"nameRight":"志伸晶","textRight":"咦，什么不好？@我觉得没什么关系啊……"},{"chara":[{"id":300651,"motion":200}],"nameLeft":"木崎衣美里","textLeft":"当然有关系啦！"},{"chara":[{"id":300651}],"nameLeft":"木崎衣美里","textLeft":"小晶，@你就没有一点自尊心吗！？"},{"chara":[{"id":300850,"motion":0}],"nameRight":"志伸晶","textRight":"也、也不是没有啦……"},{"chara":[{"id":300651,"motion":1}],"nameLeft":"木崎衣美里","textLeft":"我们也得@为她们做点什么才行！"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104051,"motion":1,"pos":2}],"nameRight":"夜鹤","textRight":"那个，接下来该怎么办……？@两位要接受调整吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":300651,"motion":100}],"nameLeft":"木崎衣美里","textLeft":"要！"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300651,"motion":200}],"nameLeft":"木崎衣美里","textLeft":"不过，在那之后，@我们要来场款待对决！！"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":104051,"motion":300}],"nameRight":"夜鹤","textRight":"款待对决……？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300651,"motion":0}],"nameLeft":"木崎衣美里","textLeft":"没错！"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":300651,"motion":100}],"nameLeft":"木崎衣美里","textLeft":"烦恼咨询所和调整屋的，@款待对决！！"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104051,"motion":100}],"nameRight":"夜鹤","textRight":"……虽然不太明白，@不过，我接受。"},{"chara":[{"eyeClose":1,"id":104051}],"nameRight":"夜鹤","textRight":"那么，@现在开始调整。"},{"chara":[{"eyeClose":0,"id":104051,"motion":0}],"nameRight":"夜鹤","textRight":"月出里，这位就拜托你了。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":103950,"lipSynch":0,"motion":100,"pos":2}],"nameRight":"月出里","textRight":"呼姆！"},{"autoTurnLast":0.5,"chara":[{"effect":"fadeout","id":300651},{"effect":"fadeout","id":103950}],"textClear":1},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104051,"motion":1,"pos":2},{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300850,"motion":0,"pos":0}],"nameRight":"夜鹤","textRight":"……这位则由我来负责。"},{"autoTurnLast":2,"bgm":"stop","chara":[{"cheek":0,"eyeClose":1,"face":"mtn_ex_000.exp3.json","id":104051,"motion":0,"pos":2},{"cheek":0,"eyeClose":1,"face":"mtn_ex_010.exp3.json","id":300850,"motion":0,"pos":0}],"turnChangeIn":"fadeIn"},{"autoTurnLast":0.2,"turnChangeOut":"fadeOut"},{"autoTurnLast":1.5,"flashEffect":"flashWhiteSlow2"},{"bgm":"bgm01_anime02","chara":[{"eyeClose":0,"id":104051,"motion":100}],"nameRight":"夜鹤","textRight":"好了，辛苦了。@调整已经结束了。"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":300850,"lipSynch":0}],"nameLeft":"志伸晶","textLeft":"…………[wait:0.8][chara:300850:cheek_0][chara:300850:face_mtn_ex_011.exp.json][chara:300850:lipSynch_1]嗯，很好！@谢谢！"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300850,"motion":200}],"nameLeft":"志伸晶","textLeft":"那么……@既然调整结束了……"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300850}],"nameLeft":"志伸晶","textLeft":"就轮到我来款待你了呢……"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":104051,"motion":1}],"nameRight":"夜鹤","textRight":"那我@需要做些什么呢？"},{"chara":[{"id":300850,"motion":100}],"nameLeft":"志伸晶","textLeft":"这回是我们款待你，@所以你什么都不用做哦。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300850}],"nameLeft":"志伸晶","textLeft":"不过，说是款待，@我也不知道该做些什么……"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104051,"motion":0}],"nameRight":"夜鹤","textRight":"……聊聊天，怎么样？"},{"chara":[{"id":104051}],"nameRight":"夜鹤","textRight":"对调整屋来说，@倾听客人说话也是很重要的工作。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300850,"motion":0}],"nameLeft":"志伸晶","textLeft":"啊，好主意。@那我们聊聊天吧，夜鹤小姐。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300850,"motion":300}],"nameLeft":"志伸晶","textLeft":"……不对，这个主意，@也应该由我自己想出来才对……"},{"chara":[{"id":104051,"motion":100}],"nameRight":"夜鹤","textRight":"我们聊些什么呢？"},{"chara":[{"id":300850,"motion":1}],"nameLeft":"志伸晶","textLeft":"让我想想……夜鹤小姐，@你有什么喜欢做的事吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300850}],"nameLeft":"志伸晶","textLeft":"比如说，兴趣爱好之类的！"},{"chara":[{"id":104051,"motion":1}],"nameRight":"夜鹤","textRight":"……一定要说的话，@就是一些细碎的工作吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300850,"motion":0}],"nameLeft":"志伸晶","textLeft":"细碎的……工作……？"},{"chara":[{"id":104051}],"nameRight":"夜鹤","textRight":"是的，可以让我忘记自我，@一声不响地全心投入其中……"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300850}],"nameLeft":"志伸晶","textLeft":"这、这样啊……"},{"chara":[{"id":300850,"lipSynch":0,"motion":200}],"nameLeft":"志伸晶","textLeft":"（不对，现在可不是为难的时候，@得顺着这个话题聊下去……）"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":300850,"motion":300}],"nameLeft":"志伸晶","textLeft":"能、能具体说说，@都有哪些事情吗？"},{"chara":[{"id":104051,"motion":300}],"nameRight":"夜鹤","textRight":"比如说……做饭……@或是各类家务吧。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300850,"motion":100}],"nameLeft":"志伸晶","textLeft":"啊，那也包括缝纫吗？"},{"chara":[{"id":104051,"motion":0}],"nameRight":"夜鹤","textRight":"是的，我也不讨厌。"},{"chara":[{"id":104051}],"nameRight":"夜鹤","textRight":"这身衣服，也有一部分@是我亲手做的。"},{"chara":[{"id":300850,"motion":200}],"nameLeft":"志伸晶","textLeft":"哇，原来是这样。"},{"chara":[{"cheek":0,"face":"mtn_ex_011.exp3.json","id":300850}],"nameLeft":"志伸晶","textLeft":"这做工，摆在店里卖@也完全没问题啊……真厉害！"},{"chara":[{"id":104051,"motion":400}],"nameRight":"夜鹤","textRight":"造型参考了@古时候德高望重的贤者，"},{"chara":[{"id":104051}],"nameRight":"夜鹤","textRight":"所以，我特意花了心思，@让它能体现出庄重高雅的感觉。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":300850,"motion":1}],"nameLeft":"志伸晶","textLeft":"确实……看起来英姿凛然……@连我都不由得挺直了腰板。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":104051,"motion":1}],"nameRight":"夜鹤","textRight":"谢谢。"},{"chara":[{"id":300850,"motion":0}],"nameLeft":"志伸晶","textLeft":"……夜鹤小姐，@虽然给人的感觉很有男孩子气，"},{"chara":[{"id":300850}],"nameLeft":"志伸晶","textLeft":"但也很有女孩子的一面，@或者说，挺擅长操持家务的呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":300850,"motion":300}],"nameLeft":"志伸晶","textLeft":"这些事情，@我就不太擅长……"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":104051,"motion":100,"pos":2}],"nameRight":"夜鹤","textRight":"是这样吗？"},{"chara":[{"eyeClose":1,"id":300850}],"nameLeft":"志伸晶","textLeft":"嗯……而且，也不太适合我，@所以我很向往呢。"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104051,"motion":1,"pos":2}],"nameRight":"夜鹤","textRight":"……你不用介意的。"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":104051}],"nameRight":"夜鹤","textRight":"如今，“有女孩子气”，@也有各种各样的表现形式。"},{"chara":[{"cheek":0,"eyeClose":0,"face":"mtn_ex_050.exp3.json","id":300850,"motion":0}],"nameLeft":"志伸晶","textLeft":"谢、谢谢……"},{"chara":[{"cheek":0,"face":"mtn_ex_050.exp3.json","id":300850,"lipSynch":0,"motion":200}],"nameLeft":"志伸晶","textLeft":"（不对，明明该由我来款待她，@怎么反倒被鼓励了……！）"},{"chara":[{"cheek":0,"face":"mtn_ex_020.exp3.json","id":300850,"lipSynch":0}],"nameLeft":"志伸晶","textLeft":"（得再找个什么话题，@能让夜鹤小姐聊得开心些……）"},{"chara":[{"id":104051,"motion":0},{"id":300850,"motion":0}],"nameRight":"夜鹤","textRight":"而且……@这样不是也很好吗？"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104051,"lipSynch":0,"motion":300}],"nameRight":"夜鹤","textRight":"（按照笔记，夸奖志伸小姐的@穿着和举止的话……）"},{"chara":[{"cheek":0,"face":"mtn_ex_010.exp3.json","id":104051,"motion":100}],"nameRight":"夜鹤","textRight":"我觉得志伸小姐很有女孩子气，@已经十分可爱了。"},{"chara":[{"cheek":1,"face":"mtn_ex_050.exp3.json","id":300850,"lipSynch":0,"motion":400}],"nameLeft":"志伸晶","textLeft":"[chara:300850:effect_emotion_surprise_0][se:7226_shock]——！？"},{"chara":[{"cheek":0,"face":"mtn_ex_000.exp3.json","id":104051,"lipSynch":0}],"nameRight":"夜鹤","textRight":"（这样措辞，@应该就没错了……）"},{"chara":[{"cheek":2,"face":"mtn_ex_030.exp3.json","id":300850,"motion":300}],"nameLeft":"志伸晶","textLeft":"可、可爱什么的……@～～～～！！"},{"chara":[{"eyeClose":1,"id":300850}],"nameLeft":"志伸晶","textLeft":"我、我输得心服口服啦——！"},{"chara":[{"cheek":0,"face":"mtn_ex_051.exp3.json","id":104051,"motion":400,"pos":2}],"nameRight":"夜鹤","textRight":"咦咦！？"},{"chara":[{"cheek":0,"face":"mtn_ex_030.exp3.json","id":104051,"motion":0}],"nameRight":"夜鹤","textRight":"又失败了……@让她为难了……"},{"nameNarration":"夜鹤","narration":"即使完全按照笔记选择言行，@也可能因场合或对象不同，@而以失败告终。","narrationBg":"","narrationEffect":"in"},{"narration":"围绕着圣诞衣装，@和志伸小姐进行的这番交谈，@让我学到了这一点……"},{"autoTurnLast":2,"turnChangeIn":"fadeIn"}]},"version":3}