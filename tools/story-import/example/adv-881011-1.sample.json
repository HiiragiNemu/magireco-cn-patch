":200401,"motion":0,"pos":2}],"nameRight":"美树沙耶香","textRight":"这是当然的啦。@因为我们是好朋友嘛！"},{"chara":[{"id":200501}],"nameCenter":"巴麻美","textCenter":"好朋友……。真好啊。"},{"chara":[{"id":200501}],"nameCenter":"巴麻美","textCenter":"那么，老鼠怎么了？@我很好奇啊。"},{"chara":[{"effect":"fadeout","id":810600},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":200101,"motion":0,"pos":0}],"nameLeft":"鹿目圆","textLeft":"昨天上课时有只老鼠跑了出来。"},{"chara":[{"id":200501}],"nameCenter":"巴麻美","textCenter":"上课时？"},{"chara":[{"id":200101}],"nameLeft":"鹿目圆","textLeft":"仁美酱吓得不行@从教室跑出去了哦。"},{"chara":[{"effect":"fadeout","id":200401},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":810600,"motion":0,"pos":2}],"nameRight":"仁美","textRight":"我最怕老鼠了。@光看到就吃不消了。"},{"chara":[{"id":200501}],"nameCenter":"巴麻美","textCenter":"我懂的。@我也很怕老鼠。"},{"chara":[{"id":200101}],"nameLeft":"鹿目圆","textLeft":"诶——麻美学姐@也害怕老鼠吗？"},{"chara":[{"id":200501}],"nameCenter":"巴麻美","textCenter":"嗯，它不是跑得很快吗？@最怕那种了。"},{"chara":[{"id":200101}],"nameLeft":"鹿目圆","textLeft":"真是意外呢！"},{"chara":[{"id":200501}],"nameCenter":"巴麻美","textCenter":"咦，是吗？"},{"chara":[{"id":200101}],"nameLeft":"鹿目圆","textLeft":"因为啊，@总觉得麻美学姐会说：@“没什么好怕的。”"},{"chara":[{"id":200501}],"nameCenter":"巴麻美","textCenter":"是这样吗？"},{"chara":[{"id":200101}],"nameLeft":"鹿目圆","textLeft":"就是这样！"},{"chara":[{"id":200501}],"nameCenter":"巴麻美","textCenter":"被鹿目同学这么一说@觉得好高兴啊。"},{"chara":[{"id":200101}],"nameLeft":"鹿目圆","textLeft":"呵呵……。@那就太好了。"},{"chara":[{"effect":"fadeout","id":810600},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":200401,"motion":0,"pos":2}],"nameRight":"美树沙耶香","textRight":"…………@…………@……她们俩感情真好啊。"},{"chara":[{"effect":"fadeout","id":200501},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":810600,"motion":0,"pos":1}],"nameCenter":"仁美","textCenter":"怎么了？@沙耶加同学。"},{"chara":[{"id":200401}],"nameRight":"美树沙耶香","textRight":"没什么，@只是觉得小圆明明才刚和麻美学姐认识不久@关系马上就变得这么好了。"},{"chara":[{"id":810600}],"nameCenter":"仁美","textCenter":"这么说来也是呢。"},{"chara":[{"id":200401}],"nameRight":"美树沙耶香","textRight":"总有一种@青梅竹马被抢走了的感觉啊……。"},{"chara":[{"id":810600}],"nameCenter":"仁美","textCenter":"…………。"},{"chara":[{"effect":"fadeout","id":200101},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":200501,"motion":0,"pos":0}],"nameLeft":"巴麻美","textLeft":"美树同学。@我把鹿目同学抢走了@真不好意思。"},{"chara":[{"id":200401}],"nameRight":"美树沙耶香","textRight":"诶？？"},{"chara":[{"id":200501}],"nameLeft":"巴麻美","textLeft":"不小心听到了@美树同学的话。"},{"chara":[{"id":200401}],"nameRight":"美树沙耶香","textRight":"啊，@我说这话并没有什么奇怪的意思！"},{"chara":[{"id":200401}],"nameRight":"美树沙耶香","textRight":"因为啊，@麻美学姐很有可靠的姐姐的感觉。@小圆想要去亲近我也能理解。"},{"chara":[{"id":200501}],"nameLeft":"巴麻美","textLeft":"美树同学也是啊，@作为鹿目同学的青梅竹马@肯定也被鹿目同学所依赖着哦。"},{"chara":[{"id":200401}],"nameRight":"美树沙耶香","textRight":"是、是吗？"},{"chara":[{"id":200501}],"nameLeft":"巴麻美","textLeft":"是的哦，你安心吧。"},{"chara":[{"effect":"fadeout","id":810600},{"cheek":0,"face":"mtn_ex_010.exp3.json","id":200101,"motion":0,"pos":1}],"nameCenter":"鹿目圆","textCenter":"你们两个怎么了？@突然在那里停下来……。"},{"chara":[{"id":200401}],"nameRight":"美树沙耶香","textRight":"什、什么都没有！@我们在说啊，@小圆今天也好可爱哦——什么的。"},{"chara":[{"id":200101}],"nameCenter":"鹿目圆","textCenter":"诶，沙耶加酱@突然说什么呢——。"},{"chara":[{"id":200401}],"nameRight":"美树沙耶香","textRight":"喂，大家要快点了！@这么下去会迟到的哦！"},{"bgmFadeOut":1,"chara":[{"id":200101}],"nameCenter":"鹿目圆","textCenter":"嗯！　快走吧！","turnChangeOut":"fadeOut"}]},"version":3}