    {
      "id": "modified-tests-and-authority",
      "root": "modified",
      "commands": [
        {
          "id": "test-v26-authority-protection",
          "argv": ["${PYTHON}", "tools/test-v26-authority-protection.py"],
          "inputs": ["tools/test-v26-authority-protection.py", "tools/v26_authority_protection.py"],
          "timeout_seconds": 600
        },
        {
          "id": "test-i18n-build-effective",
          "argv": ["${PYTHON}", "tools/test-i18n-build-effective.py"],
          "inputs": ["tools/test-i18n-build-effective.py", "tools/i18n-build-effective.py"],
          "timeout_seconds": 600
        },
        {
          "id": "test-i18n-authority-guard",
          "argv": ["${PYTHON}", "tools/test-i18n-authority-guard.py"],
          "inputs": ["tools/test-i18n-authority-guard.py", "tools/i18n-authority-guard.py"],
          "timeout_seconds": 600
        },
        {
          "id": "test-i18n-package",
          "argv": ["${PYTHON}", "tools/test-i18n-package.py"],
          "inputs": ["tools/test-i18n-package.py", "tools/i18n-package.py"],
          "timeout_seconds": 600
        },
        {
          "id": "test-change-classifier",
          "argv": ["${PYTHON}", "scripts/test_classify_hotupdate_changes.py"],
