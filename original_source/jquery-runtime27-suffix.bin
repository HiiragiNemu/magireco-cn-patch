r":"谷口淳一郎","PIECE|2023|illustrator":"PAPA","PIECE|2024|illustrator":"PAPA","PIECE|2025|illustrator":"PAPA","PIECE|2026|illustrator":"PAPA","PIECE|2027|illustrator":"都筑禰己","PIECE|2030|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2031|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2032|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2033|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2034|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2035|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2036|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2037|illustrator":"都筑禰己","PIECE|2039|illustrator":"ホセ","PIECE|2042|illustrator":"都筑禰己","PIECE|2046|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2047|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2048|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2049|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2050|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|2051|illustrator":"原案・監修：劇団イヌカレー（泥犬）","PIECE|10001|illustrator":"冷蝉","PIECE|10002|illustrator":"鲨鱼寿司","PIECE|10003|illustrator":"Scarlet团子","PIECE|10004|illustrator":"redum"};
    function applyArtistCredit(o,category,id,field){
        var key=category+'|'+String(id)+'|'+field;
        if(Object.prototype.hasOwnProperty.call(artistCreditTargets,key)) put(o,field,artistCreditTargets[key]);
    }
    function tr(o,p){
        if(Array.isArray(o)){
            for(var i=0;i<o.length;i++) tr(o[i],p);
            return;
        }
        if(!o || typeof o!=='object') return;

        applyRegularEventAccomplishEnemyRules(o);

        var entityRawValues=applyEntityFieldRules(o,p,{},true,false);
        var pk=String(p||'').toLowerCase();
        var t=null,m=null,id=null;
        var live2dHit=false,doppelSkillHit=false;

        if(o.charaId!==undefined && o.live2dId!==undefined){
            id=String(o.charaId)+'_'+String(o.live2dId);
            t=cn.live2dList[id];
            if(t){put(o,'description',t.description);live2dHit=true;}
        }

        id=o.charaNo!==undefined?o.charaNo:
           (o.charaId!==undefined?o.charaId:
           ((pk.indexOf('chara')>=0 && o.id!==undefined)?o.id:null));
        if(id!==null && id!==undefined && cn.charaList[id]){
            t=cn.charaList[id];
            put(o,'name',t.name);
            put(o,'charaName',t.name);
            put(o,'kana',t.kana);
            put(o,'title',t.title);
            put(o,'school',t.school);
            put(o,'voiceActor',t.voiceActor);
            applyArtistCredit(o,'CHARA',id,'designer');
            if(!live2dHit && o.live2dId===undefined) put(o,'description',t.description);
        }

        if(o.doppelId!==undefined && o.description!==undefined && o.id===undefined &&
           (pk.indexOf('doppel')>=0 || o.doppelMagiaId!==undefined)){
            id=Math.floor(Number(o.doppelId)/100)*10+8;
            m=cn.doppelCardMagiaMap[id];
            if(m){applyRuntimeSkill(o,m);doppelSkillHit=true;}
        }

        id=o.doppelId!==undefined?o.doppelId:
           ((o.id!==undefined && (pk.indexOf('doppel')>=0 ||
             (o.title!==undefined && o.description!==undefined)))?o.id:null);
        if(!doppelSkillHit && id!==null && id!==undefined && cn.doppelList[id]){
            t=cn.doppelList[id];
            put(o,'name',t.name);
            put(o,'title',t.title);
